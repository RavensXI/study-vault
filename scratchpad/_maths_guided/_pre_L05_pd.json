        "calculator": true,
        "input_type": "single_value",
        "misconceptions": [
          {
            "check": "common",
            "expect": 45,
            "message": "Frequency = 4.5 × 10 = 45. Percentage = 45/120 × 100 = 37.5%.",
            "pattern": "wrong_formula",
            "expect_note": "Student correctly finds frequency (45) but stops there, forgetting to express it as a percentage of the total (45/120 × 100)."
          }
        ]
      },

            "label": "Reverse",
            "content": "<p>\\(16 = 2x^3\\), so \\(x^3 = 8\\)</p>"
          },
          {
            "label": "Root",
            "content": "<p>\\(x = \\sqrt[3]{8}\\)</p>"
          },
          {
            "label": "Answer",
            "content": "<p>\\(x = 2\\)</p>",
            "isAnswer": true,
            "is_answer": true
          }
        ]
      }
    }

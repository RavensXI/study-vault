  "method_card": {
    "steps": [
      "Single: multiply the outside term by each inside term",
      "Double: FOIL (multiply each pair), then collect like terms",
      "Square: rewrite as two identical brackets, then FOIL"
    ],
    "title": "How to Expand Brackets",
    "content": "<p><strong>Single bracket:</strong> Multiply the term outside by every term inside.</p><p><strong>Double brackets:</strong> Use FOIL (First, Outside, Inside, Last), then collect like terms.</p><p><strong>Squaring a bracket:</strong> Write it as two brackets and expand: \\((x+3)^2 = (x+3)(x+3)\\).</p>",
    "example": "<p><strong>Expand</strong> \\((x + 3)(x - 5)\\)</p><p>\\(x^2 - 5x + 3x - 15 = x^2 - 2x - 15\\)</p>"
  },
  "tier_guides": {
    "gold": {
      "steps": [
        "A square means two identical brackets: \\((x+3)^2 = (x+3)(x+3)\\).",
        "For three brackets, expand two first, then multiply the result by the third.",
        "Track every coefficient and sign before collecting like terms."
      ],
      "title": "Gold: Squares and Triple Products",
      "example": {
        "steps": [
          {
            "label": "Write as two brackets",
            "content": "\\((x+4)(x+4)\\)"
          },
          {
            "label": "FOIL and collect",
            "content": "\\(x^2 + 4x + 4x + 16 = x^2 + 8x + 16\\)"
          },
          {
            "label": "Answer",
            "content": "\\(x^2 + 8x + 16\\)",
            "isAnswer": true,
            "is_answer": true
          }
        ],
        "question": "Expand \\((x + 4)^2\\)"
      }
    },
    "bronze": {
      "steps": [
        "Multiply the term OUTSIDE by <strong>every</strong> term inside the bracket.",
        "Keep the signs: a minus outside flips the sign of each inside term.",
        "Do not collect anything yet, just write the two separate products."
      ],
      "title": "Bronze: Single Brackets",
      "example": {
        "steps": [
          {
            "label": "Multiply each term",
            "content": "\\(5 \\times x = 5x\\), \\(5 \\times 2 = 10\\)"
          },
          {
            "label": "Check signs",
            "content": "Both terms are positive, so both products are positive."
          },
          {
            "label": "Answer",
            "content": "\\(5x + 10\\)",
            "isAnswer": true,
            "is_answer": true
          }
        ],
        "question": "Expand \\(5(x + 2)\\)"
      }
    },
    "silver": {
      "steps": [
        "Use <strong>FOIL</strong>: multiply First, Outer, Inner, Last.",
        "That gives four terms; the two middle ones are both multiples of x.",
        "Collect the middle terms to finish, for example \\(5x + 2x = 7x\\)."
      ],
      "title": "Silver: Double Brackets",
      "example": {
        "steps": [
          {
            "label": "FOIL",
            "content": "\\(x^2 + 5x + 2x + 10\\)"
          },
          {
            "label": "Collect the middle",
            "content": "\\(5x + 2x = 7x\\)"
          },
          {
            "label": "Answer",
            "content": "\\(x^2 + 7x + 10\\)",
            "isAnswer": true,
            "is_answer": true
          }
        ],
        "question": "Expand \\((x + 2)(x + 5)\\)"
      }
    }
  },

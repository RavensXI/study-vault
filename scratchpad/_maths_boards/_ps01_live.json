{
 "method_card": {
  "steps": [
   "P(event) = favourable / total",
   "AND: multiply along the branches",
   "OR: add the separate end probabilities",
   "Without replacement: reduce the total by 1 each time",
   "All probabilities on branches from one node must sum to 1"
  ],
  "title": "Probability Basics & Tree Diagrams",
  "content": "<p><strong>Probability</strong> = favourable outcomes ÷ total outcomes, always between 0 and 1. <strong>AND</strong> = multiply along branches. <strong>OR</strong> = add probabilities of separate outcomes.</p><p><strong>Tree diagrams:</strong> Each branch shows the probability. With <strong>replacement</strong>: same probabilities. <strong>Without replacement</strong>: adjust the denominator.</p>",
  "example": "<p><strong>Bag: 3 red, 7 blue. P(red)?</strong></p><p>P(red) = 3/10.</p>"
 },

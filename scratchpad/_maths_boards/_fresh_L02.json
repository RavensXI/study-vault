 "method_card": {
  "steps": [
   "Increase by r%: multiply by (1 + r/100)",
   "Decrease by r%: multiply by (1 − r/100)",
   "Reverse: divide by the multiplier",
   "Compound: multiply by the multiplier n times (or use power)",
   "Percentage change = (new − old) / old × 100"
  ],
  "title": "Percentages & Compound Change",
  "content": "<p><strong>Percentage change:</strong> Multiply by a <strong>multiplier</strong>. Increase by 15% → ×1.15. Decrease by 20% → ×0.80.</p><p><strong>Reverse percentages:</strong> If the result AFTER a change is known, divide by the multiplier to find the original.</p><p><strong>Compound change:</strong> \\(\\text{Final} = \\text{Original} \\times (\\text{multiplier})^n\\) where \\(n\\) is the number of years/periods.</p>",
  "example": "<p><strong>£500 earns 3% compound interest for 2 years.</strong></p><p>\\(500 \\times 1.03^2 = 500 \\times 1.0609 = £530.45\\)</p>"
 },

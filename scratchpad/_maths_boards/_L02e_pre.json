 "method_card": {
  "steps": [
   "For +/−: find the lowest common denominator (LCD)",
   "Convert each fraction so both have the LCD",
   "Add or subtract the numerators (denominator stays the same)",
   "For ×: multiply tops together, multiply bottoms together",
   "For ÷: Keep the first, Flip the second, Change to ×"

 "tier": "higher",
 "method_card": {
  "steps": [
   "For CF: add running totals, plot at upper boundaries, draw smooth curve",
   "Read median at n/2, Q1 at n/4, Q3 at 3n/4",
   "For box plots: draw using min, Q1, median, Q3, max",
   "For histograms: frequency density = frequency ÷ class width"
  ],
  "title": "Cumulative Frequency, Box Plots & Histograms",
  "content": "<p><strong>Cumulative frequency (CF):</strong> Running total of frequencies. Plot against the <strong>upper class boundary</strong> and join with a smooth curve.</p><p>From a CF graph, read off: <strong>median</strong> (at \\(n/2\\)), <strong>Q1</strong> (at \\(n/4\\)), <strong>Q3</strong> (at \\(3n/4\\)). <strong>IQR</strong> = Q3 − Q1.</p><p>A <strong>box plot</strong> shows: minimum, Q1, median, Q3, maximum. The box spans the IQR.</p><p><strong>Histograms</strong> use <strong>frequency density</strong> = frequency ÷ class width on the y-axis. Area of each bar = frequency.</p>",
  "example": "<p><strong>40 students. From CF graph, median is at \\(40/2 = 20\\)th value. Read across at CF = 20 to find the median.</strong></p>"
 },
 "worked_examples": [
  {
   "steps": [

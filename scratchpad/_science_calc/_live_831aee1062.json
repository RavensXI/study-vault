    "question": "<svg viewBox=\"0 0 600 225\" style=\"max-width:520px; margin:0.8em auto; display:block;\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <marker id=\"doc\" markerWidth=\"10\" markerHeight=\"7\" refX=\"0\" refY=\"3.5\" orient=\"auto\">\n      <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"#475569\"/>\n    </marker>\n  </defs>\n  <!-- Deep ocean tank -->\n  <rect x=\"100\" y=\"20\" width=\"400\" height=\"170\" fill=\"#1e90ff\" fill-opacity=\"0.2\" stroke=\"#475569\" stroke-width=\"2\" rx=\"6\"/>\n  <rect x=\"103\" y=\"26\" width=\"394\" height=\"160\" fill=\"#1e90ff\" fill-opacity=\"0.25\" rx=\"2\"/>\n  <!-- Surface -->\n  <line x1=\"100\" y1=\"26\" x2=\"500\" y2=\"26\" stroke=\"#1e90ff\" stroke-width=\"2.5\" stroke-dasharray=\"5,3\"/>\n  <text x=\"506\" y=\"30\" font-size=\"11\" fill=\"#1e90ff\" font-family=\"'Source Serif 4',serif\">surface</text>\n  <!-- Depth arrow -->\n  <line x1=\"464\" y1=\"26\" x2=\"464\" y2=\"160\" stroke=\"#475569\" stroke-width=\"1.8\" stroke-dasharray=\"4,3\" marker-end=\"url(#doc)\"/>\n  <text x=\"472\" y=\"97\" font-size=\"13\" font-style=\"italic\" fill=\"#475569\" font-family=\"'Source Serif 4',serif\">h = 120 m</text>\n  <!-- Sensor/object at depth -->\n  <rect x=\"272\" y=\"150\" width=\"56\" height=\"24\" fill=\"#1e3a8a\" stroke=\"#1e293b\" stroke-width=\"1.5\" rx=\"4\" opacity=\"0.9\"/>\n  <text x=\"300\" y=\"166\" text-anchor=\"middle\" font-size=\"11\" fill=\"white\" font-family=\"'Source Serif 4',serif\">sensor</text>\n  <!-- Labels -->\n  <text x=\"300\" y=\"206\" text-anchor=\"middle\" font-size=\"12\" fill=\"#475569\" font-family=\"'Source Serif 4',serif\">ρ = 1025 kg/m³ &nbsp; p = hρg</text>\n</svg><p style=\"margin-top:0.8em;\">A submarine is 120 m below the surface of seawater (density 1025 kg/m³, g = 10 N/kg). The upper hull has a surface area of 500 m². Calculate the force exerted by the water on the upper hull.</p>",

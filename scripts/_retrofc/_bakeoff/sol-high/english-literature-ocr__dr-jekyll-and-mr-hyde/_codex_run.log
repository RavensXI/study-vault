+      "lesson": 3,
+      "field": "content_html",
+      "severity": "HIGH",
+      "claim": "Mr Guest ... declares it a forgery",
+      "truth": "Guest observes that the two hands are largely identical but differently sloped. Utterson privately concludes that Jekyll forged the letter.",
+      "evidence": "Primary text ch. 5, lines 1975–2043.",
+      "verdict": "FIX"
+    },
+    {
+      "id": "F10",
+      "lesson": 3,

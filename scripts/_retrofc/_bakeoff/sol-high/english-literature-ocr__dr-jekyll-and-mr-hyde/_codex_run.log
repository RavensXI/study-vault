+      "id": "F10",
+      "lesson": 3,
+      "field": "content_html",
+      "severity": "HIGH",
+      "claim": "‘a death warrant written legibly upon his face… he had his death-warrant written there’",
+      "truth": "The exact line is ‘He had his death-warrant written legibly upon his face.’",
+      "evidence": "Primary text ch. 6, line 2125.",
+      "verdict": "FIX"
+    },
+    {
+      "id": "F11",
+      "lesson": 3,
+      "field": "content_html",
+      "severity": "HIGH",
+      "claim": "Lanyon is ‘hide-bound’, sticking to ‘the practical side of medicine’.",
+      "truth": "Jekyll calls Lanyon a ‘hide-bound pedant’; ‘the practical side of medicine’ is not in the text.",
+      "evidence": "Primary text ch. 3, lines 1227–1233; no occurrence of ‘practical side’ in the primary text.",
+      "verdict": "FIX"
+    },

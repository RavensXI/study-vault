+      "field": "practice_questions",
+      "severity": "HIGH",
+      "claim": "‘The letter is a forgery,’ said the lawyer, ‘the man has forged it.’ / 40 marks — Shakespeare Essay",
+      "truth": "That quotation is invented. Guest comments on the resemblance between the hands. The labels must distinguish the 19th-century novel format from untimed discursive practice.",
+      "evidence": "Primary text ch. 5, lines 2009–2043; specification sections 2a and 3a.",
+      "verdict": "FIX"
+    },

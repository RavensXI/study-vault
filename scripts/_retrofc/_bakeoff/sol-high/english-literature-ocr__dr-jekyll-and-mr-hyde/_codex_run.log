--- FLASHCARD_QUESTIONS ---
[
 {
  "a": "In Jekyll's 'cabinet' above the laboratory.",
  "q": "Where does Utterson visit Jekyll after the Carew murder?"
 },
 {
  "a": "Mr Guest — Utterson's clerk.",
  "q": "Who in Chapter 5 spots that Hyde's letter is forged?"
 },
 {
  "a": "It matches Jekyll's own in every feature except the slope.",
  "q": "What does Guest notice about the forged letter's handwriting?"
 },
 {
  "a": "It lets the reader register suspicion without yet understanding the truth.",
  "q": "Why is the forged letter Stevenson's cleverest hint?"
 },
 {
  "a": "'A death warrant written legibly upon his face.'",
  "q": "How does Utterson describe Lanyon's appearance after his shock?"
 },
 {
  "a": "A letter marked 'not to be opened till the death or disappearance of Dr Henry Jekyll.'",
  "q": "What does Lanyon leave behind, sealed, when he dies?"
 },
 {
  "a": "A foil — he is the cautious 'hide-bound' scientist who refuses transgression.",
  "q": "What is Lanyon's structural role in relation to Jekyll?"
 },
 {
  "a": "Darwin's biology and emerging psychology (William James, early Freud).",
  "q": "Which 1880s scientific developments fuelled the novella's anxieties?"
 },
 {
  "a": "The figure most trusted by Victorian society becomes the figure most dangerous.",
  "q": "Why does the lesson argue Stevenson chose a doctor as his protagonist?"
 },
 {
  "a": "'Such abject terror and despair, as froze the very blood of the two gentlemen below.'",
  "q": "What expression takes over Jekyll's face at the window?"
 },
 {
  "a": "It compresses the whole tragedy into a single moment of horror and silence.",
  "q": "Why does the lesson say the window scene is structurally central?"
 },
 {
  "a": "Poole — 'white and shaky' with terror.",
  "q": "Which servant arrives at Utterson's in Chapter 8?"
 },
 {
  "a": "'That thing was not my master.'",
  "q": "Quote Poole's conviction that the cabinet voice is not Jekyll."
 },
 {
  "a": "'For God's sake have mercy!'",
  "q": "Quote the cry Utterson hears from inside the cabinet."
 },
 {
  "a": "Wrong voice, a 'dwarfish' and 'hairy' hand, a creature 'crying out like a rat.'",
  "q": "What three pieces of evidence convince Poole the figure isn't Jekyll?"
 },
 {
  "a": "Hyde's body on the floor with a phial, plus a rewritten will and a sealed packet.",
  "q": "What do Utterson and Poole find when they break down the cabinet door?"
 }
]

--- GLOSSARY_TERMS ---
[
 {
  "term": "foreshadowing",
  "definition": "Clues given to the reader to suggest or hint at later events."
 },
 {
  "term": "foil",
  "definition": "A character used to highlight qualities in another by contrast."
 },
 {
  "term": "transgressive",
  "definition": "Choosing to cross accepted moral or natural limits in search of knowledge."
 },
 {
  "term": "silence",
  "definition": "Leaving something significant unsaid so the reader feels the weight of it."
 },
 {
  "term": "architectural metaphor",
  "definition": "Mapping the layout of a building onto the structure of the self."
 }
]



+      "lesson": 4,
+      "field": "content_html",
+      "severity": "HIGH",
+      "claim": "a drug that ‘could cast off the lower elements’ of his personality",
+      "truth": "This is not a quotation. Jekyll says the drug dethroned existing powers and substituted a form bearing the stamp of lower elements in his soul.",
+      "evidence": "Primary text ch. 10, lines 4101–4137.",
+      "verdict": "FIX"
+    },

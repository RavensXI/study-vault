const fs = require('fs');
const path = require('path');
const base = 'scripts/_retrofc/_bakeoff/sol-high/english-literature-ocr__dr-jekyll-and-mr-hyde';
const edits = JSON.parse(fs.readFileSync(path.join(base, '_edits.json'), 'utf8'));
JSON.parse(fs.readFileSync(path.join(base, '_report.json'), 'utf8'));
const cache = new Map();
function fieldsFor(lesson) {
  if (cache.has(lesson)) return cache.get(lesson);
  const s = fs.readFileSync(path.join(base, 'raw', "'`L${String(lesson).padStart(2,'"'0')}.txt"'`), '"'utf8');
  const re = /"'^--- ([A-Z_]+) ---'"\\r?\\n/gm;
  const matches = [...s.matchAll(re)];
  const out = {};
  for (let i=0;i<matches.length;i++) {
    const key = matches[i][1].toLowerCase();
    const start = matches[i].index + matches[i][0].length;
    const end = i+1<matches.length ? matches[i+1].index : s.length;
    out[key] = s.slice(start,end).replace(/\\r?\\n\\r?\\n"'$/, '"'');
  }
  for (const k of ['practice_questions','knowledge_checks','flashcard_questions','glossary_terms']) out[k]=JSON.parse(out[k]);
  cache.set(lesson,out); return out;
}
function get(obj,p) {
  const toks=[...p.matchAll(/\\[(\\d+)\\]|\\.([A-Za-z_][A-Za-z0-9_]*)/g)].map(m=>m[1]"'!==undefined?Number(m[1]):m[2]);
  let v=obj; for(const t of toks) v=v[t]; return v;
}
let bad=[];
for (let i=0;i<edits.length;i++) {
  const e=edits[i], f=fieldsFor(e.lesson)[e.field];
  if ('"'find' in e) {
    const count = f.split(e.find).length-1;
    if (count"'!==1) bad.push(`${i}: L${e.lesson} ${e.field} find count=${count} :: ${e.find.slice(0,90)}`);
  } else {
    const actual=get(f,e.path);
    if (JSON.stringify(actual)!==JSON.stringify(e.expect)) bad.push(`${i}: L${e.lesson} ${e.field}${e.path} expect=${JSON.stringify(e.expect)} actual=${JSON.stringify(actual)}`);
    if (JSON.stringify(e.expect)===JSON.stringify(e.value)) bad.push(`${i}: L${e.lesson} ${e.field}${e.path} no-op edit`);
  }
}
console.log(`edits=${edits.length} findings=${JSON.parse(fs.readFileSync(path.join(base,'"'_report.json'),'utf8')).findings.length} bad="'${bad.length}`);
console.log(bad.join('"'\\n'));

import json
import re
from pathlib import Path

root = Path(r'scripts/_retrofc/units/drama-aqa__live-theatre-review')
edits = json.load(open(root / '_edits.json', encoding='utf-8'))
for edit in edits:
    lesson = root / 'raw' / f\"L{edit['lesson']:02d}.txt\"
    raw = open(lesson, encoding='utf-8').read()
    label = edit['field'].upper()
    match = re.search(rf'"'^--- {re.escape(label)} ---'"\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\Z)', raw, re.S | re.M)
    if not match:
        raise SystemExit(f\"Missing field {edit['field']} in {lesson.name}\")
    field = match.group(1)
    if 'find' in edit:
        count = field.count(edit['find'])
        if count "'!= 1:
            raise SystemExit(f"find count {count}: L{edit['"'lesson']} {edit['field']} {edit['note']}\")
    else:
        value = json.loads(field)
        path = re.fullmatch(r'\\[(\\d+)\\]\\.(\\w+)', edit['path'])
        actual = value[int(path.group(1))][path.group(2)]
        if actual "'!= edit['"'expect']:
            raise SystemExit(f\"expect mismatch: L{edit['lesson']} {edit['field']} {edit['path']}: {actual"'!r}")
    if edit['"'field'].endswith('_html') and any(ch in edit['replace'] for ch in '‘’“”—…'):
        raise SystemExit(f\"Unicode punctuation in HTML replacement: {edit['note']}\")
print(f'validated {len(edits)} edits: every find is unique and every expect matches')

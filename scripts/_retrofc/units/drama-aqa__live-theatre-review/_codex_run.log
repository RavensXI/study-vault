  "definition": "The manner in which a performer walks across the stage, used to communicate character status, mood or physical condition."
 },
 {
  "term": "subtext",
  "definition": "The unstated meaning beneath a character's words, communicated by the performer through vocal and physical choices rather than the script itself."
 }
]



import json
import re

base = Path(r\"scripts/_retrofc/units/film-studies-eduqas__film-form-and-language\")
edits = json.loads((base / \"_edits.json\").read_text(encoding=\"utf-8\"))
report = json.loads((base / \"_report.json\").read_text(encoding=\"utf-8\"))
assert set(report) == {\"unit\", \"checked_at\", \"spec_used\", \"findings\", \"lessons_clean\", \"summary\"}
errors = []
for edit in edits:
    raw = (base / \"raw\" / f\"L{edit['lesson']:02}.txt\").read_text(encoding=\"utf-8\")
    marker = f\"--- {edit['field'].upper()} ---\"
    start = raw.find(marker)
    if start < 0:
        errors.append(f\"missing field: {edit}\")
        continue
    start = raw.find(\"\\n\", start) + 1
    end_match = re.search(r\"\\r?\\n--- [A-Z_]+ ---\", raw[start:])
    field = raw[start:start + end_match.start()] if end_match else raw[start:]
    if \"find\" in edit:
        count = field.count(edit[\"find\"])
        if count "'!= 1:
            errors.append(f"lesson {edit['"'lesson']} {edit['field']} find count {count}: {edit['find']"'!r}")
    else:
        data = json.loads(field.strip())
        match = re.fullmatch(r"'"\\[(\\d+)\\]\\.(term|definition)\", edit[\"path\"])
        if not match:
            errors.append(f\"unsupported path {edit['path']}\")
            continue
        index, key = int(match.group(1)), match.group(2)
        actual = data[index][key]
        if actual "'!= edit["expect"]:
            errors.append(f"lesson {edit['"'lesson']} {edit['field']} {edit['path']} expect mismatch: {actual"'!r}")
if errors:
    raise SystemExit("'"\\n\".join(errors))
print(f\"JSON valid; {len(edits)} edits verified: every find is unique and every expect matches.\")

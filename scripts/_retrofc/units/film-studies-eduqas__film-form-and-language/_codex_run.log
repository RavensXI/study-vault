[
 {
  "term": "genre",
  "definition": "A category of film defined by shared conventions, iconography, narrative patterns and audience expectations, such as horror, western or romantic comedy."
 },
 {
  "term": "iconography",
  "definition": "The distinctive visual symbols, objects, settings and character types associated with a particular genre that audiences learn to recognise."
 },
 {
  "term": "genre cycle",
  "definition": "A period of intensified production in a particular genre, typically driven by the commercial success of an early defining film."
 },
 {
  "term": "hybrid genre",
  "definition": "A film that blends the conventions of two or more established genres, creating a new category such as romantic comedy or sci-fi western."
 },
 {
  "term": "representation",
  "definition": "The way films construct images of social groups, identities or ideas through the combination of casting, costume, dialogue, performance, framing and sound."
 },
 {
  "term": "stereotype",
  "definition": "A simplified, widely recognised image of a social group that emphasises assumed shared characteristics and ignores individual variation."
 },
 {
  "term": "counter-type",
  "definition": "A character or representation that deliberately challenges, subverts or replaces a stereotype, offering a more complex or unexpected image of a social group."
 },
 {
  "term": "gaze theory",
  "definition": "The idea, developed by Laura Mulvey, that conventional cinema positions the spectator to look at the world as if through the eyes of a heterosexual male, objectifying female characters."
 }
]



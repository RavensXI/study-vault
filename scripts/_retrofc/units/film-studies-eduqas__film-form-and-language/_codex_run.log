[
 {
  "term": "plot",
  "definition": "The sequence of events as they are presented to the audience in the film, regardless of when they actually occurred in the story world."
 },
 {
  "term": "story",
  "definition": "All the events in a narrative taken in their real chronological order, including events referred to but not shown on screen."
 },
 {
  "term": "three-act structure",
  "definition": "A screenwriting framework that divides a narrative into three sections: set-up (Act 1), confrontation (Act 2), and resolution (Act 3)."
 },
 {
  "term": "inciting incident",
  "definition": "The event early in a narrative that disrupts the protagonist's everyday world and sets the main conflict in motion."
 },
 {
  "term": "climax",
  "definition": "The point of highest tension or emotional intensity in a narrative, typically near the end of Act 2 or beginning of Act 3."
 },
 {
  "term": "cause and effect",
  "definition": "The principle that each event in a narrative is motivated by a preceding event and produces a subsequent one, creating forward momentum."
 },
 {
  "term": "ellipsis",
  "definition": "A narrative technique in which time is compressed by omitting events, jumping forward without showing the intervening period."
 },
 {
  "term": "equilibrium",
  "definition": "In Todorov's narrative model, the state of balance or normality at the beginning of a story."
 },
 {
  "term": "character functions",
  "definition": "The roles characters play in a narrative according to Propp's model: hero, villain, donor, helper, dispatcher, princess and false hero."
 },
 {
  "term": "narration",
  "definition": "The way a film organises and presents story information to the spectator, deciding what to reveal, withhold and delay."
 }
]



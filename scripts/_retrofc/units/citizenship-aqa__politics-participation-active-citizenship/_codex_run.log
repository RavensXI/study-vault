 {
  "term": "constituencies",
  "definition": "Geographic areas whose residents are each represented by a single MP in the House of Commons."
 },
 {
  "term": "proportionality",
  "definition": "The fairness with which votes translate into parliamentary seats; a system is proportional when parties win seats in rough proportion to their share of the vote."
 },
 {
  "term": "Additional Member System",
  "definition": "A voting system used for Scottish Parliament, Welsh Senedd and London Assembly elections, combining constituency seats with regional list seats to produce a more proportional result."
 },
 {
  "term": "Single Transferable Vote",
  "definition": "A voting system used for Northern Ireland Assembly elections in which voters rank candidates in order of preference and seats are allocated in multiple rounds until all seats are filled."
 },
 {
  "term": "plurality",
  "definition": "Winning more votes than any other candidate without necessarily gaining more than half the total votes cast, which is sufficient to win a seat under the First Past the Post system."
 }
]



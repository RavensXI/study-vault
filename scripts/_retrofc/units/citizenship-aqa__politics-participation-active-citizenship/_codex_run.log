import json
import re
from pathlib import Path

unit = Path(r'scripts/_retrofc/units/citizenship-aqa__politics-participation-active-citizenship')
edits = json.loads((unit / '_edits.json').read_text(encoding='utf-8'))
field_headers = {
    'description': 'DESCRIPTION',
    'content_html': 'CONTENT_HTML',
    'conclusion_html': 'CONCLUSION_HTML',
    'exam_tip_html': 'EXAM_TIP_HTML',
    'practice_questions': 'PRACTICE_QUESTIONS',
    'knowledge_checks': 'KNOWLEDGE_CHECKS',
    'flashcard_questions': 'FLASHCARD_QUESTIONS',
    'glossary_terms': 'GLOSSARY_TERMS',
}

def fields_for(lesson):
    text = (unit / 'raw' / f'L{lesson:02}.txt').read_text(encoding='utf-8')
    matches = list(re.finditer(r'"'^--- ([A-Z_]+) ---'"\\r?"'$'"', text, re.M))
    out = {}
    for i, match in enumerate(matches):
        name = match.group(1)
        start = match.end()
        if text[start:start+2] == '\\r\\n':
            start += 2
        elif text[start:start+1] == '\\n':
            start += 1
        end = matches[i+1].start() if i + 1 < len(matches) else len(text)
        value = text[start:end].rstrip('\\r\\n')
        for field, header in field_headers.items():
            if name == header:
                out[field] = value
    return out

def get_path(obj, path):
    current = obj
    for key, index in re.findall(r'\\.([A-Za-z_][A-Za-z0-9_]*)|\\[([0-9]+)\\]', path):
        current = current[key] if key else current[int(index)]
    return current

cache = {}
problems = []
for edit in edits:
    lesson = edit['lesson']
    cache.setdefault(lesson, fields_for(lesson))
    field_value = cache[lesson][edit['field']]
    if 'find' in edit:
        count = field_value.count(edit['find'])
        if count "'!= 1:
            problems.append(f"L{lesson} {edit['"'field']} find count={count}: {edit['find']"'!r}")
    else:
        current = get_path(json.loads(field_value), edit['"'path'])
        if current "'!= edit['"'expect']:
            problems.append(f\"L{lesson} {edit['field']} {edit['path']} expect mismatch: current={current"'!r} expect={edit['"'expect']"'!r}")

print(f'"'Checked {len(edits)} edits across {len(cache)} lessons.')
if problems:
    print('\\n'.join(problems))
    raise SystemExit(1)
print('All find strings occur exactly once and all JSON expectations equal the current values.')

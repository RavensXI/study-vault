"'$utf8 = [System.Text.UTF8Encoding]::new($false)
$edits = [System.IO.File]::ReadAllText((Resolve-Path -LiteralPath "$unit/_edits.json"), $utf8) | ConvertFrom-Json
$headers = @{
  description = '"'DESCRIPTION'; content_html = 'CONTENT_HTML'; conclusion_html = 'CONCLUSION_HTML'; exam_tip_html = 'EXAM_TIP_HTML';
  practice_questions = 'PRACTICE_QUESTIONS'; knowledge_checks = 'KNOWLEDGE_CHECKS'; flashcard_questions = 'FLASHCARD_QUESTIONS'; glossary_terms = 'GLOSSARY_TERMS'
}
function Get-LessonFields([int]"'$lesson) {
  $raw = [System.IO.File]::ReadAllText((Resolve-Path -LiteralPath "$unit/raw/L$('"'{0:d2}' -f "'$lesson).txt"), $utf8)
  $matches = [regex]::Matches($raw, '"'(?m)"'^--- ([A-Z_]+) ---'"\\r?"'$'"')
  "'$result = @{}
  for ($i = 0; $i -lt $matches.Count; $i++) {
    $start = $matches[$i].Index + $matches[$i].Length
    if ($raw.Substring($start).StartsWith("`r`n")) { $start += 2 } elseif ($raw.Substring($start).StartsWith("`n")) { $start++ }
    $end = if ($i + 1 -lt $matches.Count) { $matches[$i + 1].Index } else { $raw.Length }
    $name = $matches[$i].Groups[1].Value
    foreach ($field in $headers.Keys) {
      if ($headers[$field] -eq $name) { $result[$field] = $raw.Substring($start, $end - $start).TrimEnd("`r", "`n") }
    }
  }
  return $result
}
function Get-JsonPath($node, [string]$path) {
  $current = $node
  $parts = [regex]::Matches($path, '"'\\.([A-Za-z_][A-Za-z0-9_]*)|\\[([0-9]+)\\]')
  foreach ("'$part in $parts) {
    if ($part.Groups[1].Success) { $current = $current.($part.Groups[1].Value) } else { $current = $current[[int]$part.Groups[2].Value] }
  }
  return $current
}
$cache = @{}
$problems = [System.Collections.Generic.List[string]]::new()
foreach ($edit in $edits) {
  $lesson = [int]$edit.lesson
  if (-not $cache.ContainsKey($lesson)) { $cache[$lesson] = Get-LessonFields $lesson }
  $fieldValue = $cache[$lesson][$edit.field]
  if ($null -ne $edit.PSObject.Properties['"'find']) {
    "'$count = ([regex]::Matches($fieldValue, [regex]::Escape([string]$edit.find))).Count
    if ($count -ne 1) { $problems.Add("L$lesson $($edit.field) find count=$count") }
  } else {
    $current = Get-JsonPath ($fieldValue | ConvertFrom-Json) $edit.path
    if ([string]$current -cne [string]$edit.expect) { $problems.Add("L$lesson $($edit.field) $($edit.path) expect mismatch") }
  }
}
Write-Output "Checked $($edits.Count) edits across $($cache.Count) lessons."
if ($problems.Count) { $problems; exit 1 }

--- GLOSSARY_TERMS ---
[
 {
  "term": "citizenship action",
  "definition": "A planned course of informed action to address a citizenship issue or question of concern, aimed at delivering a benefit or change for a particular community or wider society."
 },
 {
  "term": "primary sources",
  "definition": "Information collected first-hand by the researcher, such as surveys, interviews or observations."
 },
 {
  "term": "secondary sources",
  "definition": "Information gathered from existing sources such as reports, articles, statistics or books produced by others."
 },
 {
  "term": "evaluation",
  "definition": "A careful judgement of the value, effectiveness and outcomes of a citizenship action, considering what was achieved, what was not, and what could have been done differently."
 },
 {
  "term": "stakeholder",
  "definition": "Any person, group or organisation that has an interest in or is affected by a citizenship issue or action, such as local residents, councillors or campaign groups."
 },
 {
  "term": "aims and objectives",
  "definition": "The goals a citizenship action is designed to achieve: the aim is the broad overall purpose, while objectives are the specific, measurable steps taken to reach it."
 }
]



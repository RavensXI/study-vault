    $current = $items[[int]$Matches[1]].($Matches[2])
    if ($current -cne $edit.expect) { $errors.Add("expect mismatch: L$($edit.lesson) $field $($edit.path)") }
  }
  if (-not $field.EndsWith('"'_html')) {

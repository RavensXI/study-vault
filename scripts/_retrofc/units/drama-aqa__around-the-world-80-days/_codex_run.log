  "'$m = [regex]::Match($raw, $pattern)
  if (-not $m.Success) { $errors.Add("missing field L$($edit.lesson) $field"); continue }
  $fieldValue = $m.Groups[1].Value.TrimEnd("`r", "`n")
  if ($null -ne $edit.PSObject.Properties['"'find']) {
    "'$count = [regex]::Matches($fieldValue, [regex]::Escape([string]$edit.find)).Count

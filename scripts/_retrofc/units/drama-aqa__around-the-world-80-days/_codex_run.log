"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "Select-String -LiteralPath 'scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L01.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L02.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L03.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L04.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L05.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L06.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L07.txt','scripts/_retrofc/units/drama-aqa__around-the-world-80-days/raw/L08.txt' -Pattern 'For [0-9]+-mark|[0-9]+-mark .*question|examiners reward|examiner can|marks for|score.*marks|highest band|higher bands|Developing band|Mastering band' -CaseSensitive:"'$false -Encoding utf8 | ForEach-Object { '"'{0}:{1}: {2}' -f [IO.Path]::GetFileName("'$_.Path),$_.LineNumber,$_.Line.Trim() }' in C:\Users\tshau\Documents\Study Vault

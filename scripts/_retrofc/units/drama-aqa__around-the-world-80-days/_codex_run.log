--- GLOSSARY_TERMS ---
[
 {
  "term": "Frantic Assembly",
  "definition": "A physical theatre company founded in 1994 by Scott Graham and Steven Hoggett, known for high-energy ensemble work, lifts, contact choreography and collaboratively devised movement."
 },
 {
  "term": "Complicite",
  "definition": "A theatre company founded by Simon McBurney in 1983, known for object transformation, storytelling ensemble work, narrator-led staging and precise physical imagery."
 },
 {
  "term": "music-hall and circus tradition",
  "definition": "A comic performance tradition, particularly popular in Victorian-era variety entertainment, that emphasises direct audience address, comic precision, timing, song and shared theatrical pleasure."
 },
 {
  "term": "round-by-through",
  "definition": "A choreographic method developed by Frantic Assembly in which pairs of performers create movement by taking turns to respond to each other's physical initiation, building shared physical language."
 },
 {
  "term": "chair duets and contact choreography",
  "definition": "Contact work in which performers manipulate, support or move each other's bodies, creating images that could not be achieved alone and communicating vulnerability, trust or power."
 },
 {
  "term": "object transformation",
  "definition": "The theatrical technique of using a prop or simple object to represent multiple things during a performance, the transformation happening through the performer's physical use of the object rather than through its appearance."
 },
 {
  "term": "Verfremdungseffekt",
  "definition": "Brecht's term for a suite of theatrical techniques designed to prevent the audience from losing themselves in the drama, encouraging critical thinking instead of passive emotional identification."
 },
 {
  "term": "weight and rhythm",
  "definition": "The quality of movement, particularly its relationship to the ground, often described in terms of how light or heavy a performer's steps and gestures feel."
 },
 {
  "term": "performer-audience relationship",
  "definition": "The relationship between performers and audience, including whether the audience is positioned as passive observers or active participants in the theatrical event."
 },
 {
  "term": "dim state",
  "definition": "A lighting state in which the intensity is reduced to a very low level, creating shadow and mystery."
 }
]



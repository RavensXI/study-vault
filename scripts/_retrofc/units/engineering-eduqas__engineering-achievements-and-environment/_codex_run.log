--- GLOSSARY_TERMS ---
[
 {
  "term": "embodied energy",
  "definition": "The total energy consumed throughout the life of a material, from extraction and processing through to disposal or recycling."
 },
 {
  "term": "ferrous metals",
  "definition": "Metals containing iron as their principal component, such as mild steel and stainless steel."
 },
 {
  "term": "non-ferrous metals",
  "definition": "Metals that do not contain iron, such as aluminium, brass and copper."
 },
 {
  "term": "thermoplastics",
  "definition": "Plastics that soften when heated and can be re-shaped and recycled, such as acrylic, nylon and HIPS."
 },
 {
  "term": "thermosetting plastics",
  "definition": "Plastics that are permanently set during curing and cannot be re-melted or recycled, such as urea formaldehyde."
 },
 {
  "term": "circular economy",
  "definition": "An economic model in which materials are kept in use for as long as possible through repair, reuse, remanufacture and recycling, minimising waste and the need for virgin raw materials."
 }
]



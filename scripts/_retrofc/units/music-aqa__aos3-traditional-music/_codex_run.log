--- GLOSSARY_TERMS ---
[
 {
  "term": "pizzicato",
  "definition": "Plucking the strings with the fingers instead of bowing."
 },
 {
  "term": "inverted pedal",
  "definition": "A sustained or repeated note held above the changing harmony — a pedal at the top of the texture rather than the bass."
 },
 {
  "term": "fretless bass",
  "definition": "A bass guitar without frets, allowing smooth slides (portamento) between notes."
 },
 {
  "term": "blue notes",
  "definition": "Expressively lowered notes — typically the flattened third, fifth or seventh — borrowed from the blues."
 },
 {
  "term": "polyrhythm",
  "definition": "Two or more conflicting rhythmic patterns sounding together."
 },
 {
  "term": "scat",
  "definition": "Wordless jazz singing using invented syllables — the voice improvising like an instrument."
 },
 {
  "term": "mixolydian",
  "definition": "The mode built on the fifth degree of the major scale — a major scale with a flattened seventh."
 }
]



--- GLOSSARY_TERMS ---
[
 {
  "term": "Sonata form",
  "definition": "A structure in three main stages (exposition, development, recapitulation), often followed by a coda, used to organise a movement around two contrasting musical ideas."
 },
 {
  "term": "Exposition",
  "definition": "The opening section of a sonata-form movement, where the first subject and second subject are introduced."
 },
 {
  "term": "First subject",
  "definition": "The first main theme presented in the exposition of a sonata-form movement."
 },
 {
  "term": "Second subject",
  "definition": "A contrasting theme introduced later in the exposition, usually in a different key from the first subject."
 },
 {
  "term": "Development",
  "definition": "The middle section of sonata form, where ideas from the exposition are fragmented, altered and moved through different keys."
 },
 {
  "term": "Recapitulation",
  "definition": "The section of sonata form that restates the exposition's themes, now usually staying in the home key."
 },
 {
  "term": "Coda",
  "definition": "A concluding passage added after the recapitulation to round off a movement."
 },
 {
  "term": "Dominant seventh",
  "definition": "A four-note chord built on the fifth degree of a scale, which normally pulls strongly towards the tonic."
 },
 {
  "term": "Tonic",
  "definition": "The home key or first note of a scale, the point of harmonic rest a piece is centred on."
 },
 {
  "term": "Sforzando",
  "definition": "A sudden strong accent placed on a single note or chord."
 },
 {
  "term": "Alla breve",
  "definition": "A time signature (also written 2/2) with two minim beats in a bar, giving a fast, strong pulse."
 },
 {
  "term": "Adagio molto",
  "definition": "An Italian tempo marking meaning very slow."
 }
]



import json
import re
from pathlib import Path

root = Path(r'scripts/_retrofc/units/music-aqa__aos1-western-classical')
edits = json.loads((root / '_edits.json').read_text(encoding='utf-8'))
report = json.loads((root / '_report.json').read_text(encoding='utf-8'))

def extract(raw, field):
    pattern = rf'"'^--- {re.escape(field.upper())} ---'"\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---\\r?\\n|\\Z)'
    match = re.search(pattern, raw, re.S | re.M)
    if not match:
        raise AssertionError(f'missing field {field}')
    return match.group(1).rstrip('\\r\\n')

def json_value(value, path):
    match = re.fullmatch(r'\\[(\\d+)\\]\\.([A-Za-z_]+)', path)
    if not match:
        raise AssertionError(f'unsupported path {path}')
    return value[int(match.group(1))][match.group(2)]

for edit in edits:
    raw = (root / 'raw' / f\"L{edit['lesson']:02d}.txt\").read_text(encoding='utf-8')
    value = extract(raw, edit['field'])
    if 'find' in edit:
        count = value.count(edit['find'])
        assert count == 1, (edit['lesson'], edit['field'], count, edit['find'])
    else:
        actual = json_value(json.loads(value), edit['path'])
        assert actual == edit['expect'], (edit['lesson'], edit['field'], edit['path'], actual, edit['expect'])

fix_ids = {finding['id'] for finding in report['findings'] if finding['verdict'] == 'FIX'}
edit_ids = {re.match(r'(F\\d+):', edit['note']).group(1) for edit in edits}
assert edit_ids == fix_ids, (edit_ids, fix_ids)
print(f'validated {len(edits)} edits: every find is unique and every expect matches')
print(f\"report findings: {len(report['findings'])}; FIX={len(fix_ids)}, ADJUDICATE={sum(f['verdict']=='ADJUDICATE' for f in report['findings'])}, NOTE={sum(f['verdict']=='NOTE' for f in report['findings'])}\")

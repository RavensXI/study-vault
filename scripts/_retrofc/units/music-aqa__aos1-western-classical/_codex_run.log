--- GLOSSARY_TERMS ---
[
 {
  "term": "binary form",
  "definition": "A two-section structure, usually heard as AABB, with a change of key between the sections."
 },
 {
  "term": "ternary form",
  "definition": "A three-part structure, ABA, where a contrasting middle section is followed by a return of the opening idea."
 },
 {
  "term": "rondo form",
  "definition": "A structure in which a main theme keeps returning between contrasting episodes, such as ABACA."
 },
 {
  "term": "theme and variations",
  "definition": "A structure in which a theme is stated in full, then repeated several times with changes to elements such as ornamentation, dynamics, instrumentation, harmony or rhythm."
 },
 {
  "term": "sonata form",
  "definition": "A three-stage structure of exposition, development and recapitulation, built around two contrasting musical subjects."
 },
 {
  "term": "exposition",
  "definition": "The opening section of sonata form, where the first and second subjects are presented."
 },
 {
  "term": "development",
  "definition": "The middle section of sonata form, where themes are fragmented, reworked and passed through unstable keys."
 },
 {
  "term": "recapitulation",
  "definition": "The final section of sonata form, where both subjects return in the tonic key."
 },
 {
  "term": "first subject",
  "definition": "The opening theme of a sonata-form exposition, stated in the tonic key."
 },
 {
  "term": "second subject",
  "definition": "The contrasting theme of a sonata-form exposition, usually stated in the dominant key of a major-key movement."
 },
 {
  "term": "modulation",
  "definition": "A change from one key to another within a piece of music."
 },
 {
  "term": "tonic",
  "definition": "The home key of a piece or section of music."
 }
]



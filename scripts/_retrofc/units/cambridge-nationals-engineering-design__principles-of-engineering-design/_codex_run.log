  "a": "Quantitative comparison involves measuring the manufactured product's dimensions and performance using instruments such as vernier callipers or a multimeter, and comparing each measured value against the numerical tolerances in.",
  "q": "What is quantitative comparison when evaluating a design outcome?"
 },
 {
  "a": "User testing reveals ergonomic issues, ease-of-use problems, aesthetic preferences and safety concerns that arise from real people interacting with the product — information that cannot be found by measuring.",
  "q": "What does user testing reveal that quantitative measurement cannot?"
 },
 {
  "a": "Identifying modifications is the expected output of a correctly conducted evaluation because it drives the next iteration of the iterative design process, progressively improving the design until all specification.",
  "q": "Why is identifying modifications and improvements the expected outcome of an evaluation, not a sign of failure?"
 }
]

--- GLOSSARY_TERMS ---
[
 {
  "term": "model",
  "definition": "A representation of a design idea built to test specific properties — such as proportions, scale, function or appearance — before committing to full-scale manufacture."
 },
 {
  "term": "3D CAD modelling software",
  "definition": "Software used to build a digital 3D representation of a design, from which properties such as mass, stress distribution and assembly clearance can be analysed without producing any physical object."
 },
 {
  "term": "block model",
  "definition": "A physical model carved or machined from a solid block of material — typically foam, balsa wood, clay or MDF — to represent the product's external form and test its ergonomics."
 },
 {
  "term": "quantitative comparison",
  "definition": "Comparison of the manufactured product against the numerical criteria in the design specification, using measurements to determine objectively whether each requirement has been met."
 }
]


"'$utf8 = [System.Text.UTF8Encoding]::new($false, $true)
$header = [regex]::new('"'(?m)"'^--- [A-Z_]+ ---$'"')
function Read-Utf8Strict([string]"'$Path) { return $utf8.GetString([System.IO.File]::ReadAllBytes($Path)) }
function Get-Field([int]$Lesson, [string]$Field) {
  $rawPath = Join-Path $root ("raw/L{0:D2}.txt" -f $Lesson)
  $raw = Read-Utf8Strict $rawPath
  $marker = "--- {0} ---" -f $Field.ToUpperInvariant()
  $start = $raw.IndexOf($marker, [System.StringComparison]::Ordinal)
  if ($start -lt 0) { throw "Missing field $Field in L$Lesson" }
  $start += $marker.Length
  $next = $header.Match($raw, $start)
  $end = if ($next.Success) { $next.Index } else { $raw.Length }
  return $raw.Substring($start, $end - $start).Trim()
}
function Count-Ordinal([string]$Text, [string]$Needle) {
  $count = 0; $at = 0
  while ($true) {
    $found = $Text.IndexOf($Needle, $at, [System.StringComparison]::Ordinal)
    if ($found -lt 0) { return $count }
    $count++; $at = $found + $Needle.Length
  }
}
$reportPath = Join-Path $root '"'_report.json'
"'$editsPath = Join-Path $root '"'_edits.json'
"'$report = (Read-Utf8Strict $reportPath) | ConvertFrom-Json
$edits = (Read-Utf8Strict $editsPath) | ConvertFrom-Json
$requiredReport = '"'unit', 'checked_at', 'spec_used', 'findings', 'lessons_clean', 'summary'
foreach ("'$name in $requiredReport) { if ($null -eq $report.PSObject.Properties[$name]) { throw "Report missing $name" } }
$errors = [System.Collections.Generic.List[string]]::new()
foreach ($edit in $edits) {
  $fieldText = Get-Field $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    $count = Count-Ordinal $fieldText $edit.find
    if ($count -ne 1) { $errors.Add("L$($edit.lesson) $($edit.field): find count $count") }
  }
  if ($null -ne $edit.expect) {
    $items = $fieldText | ConvertFrom-Json
    if ($edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') { "'$errors.Add("Invalid path $($edit.path)"); continue }
    $index = [int]$Matches[1]
    $property = $Matches[2]
    $actual = $items[$index].PSObject.Properties[$property].Value
    if ($actual -cne $edit.expect) { $errors.Add("L$($edit.lesson) $($edit.field)$($edit.path): expect mismatch") }
  }
}
if ($errors.Count -gt 0) { $errors; exit 1 }

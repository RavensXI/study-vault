+[
+  {
+    "lesson": 1,
+    "field": "content_html",
+    "find": "All electrical installation work in the UK must comply with BS 7671 (the IET Wiring Regulations), and qualified electricians are responsible for testing and certifying that the work is safe before a building is occupied.",
+    "replace": "Electrical work must be carried out by competent people. BS 7671 (the IET Wiring Regulations) is a widely used standard for electrical installations.",
+    "severity": "HIGH",
+    "note": "F1: BS 7671 is non-statutory."
+  },
+  {
+    "lesson": 1,
+    "field": "practice_questions",
+    "path": "[3].marks",
+    "expect": "Description of work (up to 3 marks): installs, inspects and tests electrical services and equipment; runs cables and fits consumer units (fuse boards); wires sockets, switches and lighting circuits; may install specialist equipment such as security systems or fire alarms (one mark per distinct point, up to 3).\nSafety regulation (1 mark): for example, must comply with BS 7671 (the IET Wiring Regulations) and certify that completed work is safe before the building is occupied. [4 marks total]",
+    "value": "Description of work (up to 3 marks): installs, inspects and tests electrical services and equipment; runs cables and fits consumer units (fuse boards); wires sockets, switches and lighting circuits; may install specialist equipment such as security systems or fire alarms (one mark per distinct point, up to 3).\nSafety requirement (1 mark): for example, works competently and follows relevant safety requirements; BS 7671 is a widely used standard for electrical installations. [4 marks total]",
+    "severity": "HIGH",
+    "note": "F2: Correct the electrical-safety answer key."
+  },
+  {
+    "lesson": 1,
+    "field": "flashcard_questions",
+    "path": "[4].q",
+    "expect": "What must an electrician comply with when installing electrical services in a new building?",
+    "value": "What widely used standard guides electrical installation work in a new building?",
+    "severity": "HIGH",
+    "note": "F3: Do not present BS 7671 as an unconditional legal requirement."

+      "evidence": "spec 1.8.3; HSE, Managing risks and risk assessment at work",
+      "verdict": "FIX"
+    },
+    {
+      "id": "F7",
+      "lesson": 3,
+      "field": "content_html",
+      "severity": "HIGH",
+      "claim": "it is illegal for an unregistered person to carry out any work on gas appliances or pipework",
+      "truth": "A person carrying out gas work as part of a business must be competent and Gas Safe registered. The law allows consumers to carry out limited user tasks that do not disturb gas-carrying components or combustion.",

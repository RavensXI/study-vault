function Get-Field([string]$text, [string]$field) {
  $label = $field.ToUpperInvariant()
  $m = [regex]::Match($text, "(?ms)''^--- $label ---'"\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)\")
  if (-not "'$m.Success) { throw "Missing field: $field" }
  return $m.Groups[1].Value.TrimEnd([char]13, [char]10)
}
function Get-PathValue($object, [string]$path) {
  $m = [regex]::Match($path, '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"')
  if (-not "'$m.Success) { throw "Unsupported path: $path" }
  return $object[[int]$m.Groups[1].Value].($m.Groups[2].Value)
}
$problems = [System.Collections.Generic.List[string]]::new()
for ($lesson = 1; $lesson -le 3; $lesson++) {
  $rawPath = Join-Path $base ("raw/L{0:D2}.txt" -f $lesson)
  $rawText = [System.IO.File]::ReadAllText((Resolve-Path -LiteralPath $rawPath), [System.Text.UTF8Encoding]::new($false))
  foreach ($edit in @($edits | Where-Object { $_.lesson -eq $lesson })) {
    $fieldValue = Get-Field $rawText $edit.field
    if ($null -ne $edit.find) {
      $count = [regex]::Matches($fieldValue, [regex]::Escape([string]$edit.find)).Count
      if ($count -ne 1) { $problems.Add("$($edit.note): find count $count") }
    } else {
      $jsonValue = $fieldValue | ConvertFrom-Json
      $actual = Get-PathValue $jsonValue $edit.path
      if ([string]$actual -cne [string]$edit.expect) { $problems.Add("$($edit.note): expect mismatch at $($edit.path)") }
    }
  }
}
if ($problems.Count) { $problems; exit 1 }

--- GLOSSARY_TERMS ---
[
 {
  "term": "personal protective equipment (PPE)",
  "definition": "Equipment worn by individuals to protect against specific hazards that cannot be adequately controlled by other means, including hard hats, high-visibility vests, safety boots, gloves and dust masks."
 },
 {
  "term": "competent person",
  "definition": "A person with the appropriate qualifications, training, experience and accreditations to safely carry out a specific type of work, such as a Gas Safe registered engineer or a NICEIC-approved electrician."
 },
 {
  "term": "MEWP (Mobile Elevating Work Platform)",
  "definition": "A vehicle-mounted or self-propelled platform that lifts workers to height, such as a cherry picker or scissor lift."
 },
 {
  "term": "enclosed space",
  "definition": "A space that is enclosed or partially enclosed, not designed for continuous human occupancy, and which has a foreseeable risk of serious injury due to hazardous substances, lack of oxygen or other dangerous conditions."
 }
]



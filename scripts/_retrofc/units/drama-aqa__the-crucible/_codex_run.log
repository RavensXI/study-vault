 {
  "term": "subtext",
  "definition": "Meaning implied through what characters do not say or do, rather than stated openly."
 },
 {
  "term": "rising action",
  "definition": "The section of dramatic structure in which tension, complications and stakes increase steadily before the climax."
 },
 {
  "term": "lighting wash",
  "definition": "An even spread of light covering the whole stage, often used to establish time of day or mood."
 },
 {
  "term": "blocking",
  "definition": "The planned arrangement and movement of performers in a stage space, designed by the director."

  const from = start + marker.length;
  const next = raw.indexOf('"'\\n--- ', from);
  return raw.slice(from, next < 0 ? raw.length : next);
}
function atPath(value, p) {
  let current = value;
  for (const token of p.matchAll(/\\[([0-9]+)\\]|\\.([A-Za-z_]+)/g)) current = token[1] === undefined ? current[token[2]] : current[Number(token[1])];
  return current;
}
for (const edit of edits) {

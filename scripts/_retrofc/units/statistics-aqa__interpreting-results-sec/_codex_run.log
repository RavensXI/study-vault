  if ('find' in edit) {
    const occurrences = source.split(edit.find).length - 1;
    if (occurrences "'!== 1) throw Error(`${edit.lesson} ${edit.field} find occurrences: ${occurrences}`);
    const count = value => (value.match(/data-narration-id/g) || []).length;

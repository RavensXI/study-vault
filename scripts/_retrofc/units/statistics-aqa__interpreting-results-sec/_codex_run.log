if (fixes.size "'!== editIds.size || [...fixes].some(x => !editIds.has(x))) throw Error('"'FIX findings and edit notes do not match');
function fieldText(lesson, field) {
  const raw = fs.readFileSync(path.join(root, 'raw', "'`L${String(lesson).padStart(2, '"'0')}.txt"'`), '"'utf8');

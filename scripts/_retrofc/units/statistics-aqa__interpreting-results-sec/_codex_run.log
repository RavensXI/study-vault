"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
import re
from pathlib import Path

root = Path(r\"scripts/_retrofc/units/statistics-aqa__interpreting-results-sec\")
with open(root / \"_edits.json\", encoding=\"utf-8\") as f:
    edits = json.load(f)
with open(root / \"_report.json\", encoding=\"utf-8\") as f:
    report = json.load(f)

assert {x[\"id\"] for x in report[\"findings\"] if x[\"verdict\"] == \"FIX\"} == {e[\"note\"].split(\":\", 1)[0] for e in edits}

def field_text(lesson, field):
    with open(root / \"raw\" / f\"L{lesson:02d}.txt\", encoding=\"utf-8\") as f:
        raw = f.read()
    match = re.search(rf\"--- {re.escape(field.upper())} ---\\n(.*?)(?=\\n--- [A-Z_]+ ---|\\Z)\", raw, re.S)
    if not match:
        raise AssertionError(f\"missing {lesson=} {field=}\")
    return match.group(1)

def at_path(value, path):
    current = value
    for index, key in re.findall(r\"\\[([0-9]+)\\]|\\.([A-Za-z_]+)\", path):
        current = current[int(index)] if index else current[key]
    return current

for edit in edits:
    source = field_text(edit[\"lesson\"], edit[\"field\"])
    if \"find\" in edit:
        assert source.count(edit[\"find\"]) == 1, (edit[\"lesson\"], edit[\"field\"], source.count(edit[\"find\"]))
        assert edit[\"find\"].count(\"data-narration-id\") == edit[\"replace\"].count(\"data-narration-id\"), edit
    else:
        assert at_path(json.loads(source), edit[\"path\"]) == edit[\"expect\"], edit

print(f\"validated {len(edits)} edits, {len(report['findings'])} findings; all finds are unique and all expects match\")

--- GLOSSARY_TERMS ---
[
 {
  "term": "distribution",
  "definition": "The pattern of how values in a dataset are spread, showing which values occur frequently and which occur rarely."
 },
 {
  "term": "symmetrical distribution",
  "definition": "A distribution where the left and right sides are roughly mirror images of each other, with the mean, median and mode all at the centre."
 },
 {
  "term": "positively skewed distribution",
  "definition": "A distribution with a longer tail on the right-hand side, where most values are clustered at the lower end and a few high values pull the mean above the median."
 },
 {
  "term": "negatively skewed distribution",
  "definition": "A distribution with a longer tail on the left-hand side, where most values are clustered at the higher end and a few low values pull the mean below the median."
 },
 {
  "term": "outlier",
  "definition": "A data value that lies far away from the main cluster of values in a dataset."
 },
 {
  "term": "binomial distribution",
  "definition": "A probability distribution that arises when counting the number of successes in a fixed number of independent trials, each with the same probability of success."
 },
 {
  "term": "Normal distribution",
  "definition": "A symmetric, bell-shaped probability distribution where most values cluster near the mean and become increasingly rare further from the mean."
 },
 {
  "term": "warning lines",
  "definition": "Lines on a quality control chart set at two standard deviations from the target mean; a value outside these lines suggests the process may need monitoring."
 },
 {
  "term": "action lines",
  "definition": "Lines on a quality control chart set at three standard deviations from the target mean; a value outside these lines indicates the process should be stopped and investigated."
 }
]



[
 {
  "term": "bias",
  "definition": "The tendency of a source to present information from a particular viewpoint shaped by the author's background, purpose, or cultural assumptions."
 },
 {
  "term": "Cornelia",
  "definition": "Daughter of Scipio Africanus and mother of the Gracchi brothers, celebrated in Roman tradition as the ideal of educated, virtuous Roman motherhood."
 },
 {
  "term": "Lucretia",
  "definition": "A noblewoman of early Rome whose rape and subsequent suicide, as recorded by Livy, triggered the expulsion of the Tarquin kings and the founding of the Roman Republic."
 },
 {
  "term": "hetairai",
  "definition": "Women in ancient Athens who maintained long-term relationships with men outside marriage, often educated companions who attended symposia, occupying an ambiguous social position."
 },
 {
  "term": "Hegeso Stele",
  "definition": "A marble grave relief from Athens (c. 410 BC), now in the National Archaeological Museum, Athens, depicting a seated woman choosing jewellery from a box held by a slave girl."
 },
 {
  "term": "Ampharete Stele",
  "definition": "A marble grave relief from Athens, now in the Kerameikos Museum, showing a woman holding a baby, notable for its first-person inscription expressing a grandmother's grief."
 }
]


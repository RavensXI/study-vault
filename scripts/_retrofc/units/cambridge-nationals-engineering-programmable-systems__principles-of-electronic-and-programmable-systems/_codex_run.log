--- GLOSSARY_TERMS ---
[
 {
  "term": "circuit assembly",
  "definition": "The process of attaching and soldering electronic components onto a PCB to create a complete, functional circuit."
 },
 {
  "term": "surface mount technology (SMT)",
  "definition": "A method of circuit assembly in which very small components are placed directly onto pads on the PCB surface and soldered without leads passing through the board."
 },
 {
  "term": "pick and place machine",
  "definition": "An automated robotic machine that picks individual SMT components from reels or trays and places them accurately onto solder paste-coated PCB pads at high speed."
 },
 {
  "term": "through-hole construction",
  "definition": "A circuit assembly method in which component leads are passed through holes drilled in the PCB and soldered to copper pads on the opposite side."
 }
]



"'$edits = Get-Content -Raw -Encoding utf8 "$u/_edits.json" | ConvertFrom-Json
$report = Get-Content -Raw -Encoding utf8 "$u/_report.json" | ConvertFrom-Json
$failures = @()
function Get-FieldValue([int]$lesson, [string]$field) {
  $path = Join-Path $u ("raw/L{0:d2}.txt" -f $lesson)
  $source = [System.IO.File]::ReadAllText($path, [System.Text.Encoding]::UTF8)
  $pattern = '"'--- ' + [regex]::Escape("'$field.ToUpperInvariant()) + '"' ---\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)'
  "'$match = [regex]::Match($source, $pattern, [System.Text.RegularExpressions.RegexOptions]::Singleline)
  if (-not $match.Success) { throw "Missing $field in L$lesson" }
  return $match.Groups[1].Value.TrimEnd("`r", "`n")
}
function Get-PathValue($value, [string]$path) {
  foreach ($match in [regex]::Matches($path, '"'\\[(\\d+)\\]|\\.([A-Za-z_]+)')) {
    if ("'$match.Groups[1].Success) { $value = $value[[int]$match.Groups[1].Value] }
    else { $value = $value.($match.Groups[2].Value) }
  }
  return $value
}
foreach ($edit in $edits) {
  $raw = Get-FieldValue $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    $count = [regex]::Matches($raw, [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { $failures += [pscustomobject]@{lesson=$edit.lesson;field=$edit.field;kind='"'find';detail="'$count} }
  } else {
    try { $actual = Get-PathValue ($raw | ConvertFrom-Json) $edit.path } catch { $actual = "ERROR: $($_.Exception.Message)" }
    if ($actual -cne $edit.expect) { $failures += [pscustomobject]@{lesson=$edit.lesson;field=$edit.field;kind=$edit.path;detail='"'expect mismatch'} }
  }
}
[pscustomobject]@{report_findings=@("'$report.findings).Count;edits=@($edits).Count;failures=$failures} | ConvertTo-Json -Depth 4

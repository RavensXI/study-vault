"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$code = @'"'
import json, re
from pathlib import Path
root = Path(r\"scripts/_retrofc/units/engineering-eduqas__engineering-materials-and-properties\")
edits = json.loads((root / \"_edits.json\").read_text(encoding=\"utf-8\"))
errors = []
raw_cache = {}
for edit in edits:
    lesson = edit[\"lesson\"]
    if lesson not in raw_cache:
        raw_cache[lesson] = (root / \"raw\" / f\"L{lesson:02}.txt\").read_text(encoding=\"utf-8\")
    raw = raw_cache[lesson]
    field = edit[\"field\"]
    marker = f\"--- {field.upper()} ---\\\\n\"
    start = raw.find(marker)
    if start < 0:
        errors.append(f\"L{lesson} {field}: field not found\")
        continue
    start += len(marker)
    match = re.search(r\"\\\\n--- [A-Z_]+ ---\", raw[start:])
    value = raw[start:start + match.start()] if match else raw[start:]
    value = value.rstrip(\"\\\\r\\\\n\")
    if \"find\" in edit:
        count = value.count(edit[\"find\"])
        if count "'!= 1:
            errors.append(f"L{lesson} {field}: find count {count}")
    else:
        data = json.loads(value)
        m = re.fullmatch(r"'"\\\\[(\\\\d+)\\\\]\\\\.([A-Za-z_]+)\", edit[\"path\"])
        actual = data[int(m.group(1))][m.group(2)] if m else None
        if actual "'!= edit["expect"]:
            errors.append(f"L{lesson} {field} {edit['"'path']}: expect mismatch: {actual"'!r}")
print(f"edits={len(edits)}")
print("PASS" if not errors else "FAIL")
for error in errors:
    print(error)
report = json.loads((root / "_report.json").read_text(encoding="utf-8"))
fix_ids = {f["id"] for f in report["findings"] if f["verdict"] == "FIX"}
edit_ids = {re.match(r"(F'"\\\\d+):\", e[\"note\"]).group(1) for e in edits}
print(f\"fix_ids={sorted(fix_ids)} edit_ids={sorted(edit_ids)}\")
print(\"ID-PASS\" if fix_ids == edit_ids else \"ID-FAIL\")

  }
  $raw = $cache[$lesson]
  $field = [string]$edit.field
  $pattern = '"'(?s)--- ' + [regex]::Escape("'$field.ToUpperInvariant()) + '"' ---\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)'
  "'$match = [regex]::Match($raw,$pattern)
  if(-not $match.Success){$errors += "L$lesson ${field}: field not found"; continue}
  $current = $match.Groups[1].Value.TrimEnd("`r","`n")
  if($null -ne $edit.find){
    $count = [regex]::Matches($current,[regex]::Escape([string]$edit.find)).Count
    if($count -ne 1){$errors += "L$lesson ${field}: find count $count"}
  } else {
    $data = $current | ConvertFrom-Json
    if([string]$edit.path -match '"'"'^'"\\[(\\d+)\\]\\.([A-Za-z_]+)"'$'"'){
      "'$actual = $data[[int]$Matches[1]].($Matches[2])
      if($actual -cne $edit.expect){$errors += "L$lesson $field $($edit.path): expect mismatch"}
    } else {$errors += "L$lesson ${field}: unsupported path"}
  }
}

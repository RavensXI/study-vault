$editIds = @($edits | ForEach-Object {([regex]::Match([string]$_.note,'"'"'^(F'"\\d+):')).Groups[1].Value} | Sort-Object -Unique)
\"fix_ids="'$($fixIds -join '"',') edit_ids="'$($editIds -join '"',')\"

import json, re
from pathlib import Path
base = Path(r'scripts/_retrofc/units/film-studies-eduqas__developments-in-film-technology')
report = json.load(open(base / '_report.json', encoding='utf-8'))
edits = json.load(open(base / '_edits.json', encoding='utf-8'))

def fields(lesson):
    s = open(base / 'raw' / f'L{lesson:02d}.txt', encoding='utf-8').read()
    out = {}
    for m in re.finditer(r'"'^--- ([A-Z_]+) ---'"\\r?\\n', s, re.M):
        end = re.search(r'"'^--- [A-Z_]+ ---'"\\r?\\n', s[m.end():], re.M)
        stop = m.end() + end.start() if end else len(s)
        out[m.group(1).lower()] = s[m.end():stop].rstrip('\\r\\n')
    return out

def getpath(value, path):
    for key, index in re.findall(r'(?:\\.([A-Za-z_]+))|\\[([0-9]+)\\]', path):
        if key:
            value = value[key]
        else:
            value = value[int(index)]
    return value

errors=[]
for i,e in enumerate(edits):
    raw=fields(e['lesson'])
    f=raw[e['field']]
    if 'find' in e:
        n=f.count(e['find'])
        if n "'!= 1:
            errors.append(f'"'edit {i}: find count {n}: {e[\"find\"]"'!r}'"')
    else:
        actual=getpath(json.loads(f),e['path'])
        if actual "'!= e['"'expect']:
            errors.append(f'edit {i}: expect mismatch: {actual"'!r} != {e["expect"]!r}'"')
fixids={x['id'] for x in report['findings'] if x['verdict']=='FIX'}
editids={re.match(r'(F\\d+):', e['note']).group(1) for e in edits}
print('report findings', len(report['findings']), 'edits', len(edits))
print('fix ids', sorted(fixids), 'edit ids', sorted(editids))
print('errors', len(errors))
for x in errors: print(x)
print('json ok')

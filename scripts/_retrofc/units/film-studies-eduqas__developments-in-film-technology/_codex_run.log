const report = JSON.parse(fs.readFileSync(path.join(base, '_report.json'), 'utf8'));
const edits = JSON.parse(fs.readFileSync(path.join(base, '_edits.json'), 'utf8'));
function fields(lesson) {
  const s = fs.readFileSync(path.join(base, 'raw', "'`L${String(lesson).padStart(2,'"'0')}.txt"'`), '"'utf8');
  const re = /"'^--- ([A-Z_]+) ---'"\\r?\\n/gm;
  const marks = []; let m;
  while ((m = re.exec(s))) marks.push({name:m[1].toLowerCase(), start:re.lastIndex, head:m.index});
  const result = {};
  marks.forEach((x, i) => result[x.name] = s.slice(x.start, i + 1 < marks.length ? marks[i+1].head : s.length).replace(/[\\r\\n]+"'$/, '"''));
  return result;
}
function getPath(v, p) {
  const bits = [...p.matchAll(/(?:\\.([A-Za-z_]+))|\\[([0-9]+)\\]/g)];
  for (const b of bits) v = b[1] "'!== undefined ? v[b[1]] : v[Number(b[2])];
  return v;
}
const problems = [];
for (const [i,e] of edits.entries()) {
  const value = fields(e.lesson)[e.field];
  if ('"'find' in e) {
    const count = value.split(e.find).length - 1;
    if (count "'!== 1) problems.push(`edit ${i}: find occurs ${count} times`);
  } else {
    const actual = getPath(JSON.parse(value), e.path);
    if (JSON.stringify(actual) !== JSON.stringify(e.expect)) problems.push(`edit ${i}: expect mismatch: ${JSON.stringify(actual)}`);
  }
}
const fixIds = new Set(report.findings.filter(x => x.verdict === '"'FIX').map(x => x.id));
const editIds = new Set(edits.map(x => /"'^F'"\\d+/.exec(x.note)[0]));
console.log(JSON.stringify({findings:report.findings.length, edits:edits.length, fixIds:[...fixIds], editIds:[...editIds], problems}, null, 2));
if (problems.length) process.exit(1);

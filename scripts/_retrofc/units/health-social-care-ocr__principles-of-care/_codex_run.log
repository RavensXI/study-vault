--- GLOSSARY_TERMS ---
[
 {
  "term": "safety procedure",
  "definition": "A set process that is followed in a care setting to reduce risk or danger, such as carrying out a risk assessment or conducting a fire drill."
 },
 {
  "term": "safety measure",
  "definition": "A particular action taken to reduce a specific risk in a care setting, such as putting up a wet floor sign or displaying a fire safety notice."
 },
 {
  "term": "risk assessment",
  "definition": "A formal process of identifying hazards in a care setting, evaluating the likelihood and severity of harm, and putting controls in place to reduce risk."
 },
 {
  "term": "first aid policy",
  "definition": "A written document setting out a care setting's arrangements for providing first aid, including trained first aiders, equipment location, and procedures to follow in an emergency."
 },
 {
  "term": "security measures",
  "definition": "Actions and systems that a care setting uses to control who can enter the premises, protect service users and staff from unauthorised access, and ensure the whereabouts of everyone on site are known."
 },
 {
  "term": "evacuation",
  "definition": "The emergency procedure for moving all service users, staff and visitors safely out of a building in response to a fire or other serious incident."
 },
 {
  "term": "keyholder list",
  "definition": "A record of all staff members who have access to keys for specific areas of the care setting, used to limit and monitor who can enter restricted spaces."
 }
]


--- GLOSSARY_TERMS ---
[
 {
  "term": "empowerment",
  "definition": "The process of enabling a service user to take control of their own life, make informed decisions and be self-reliant."
 },
 {
  "term": "high self-esteem",
  "definition": "A person's sense of their own worth and value, reflected in feeling valued and respected in a care setting."
 },
 {
  "term": "needs being met",
  "definition": "A benefit in which a service user receives care precisely tailored to their individual physical, emotional, social and practical requirements."

[
 {
  "term": "footfall",
  "definition": "The number of people passing a particular spot over a given period, which directly affects how many potential customers a retail business can attract."
 },
 {
  "term": "complementary shops",
  "definition": "Shops that sell related but different products, such as a clothing store near a shoe shop, that attract the same type of customer and benefit from each other's footfall."

    raw = (base / \"raw\" / f\"L{lesson:02}.txt\").read_text(encoding=\"utf-8\")
    match = re.search(r\"--- \" + re.escape(name.upper()) + r\" ---\\n(.*?)(?=\\n--- [A-Z_]+ ---|\\Z)\", raw, re.S)
    assert match, (lesson, name)
    return match.group(1).rstrip(\"\\n\")

def apply_path(value, path):
    for index, key in re.findall(r\"\\[(\\d+)\\]|\\.([A-Za-z_]+)\", path):
        value = value[int(index)] if index else value[key]
    return value


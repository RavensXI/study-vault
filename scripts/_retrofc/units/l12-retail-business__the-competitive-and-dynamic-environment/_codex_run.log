import json
import re
from pathlib import Path
base = Path(r\"scripts/_retrofc/units/l12-retail-business__the-competitive-and-dynamic-environment\")
report = json.loads((base / \"_report.json\").read_text(encoding=\"utf-8\"))
edits = json.loads((base / \"_edits.json\").read_text(encoding=\"utf-8\"))
assert set(report) == {\"unit\", \"checked_at\", \"spec_used\", \"findings\", \"lessons_clean\", \"summary\"}
assert isinstance(edits, list)
findings = {f[\"id\"]: f for f in report[\"findings\"]}
assert all(findings[e[\"note\"].split(\":\", 1)[0]][\"verdict\"] == \"FIX\" for e in edits)
assert {f[\"id\"] for f in report[\"findings\"] if f[\"verdict\"] == \"FIX\"} == {\"F3\", \"F4\"}

def field(lesson, name):
    raw = (base / \"raw\" / f\"L{lesson:02}.txt\").read_text(encoding=\"utf-8\")
    match = re.search(r\"--- \" + re.escape(name.upper()) + r\" ---\\n(.*?)(?=\\n--- [A-Z_]+ ---|\\Z)\", raw, re.S)
    assert match, (lesson, name)
    return match.group(1).rstrip(\"\\n\")

def apply_path(value, path):
    for index, key in re.findall(r\"\\[(\\d+)\\]|\\.([A-Za-z_]+)\", path):
        value = value[int(index)] if index else value[key]
    return value

for edit in edits:
    actual = field(edit[\"lesson\"], edit[\"field\"])
    if \"find\" in edit:
        count = actual.count(edit[\"find\"])
        print(f\"L{edit['lesson']} {edit['field']} find count: {count}\")
        assert count == 1
    else:
        current = apply_path(json.loads(actual), edit[\"path\"])
        print(f\"L{edit['lesson']} {edit['field']} {edit['path']} current: {current}\")
        assert current == edit[\"expect\"]

print(\"JSON schemas, FIX linkage, unique text matches, and JSON expectations: PASS\")

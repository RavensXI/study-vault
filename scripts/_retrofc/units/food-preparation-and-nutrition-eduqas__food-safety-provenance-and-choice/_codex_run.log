--- GLOSSARY_TERMS ---
[
 {
  "term": "recipe development",
  "definition": "The process of creating or adapting a recipe by making informed decisions about ingredients, processes, cooking methods and portion sizes to meet a specific brief."
 },
 {
  "term": "gluten",
  "definition": "A protein composite found in wheat, barley and rye that provides elasticity and structure in baked goods; must be avoided entirely by people with coeliac disease."
 },
 {
  "term": "free sugars",
  "definition": "Sugars added to food during processing or cooking, and those naturally present in honey, fruit juice and syrups, which raise blood glucose more rapidly than sugars in whole foods."
 },
 {
  "term": "lactose",
  "definition": "The natural sugar found in milk and dairy products; people with lactose intolerance lack sufficient lactase enzyme to digest it, causing digestive discomfort."
 },
 {
  "term": "lacto-ovo vegetarian",
  "definition": "A vegetarian who eats dairy products and eggs but excludes meat and fish from their diet."
 },
 {
  "term": "vegan",
  "definition": "A person who excludes all animal products from their diet, including meat, fish, dairy, eggs and honey."
 },
 {
  "term": "justified evaluation",
  "definition": "A written or verbal account explaining why each recipe change was made, how it meets the brief, and weighing any sensory or nutritional trade-offs against the benefit."
 },
 {
  "term": "glycaemic load",
  "definition": "A measure of how much a portion of food raises blood glucose, taking into account both the type of carbohydrate and the quantity consumed."
 }
]



  "definition": "Knowledge of where a food was grown, reared or caught, including its country of origin, farming method and the journey it made to reach the consumer."
 },
 {
  "term": "food miles",
  "definition": "The distance food travels from where it is grown or produced to where it is eaten, used as a measure of the environmental impact of a food product."
 },
 {
  "term": "carbon footprint",
  "definition": "The total amount of greenhouse gases produced directly and indirectly by an activity, product or organisation, expressed in tonnes of CO2 equivalent."
 },
 {
  "term": "sustainability",
  "definition": "The ability to produce food in a way that meets the needs of the present without compromising the ability of future generations to meet their own needs."
 },
 {
  "term": "food poverty",
  "definition": "The inability of individuals or households to afford or access a healthy, nutritious diet, often as a result of low income, unemployment or high food prices."
 },
 {
  "term": "food security",
  "definition": "As defined by the World Health Organisation: the condition in which all people at all times have physical and economic access to sufficient, safe and nutritious food to meet their dietary needs for an active and healthy life."
 },
 {
  "term": "food waste",
  "definition": "Food that is discarded or not eaten, causing environmental harm through methane emissions in landfill and wasting the land, water and energy used in its production."
 }
]



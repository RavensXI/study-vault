"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
import re
from pathlib import Path
root = Path(r'scripts/_retrofc/units/food-preparation-and-nutrition-eduqas__food-safety-provenance-and-choice')
edits = json.load(open(root / '_edits.json', encoding='utf-8'))
report = json.load(open(root / '_report.json', encoding='utf-8'))
errors = []
for edit in edits:
    raw = open(root / 'raw' / f\"L{edit['lesson']:02}.txt\", encoding='utf-8').read()
    field = edit['field'].upper()
    match = re.search(rf\"--- {re.escape(field)} ---\\r?\\n(.*?)(?=\\r?\\n--- |\\Z)\", raw, re.S)
    if not match:
        errors.append(f\"L{edit['lesson']} {edit['field']}: field not found\")
        continue
    count = match.group(1).count(edit['find'])

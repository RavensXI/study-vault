"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$unit = '"'scripts/_retrofc/units/drama-aqa__the-empress'
"'$report = Get-Content -Raw -Encoding utf8 "$unit/_report.json" | ConvertFrom-Json
$edits = Get-Content -Raw -Encoding utf8 "$unit/_edits.json" | ConvertFrom-Json
$errors = @()
$fixIds = @($report.findings | Where-Object { $_.verdict -eq '"'FIX' } | ForEach-Object { "'$_.id })
foreach ($edit in $edits) {
  if ($fixIds -notcontains (($edit.note -split '"':')[0])) { "'$errors += "edit has no FIX finding: lesson $($edit.lesson)" }
  $raw = Get-Content -Raw -Encoding utf8 (Join-Path $unit ('"'raw/L{0:d2}.txt' -f [int]"'$edit.lesson))
  $header = '"'--- ' + "'$edit.field.ToUpperInvariant() + '"' ---'
  "'$start = $raw.IndexOf($header, [StringComparison]::Ordinal)
  if ($start -lt 0) { $errors += "missing field $($edit.field) in L$($edit.lesson)"; continue }
  $start += $header.Length
  while ($start -lt $raw.Length -and ($raw[$start] -eq "`r" -or $raw[$start] -eq "`n")) { $start++ }
  $end = $raw.IndexOf("`n--- ", $start, [StringComparison]::Ordinal)
  if ($end -lt 0) { $end = $raw.Length }
  $fieldValue = $raw.Substring($start, $end - $start)
  $count = [regex]::Matches($fieldValue, [regex]::Escape([string]$edit.find)).Count
  if ($count -ne 1) { $errors += "L$($edit.lesson) $($edit.field): find count $count" }
}
$banned = '"'Level [1-9]|Component 1|AQA 8035|Edexcel 1GA0|OCR J384|Eduqas C111|Nothing worthy of credit|Award N marks for'
"'$hit = Select-String -Path "$unit/_report.json","$unit/_edits.json" -Encoding utf8 -Pattern $banned -CaseSensitive:$false
if ($hit) { $errors += '"'banned string found in output JSON' }
if (@("'$report.findings | Where-Object { $_.verdict -eq '"'FIX' }).Count -ne 6) { "'$errors += '"'unexpected FIX finding count' }
if (@("'$report.findings | Where-Object { $_.verdict -eq '"'ADJUDICATE' }).Count -ne 6) { "'$errors += '"'unexpected ADJUDICATE finding count' }
if ("'$edits.Count -ne 8) { $errors += '"'unexpected edit count' }
if ("'$errors.Count) { $errors; exit 1 }

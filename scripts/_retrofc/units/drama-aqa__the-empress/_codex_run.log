[
 {
  "a": "A German playwright and director (1898-1956) who developed epic theatre and the alienation effect.",
  "q": "Who was Bertolt Brecht?"
 },
 {
  "a": "Theatre that presents history as changeable, using distancing techniques to engage audiences intellectually rather than emotionally.",
  "q": "What is epic theatre?"
 },
 {
  "a": "A Brechtian technique creating critical distance, preventing emotional immersion so the audience thinks rather than just feels.",
  "q": "What is the alienation effect?"
 },
 {
  "a": "A physical attitude that simultaneously reveals a character's social position and the playwright's comment on it.",
  "q": "What is gestus?"
 },
 {

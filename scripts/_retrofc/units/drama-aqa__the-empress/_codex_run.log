--- GLOSSARY_TERMS ---
[
 {
  "term": "Bertolt Brecht",
  "definition": "German playwright and director (1898-1956) who developed epic theatre, arguing theatre should make audiences think critically rather than just feel."
 },
 {
  "term": "epic theatre",
  "definition": "A mode of theatre developed by Brecht that presents history as changeable and uses distancing techniques to engage the audience intellectually."
 },
 {
  "term": "alienation effect",
  "definition": "A Brechtian technique that creates critical distance between audience and performance, preventing emotional immersion."
 },
 {
  "term": "gestus",
  "definition": "A physical attitude that simultaneously reveals a character's social position and the playwright's political comment on that position."
 },
 {
  "term": "Stanislavski",
  "definition": "Russian director (1863-1938) who developed actor training based on emotional truth, inner motivation and belief in the fictional world."
 },
 {
  "term": "direct address",
  "definition": "When a performer speaks to the audience rather than to another character, temporarily stepping outside the fictional world."
 },
 {
  "term": "stylised",
  "definition": "A staging approach using openly theatrical conventions rather than realistic illusion, inviting the audience to acknowledge the performance as constructed."
 },
 {
  "term": "multi-roling",
  "definition": "One performer playing more than one character within the same production, often used to signal that all social roles are constructed."
 },
 {
  "term": "blocking",
  "definition": "The planned arrangement of performer movement through the stage space, designed to create meaning and guide audience focus."
 },
 {
  "term": "proxemics",
  "definition": "The spatial distance between performers on stage, communicating power, intimacy, tension or status."
 }
]



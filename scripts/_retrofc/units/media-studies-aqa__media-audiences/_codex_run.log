--- GLOSSARY_TERMS ---
[
 {
  "term": "media practices",
  "definition": "The habitual and purposeful ways in which people engage with media products as part of their everyday lives."
 },
 {
  "term": "actual self",
  "definition": "The identity a person currently has — who they are as they experience themselves now."
 },
 {
  "term": "desired self",
  "definition": "The identity a person aspires to have — who they would like to become."
 },
 {
  "term": "participatory culture",
  "definition": "Henry Jenkins' term for a culture in which audiences are not just consumers but active participants who create, share and contribute to media content."
 },
 {
  "term": "fandom",
  "definition": "An organised community of enthusiastic followers of a media product, genre, performer or media figure."
 },
 {
  "term": "parasocial relationships",
  "definition": "A one-sided relationship in which an audience member feels a sense of intimacy, familiarity and emotional connection with a media personality who does not know they exist."
 },
 {
  "term": "watercooler effect",
  "definition": "The social phenomenon where a shared media experience (such as a popular drama episode) generates conversation and debate among people who watched it."
 },
 {
  "term": "second-screen viewing",
  "definition": "The practice of simultaneously using a second device (typically a smartphone or tablet) to discuss or look up content while watching television."
 }
]


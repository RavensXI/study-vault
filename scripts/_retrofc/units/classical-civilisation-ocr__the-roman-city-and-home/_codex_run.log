"'$utf8 = [System.Text.UTF8Encoding]::new($false)
$edits = [System.IO.File]::ReadAllText((Resolve-Path -LiteralPath "$root/_edits.json"), $utf8) | ConvertFrom-Json
$report = [System.IO.File]::ReadAllText((Resolve-Path -LiteralPath "$root/_report.json"), $utf8) | ConvertFrom-Json
$labels = @{description='"'DESCRIPTION'; content_html='CONTENT_HTML'; conclusion_html='CONCLUSION_HTML'; exam_tip_html='EXAM_TIP_HTML'; practice_questions='PRACTICE_QUESTIONS'; knowledge_checks='KNOWLEDGE_CHECKS'; flashcard_questions='FLASHCARD_QUESTIONS'; glossary_terms='GLOSSARY_TERMS'}
function Get-Field([int]"'$lesson, [string]$field) {
  $rawPath = Resolve-Path -LiteralPath ("$root/raw/L{0:D2}.txt" -f $lesson)
  $raw = [System.IO.File]::ReadAllText($rawPath, $utf8)
  $marker = '"'--- ' + "'$labels[$field] + '"' ---'
  "'$start = $raw.IndexOf($marker, [System.StringComparison]::Ordinal)
  if ($start -lt 0) { throw "field marker missing: $field" }
  $start += $marker.Length
  if ($raw.Substring($start).StartsWith("`r`n")) { $start += 2 } elseif ($raw.Substring($start).StartsWith("`n")) { $start += 1 }
  $end = $raw.IndexOf("`n--- ", $start, [System.StringComparison]::Ordinal)
  if ($end -lt 0) { $end = $raw.Length }
  $value = $raw.Substring($start, $end - $start).TrimEnd("`r", "`n")
  if ($field.EndsWith('"'_html') -or "'$field -eq '"'description') { return "'$value }
  return ($value | ConvertFrom-Json)
}
function Count-Ordinal([string]$text, [string]$find) {
  $count = 0; $at = 0
  while ($true) { $hit = $text.IndexOf($find, $at, [System.StringComparison]::Ordinal); if ($hit -lt 0) { return $count }; $count++; $at = $hit + $find.Length }
}
$errors = @()
foreach ($edit in $edits) {
  $value = Get-Field $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    $count = Count-Ordinal ([string]$value) ([string]$edit.find)
    if ($count -ne 1) { $errors += "find count ${count}: L$($edit.lesson) $($edit.field)" }
  } else {
    if ($edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') { "'$errors += "unsupported path $($edit.path)"; continue }
    $got = $value[[int]$Matches[1]].PSObject.Properties[$Matches[2]].Value
    if (-not ($got -ceq $edit.expect)) { $errors += "expect mismatch: L$($edit.lesson) $($edit.field) $($edit.path)" }
  }
}
"parsed report findings=$($report.findings.Count) edits=$($edits.Count)"
if ($errors.Count -eq 0) { '"'validation=PASS' } else { 'validation=FAIL'; "'$errors }' in C:\Users\tshau\Documents\Study Vault

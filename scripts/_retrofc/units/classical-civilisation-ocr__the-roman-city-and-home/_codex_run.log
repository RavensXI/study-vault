labels = {
    'description': 'DESCRIPTION',
    'content_html': 'CONTENT_HTML',
    'conclusion_html': 'CONCLUSION_HTML',
    'exam_tip_html': 'EXAM_TIP_HTML',
    'practice_questions': 'PRACTICE_QUESTIONS',
    'knowledge_checks': 'KNOWLEDGE_CHECKS',
    'flashcard_questions': 'FLASHCARD_QUESTIONS',
    'glossary_terms': 'GLOSSARY_TERMS',
}
def field_value(lesson, field):
    text = (root / 'raw' / f'L{lesson:02d}.txt').read_text(encoding='utf-8')
    marker = f'--- {labels[field]} ---\\n'
    start = text.index(marker) + len(marker)
    end = text.find('\\n--- ', start)
    value = text[start:] if end == -1 else text[start:end]
    value = value.rstrip('\\r\\n')
    return value if field.endswith('_html') or field == 'description' else json.loads(value)
def at_path(value, path):
    cur = value
    for part in path.split('.')[1:]:
        if part.startswith('['):
            cur = cur[int(part[1:part.index(']')])]
            rest = part[part.index(']') + 1:]
            if rest:
                cur = cur[rest]
        else:
            cur = cur[part]
    return cur
errors = []
for e in edits:
    value = field_value(e['lesson'], e['field'])
    if 'find' in e:
        c = value.count(e['find'])
        if c "'!= 1:
            errors.append(f"find count {c}: L{e['"'lesson']} {e['field']} {e['find']"'!r}")
    else:
        got = at_path(value, e['"'path'])
        if got "'!= e['"'expect']:

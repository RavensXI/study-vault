  "term": "grid plan",
  "definition": "A regular street layout based on two main roads crossing at right angles, dividing the town into rectangular blocks."
 },
 {
  "term": "cardo",
  "definition": "The main north-south street of a Roman town, forming one of the two principal axes of the grid plan."
 },
 {
  "term": "decumanus",
  "definition": "The main east-west road of a Roman town, crossing the cardo at or near the forum."
 },
 {
  "term": "forum",
  "definition": "The open central square of a Roman city, serving as the focus of civic, commercial and religious life."
 },
 {
  "term": "aqueduct",
  "definition": "A Roman structure, often raised on arches, that carried a channel of fresh water from distant springs into a town."
 },
 {
  "term": "thermopolium",
  "definition": "A Roman street-level food and drink shop, identifiable by its stone counter set with large ceramic jars for serving hot food."
 }

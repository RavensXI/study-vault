 {
  "term": "invocation of the Muse",
  "definition": "A formal appeal to a divine being at the start of a poem, asking for inspiration and assistance in telling the story."
 },
 {
  "term": "in medias res",
  "definition": "Latin for 'in the middle of things'; a narrative technique where the story begins at a late point in the action, with earlier events revealed through flashback."
 },
 {
  "term": "epithet",
  "definition": "A repeated descriptive phrase attached to a character or object in epic poetry, which fills a certain metrical slot in the line and acts as a shorthand identity tag."
 },
 {
  "term": "Homeric simile",
  "definition": "An extended comparison in epic poetry that develops over several lines, comparing something in the main narrative to something from everyday life."
 },
 {
  "term": "oral-formulaic technique",
  "definition": "The craft of composing and delivering poetry in the oral tradition, using standard phrases, scenes and structural patterns to aid composition and memory."
 },
 {
  "term": "nostos",
  "definition": "The Greek concept of the longing or drive to return home, a central motivation for Odysseus throughout the poem."
 },
 {
  "term": "xenia",
  "definition": "The Greek code of hospitality, which required hosts to welcome strangers with food and shelter before asking their name or business, and guests to behave respectfully in return."
 }
]



--- GLOSSARY_TERMS ---
[
 {
  "term": "Change4Life (now NHS Better Health)",
  "definition": "A series of public health campaigns run by NHS England, initially launched as Change4Life in 2009, rebranded to Better Health in 2020, promoting healthy eating, physical activity and tobacco cessation."
 },
 {
  "term": "Dry January",
  "definition": "An annual public health campaign run each January by Alcohol Change UK, encouraging people to take a month off alcohol to improve their health and raise money for charity."
 },
 {
  "term": "Movember",
  "definition": "An annual campaign held each November by the Movember Foundation, raising awareness of men's health issues including prostate cancer, testicular cancer and mental health, through sponsored moustache-growing and fundraising."
 },
 {
  "term": "Time to Talk Day",
  "definition": "An annual mental health awareness day held on the first Thursday of February, run jointly by Mind and Rethink Mental Illness, encouraging open conversation about mental health to reduce stigma."
 },
 {
  "term": "Five Ways to Well-being",
  "definition": "A framework developed by the New Economics Foundation (NEF) and adopted by NHS and public health bodies, identifying five evidence-based actions shown to improve well-being: connect, be active, take notice, keep learning, and give."
 },
 {
  "term": "reliable",
  "definition": "The consistency of information or data — a reliable source produces consistent information that other credible sources agree with."
 },
 {
  "term": "valid",
  "definition": "The accuracy and appropriateness of information — valid information is truthful, based on good evidence, and relevant to the individual's specific situation."
 }
]



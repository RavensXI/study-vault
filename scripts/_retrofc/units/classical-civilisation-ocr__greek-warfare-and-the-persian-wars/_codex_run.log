assert all(f[\"verdict\"] == \"FIX\" for f in report[\"findings\"] if f[\"id\"] in {e[\"note\"].split(\":\", 1)[0] for e in edits})
assert {e[\"note\"].split(\":\", 1)[0] for e in edits} == {f[\"id\"] for f in report[\"findings\"] if f[\"verdict\"] == \"FIX\"}

def fields(lesson):
    text = (root / \"raw\" / f\"L{lesson:02d}.txt\").read_text(encoding=\"utf-8\")
    return {name: value for name, value in re.findall(r\"--- ([A-Z_]+) ---\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\Z)\", text, re.S)}

def get_path(value, path):
    for index in re.findall(r\"\\[(\\d+)\\]\", path):
        value = value[int(index)]
    return value

for edit in edits:
    field = fields(edit[\"lesson\"])[edit[\"field\"].upper()]
    if \"find\" in edit:
        assert field.count(edit[\"find\"]) == 1, (edit[\"note\"], field.count(edit[\"find\"]))
    else:
        assert get_path(json.loads(field), edit[\"path\"]) == edit[\"expect\"], edit[\"note\"]
print(f\"OK: {len(report['findings'])} findings, {len(edits)} edits; all find strings unique and all expectations match.\")

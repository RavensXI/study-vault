--- GLOSSARY_TERMS ---
[
 {
  "term": "physical theatre",
  "definition": "A style of performance in which movement and the body are the primary storytelling tools, with meaning communicated through choreographed physical sequences."
 },
 {
  "term": "round-by-through-under",
  "definition": "Frantic Assembly's signature movement devising method: performers explore every possible physical path around, through and under each other's bodies to build a movement vocabulary for a scene."
 },
 {
  "term": "chair duet",
  "definition": "A physical theatre duet using chairs as props, in which two performers interact with and around their chairs to explore relationship, tension and emotion through movement."
 },
 {
  "term": "ensemble",
  "definition": "A company of performers who work as a collective unit, often sharing roles and physical tasks equally rather than operating within a star-and-supporting-cast hierarchy."
 },
 {
  "term": "multi-roling",
  "definition": "When a performer plays more than one role in a production, often using costume, movement or vocal changes to signal the shift between characters."
 },
 {
  "term": "lifts",
  "definition": "A physical technique in which one or more performers physically support and elevate another, used to communicate trust, power, vulnerability or relationship."
 },
 {
  "term": "object transformation",
  "definition": "A technique in physical theatre in which everyday objects are used to represent different things in different scenes, with meaning shifted by the performer's relationship to the object."
 },
 {
  "term": "levels",
  "definition": "The use of different heights and vertical positioning on stage to communicate status, power and relationship between characters."
 },
 {
  "term": "gobo",
  "definition": "A patterned template placed in front of a lantern to cast a pattern of shadow and light onto the stage floor or set."
 }
]


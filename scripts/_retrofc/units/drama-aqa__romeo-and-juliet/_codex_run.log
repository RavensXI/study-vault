"'$edits = Get-Content -Raw -Encoding utf8 "$unit/_edits.json" | ConvertFrom-Json
$report = Get-Content -Raw -Encoding utf8 "$unit/_report.json" | ConvertFrom-Json
$fail = $false
function Get-Field([int]$lesson, [string]$field) {
  $text = Get-Content -Raw -Encoding utf8 (Join-Path $unit ("raw/L{0:D2}.txt" -f $lesson))
  $marker = "--- $($field.ToUpper()) ---`n"
  $value = $text.Substring($text.IndexOf($marker, [System.StringComparison]::Ordinal) + $marker.Length)
  $next = [regex]::Match($value, "`n--- [A-Z_]+ ---`n")
  if ($next.Success) { $value = $value.Substring(0, $next.Index) }
  $value.TrimEnd("`r", "`n")
}
foreach ($edit in $edits) {
  $value = Get-Field $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    if ([regex]::Matches($value, [regex]::Escape([string]$edit.find)).Count -ne 1) { $fail = $true; "bad find: L$($edit.lesson) $($edit.field)" }
  } else {
    $data = $value | ConvertFrom-Json
    $null = $edit.path -match '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"'
    if ("'$data[[int]$matches[1]].($matches[2]) -cne $edit.expect) { $fail = $true; "bad expect: L$($edit.lesson) $($edit.field) $($edit.path)" }
  }
}
$fixes = @($report.findings | Where-Object verdict -eq '"'FIX' | ForEach-Object id | Sort-Object)
"'$editIds = @($edits | ForEach-Object { if ($_.note -match '"'"'^(F'"\\d+):') { "'$matches[1] } } | Sort-Object -Unique)
if (($fixes -join '"',') -cne ("'$editIds -join '"',')) { "'$fail = $true; '"'bad finding/edit mapping' }
if ("'$fail) { exit 1 }

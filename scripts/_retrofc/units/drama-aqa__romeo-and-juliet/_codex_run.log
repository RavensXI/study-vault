errors=[]

def raw_field(lesson, field):
    text = open(root/'raw'/f'L{lesson:02d}.txt', encoding='utf-8').read()
    marker = f'--- {field.upper()} ---\\n'
    if marker not in text:
        raise ValueError(f'missing {lesson} {field}')
    value = text.split(marker, 1)[1]
    match = re.search(r'\\n--- [A-Z_]+ ---\\n', value)
    if match:
        value = value[:match.start()]
    return value.rstrip('\\r\\n')

for i, edit in enumerate(edits, 1):

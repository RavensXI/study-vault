"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$unit = '"'scripts/_retrofc/units/drama-aqa__romeo-and-juliet'
"'$edits = Get-Content -Raw -Encoding utf8 "$unit/_edits.json" | ConvertFrom-Json
$report = Get-Content -Raw -Encoding utf8 "$unit/_report.json" | ConvertFrom-Json
$errors = [System.Collections.Generic.List[string]]::new()
function Get-RawField([int]$lesson, [string]$field) {
  $text = Get-Content -Raw -Encoding utf8 (Join-Path $unit ("raw/L{0:D2}.txt" -f $lesson))
  $marker = "--- $($field.ToUpper()) ---`n"
  $start = $text.IndexOf($marker, [System.StringComparison]::Ordinal)
  if ($start -lt 0) { throw "missing field $lesson $field" }
  $value = $text.Substring($start + $marker.Length)
  $match = [regex]::Match($value, "`n--- [A-Z_]+ ---`n")
  if ($match.Success) { $value = $value.Substring(0, $match.Index) }
  return $value.TrimEnd("`r", "`n")
}
$i = 0
foreach ($edit in $edits) {
  $i++
  $source = Get-RawField $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    $count = [regex]::Matches($source, [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { $errors.Add("edit $i find count $count") }
  } else {
    $data = $source | ConvertFrom-Json
    if ([string]$edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') { "'$errors.Add("edit $i bad path") }
    else {
      $current = $data[[int]$matches[1]].($matches[2])
      if ($current -cne $edit.expect) { $errors.Add("edit $i expect mismatch") }
    }
  }
  if (-not $edit.field.EndsWith('"'_html')) {
    foreach ("'$key in '"'find','replace','expect','value') {
      "'$prop = $edit.PSObject.Properties[$key]
      if ($null -ne $prop -and [string]$prop.Value -match '"'&(?:[A-Za-z]+|#\\d+|#x[0-9A-Fa-f]+);') { "'$errors.Add("edit $i HTML entity in plain field $key") }
    }
  }
}
$fixes = @($report.findings | Where-Object verdict -eq '"'FIX' | ForEach-Object id | Sort-Object)
"'$editIds = @($edits | ForEach-Object { if ($_.note -match '"'"'^(F'"\\d+):') { "'$matches[1] } } | Sort-Object -Unique)
if (('"'@' + ("'$fixes -join '"',')) -cne ('@' + ("'$editIds -join '"','))) { "'$errors.Add('"'FIX/edit ID mismatch') }
foreach ("'$lesson in 1..8) {
  $htmlFields = @($edits | Where-Object { $_.lesson -eq $lesson -and $_.field.EndsWith('"'_html') } | ForEach-Object field | Sort-Object -Unique)
  foreach ("'$field in $htmlFields) {
    $before = Get-RawField $lesson $field
    $after = $before
    foreach ($edit in ($edits | Where-Object { $_.lesson -eq $lesson -and $_.field -eq $field -and $null -ne $_.find })) {
      $after = $after.Replace([string]$edit.find, [string]$edit.replace)
    }
    foreach ($pattern in '"'data-narration-id=', '<dfn\\b') {
      "'$old = [regex]::Matches($before, $pattern).Count
      $new = [regex]::Matches($after, $pattern).Count
      if ($old -ne $new) { $errors.Add("L$lesson $field changed $pattern count $old->$new") }
    }
  }
  $cards = (Get-RawField $lesson '"'flashcard_questions' | ConvertFrom-Json)
  foreach ("'$edit in ($edits | Where-Object { $_.lesson -eq $lesson -and $_.field -eq '"'flashcard_questions' -and "'$null -eq $_.find })) {
    if ($edit.path -match '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') { "'$cards[[int]$matches[1]].($matches[2]) = $edit.value }
  }
  $answers = @($cards | ForEach-Object a)
  foreach ($answer in $answers) {
    if (($answer -split '"'\\s+' | Where-Object { "'$_ }).Count -gt 30) { $errors.Add("L$lesson flashcard exceeds 30 words") }
    if (($answers | Where-Object { $_ -ceq $answer }).Count -gt 1) { $errors.Add("L$lesson duplicate flashcard answer") }
  }
}
$rawAll = Get-ChildItem "$unit/raw/L*.txt" | ForEach-Object { Get-Content -Raw -Encoding utf8 $_.FullName }
foreach ($banned in '"'Level [1-9]', 'Paper 1 Section [A-Z]', 'Component 1', 'AQA 8035', 'Edexcel 1GA0', 'OCR J384', 'Eduqas C111', 'Nothing worthy of credit', 'Award \\d+ marks for') {
  if ("'$rawAll -match $banned) { $errors.Add("banned raw string pattern: $banned") }
}
"edits=$($edits.Count) findings=$($report.findings.Count)"
if ($errors.Count) { $errors; exit 1 }

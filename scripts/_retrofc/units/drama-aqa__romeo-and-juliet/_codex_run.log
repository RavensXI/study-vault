+    "lesson": 8,
+    "field": "content_html",
+    "find": "<dfn class=\"term\" data-def=\"Brecht's term for the sense of critical distance an audience should maintain from the action; they should observe and judge, not lose themselves in it. Also called the alienation effect or Verfremdungseffekt.\">gestus</dfn>",

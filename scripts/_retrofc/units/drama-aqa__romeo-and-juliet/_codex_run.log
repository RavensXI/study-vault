    source = raw_field(edit['lesson'], field)
    if 'find' in edit:
        count = source.count(edit['find'])
        if count "'!= 1:
            errors.append(f'"'edit {i}: find count {count}')
    else:
        data=json.loads(source)
        m=re.fullmatch(r'\\[(\\d+)\\]\\.(.+)', edit['path'])
        if not m:
            errors.append(f'edit {i}: unsupported path {edit[\"path\"]}')
        else:
            current=data[int(m.group(1))][m.group(2)]
            if current "'!= edit['"'expect']:
                errors.append(f'edit {i}: expect mismatch: {current"'!r}'"')
    if not field.endswith('_html'):
        for key in ('find','replace','expect','value'):
            if key in edit and re.search(r'&(?:[a-zA-Z]+|#\\d+|#x[0-9a-fA-F]+);', str(edit[key])):
                errors.append(f'edit {i}: HTML entity in plain field {key}')

fixes={x['id'] for x in report['findings'] if x['verdict']=='FIX'}
edit_ids={re.match(r'(F\\d+):', x['note']).group(1) for x in edits if re.match(r'(F\\d+):', x['note'])}
if fixes "'!= edit_ids:
    errors.append(f'"'FIX/edit ID mismatch: fixes={sorted(fixes)}, edits={sorted(edit_ids)}')
for finding in report['findings']:
    if finding['verdict'] not in {'FIX','ADJUDICATE','NOTE'}:
        errors.append(f'bad verdict {finding[\"id\"]}')
for edit in edits:
    if edit['severity'] not in {'HIGH','MEDIUM','LOW'}:
        errors.append(f'bad severity {edit}')
print(f'edits={len(edits)} findings={len(report[\"findings\"])}')
if errors:
    print('\\n'.join(errors))
    sys.exit(1)

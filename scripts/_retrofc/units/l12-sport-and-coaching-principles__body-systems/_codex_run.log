"'$utf8 = [System.Text.Encoding]::UTF8
$edits = [System.IO.File]::ReadAllText((Join-Path $root '"'_edits.json'), "'$utf8) | ConvertFrom-Json -Depth 20
$problems = [System.Collections.Generic.List[string]]::new()
foreach ($edit in $edits) {
  $rawPath = Join-Path $root ('"'raw/L{0:D2}.txt' -f [int]"'$edit.lesson)
  $raw = [System.IO.File]::ReadAllText($rawPath, $utf8)
  $field = [string]$edit.field
  $pattern = '"'(?s)--- ' + [regex]::Escape("'$field.ToUpperInvariant()) + " ---'"\\r?\\n(.*?)(?=\\r?\\n--- |\\z)\"
  "'$m = [regex]::Match($raw, $pattern)
  if (-not $m.Success) { $problems.Add("L$($edit.lesson) $field: missing field"); continue }
  $value = $m.Groups[1].Value.TrimEnd("`r", "`n")
  if ($edit.PSObject.Properties.Name -contains '"'find') {
    "'$n = ([regex]::Matches($value, [regex]::Escape([string]$edit.find))).Count
    Write-Output "L$($edit.lesson) $field: find count=$n"
    if ($n -ne 1) { $problems.Add("L$($edit.lesson) $field: find count $n") }
  } else {
    $obj = $value | ConvertFrom-Json -Depth 20
    if ([string]$edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') { "'$problems.Add("invalid path $($edit.path)"); continue }
    $actual = [string]$obj[[int]$Matches[1]].($Matches[2])
    $ok = $actual -ceq [string]$edit.expect
    Write-Output "L$($edit.lesson) $field $($edit.path): expect match=$ok"
    if (-not $ok) { $problems.Add("L$($edit.lesson) $field $($edit.path): expect mismatch") }
  }
}
if ($problems.Count) { throw ($problems -join "`n") }

[
 {
  "term": "D-type flip-flop",
  "definition": "A digital circuit that can store one bit of data; its output retains its last state until a clock edge causes it to sample its D input."
 },
 {
  "term": "rising-edge triggered",
  "definition": "A flip-flop that only changes its outputs at the moment a clock signal transitions from LOW to HIGH, ignoring the D input at all other times."
 },
 {
  "term": "data latch",
  "definition": "A D-type flip-flop used to store a single bit of data so that it remains available at the output after the input has changed."
 },
 {
  "term": "binary up-counter",
  "definition": "A circuit built from flip-flops that counts upward in binary, advancing by one step on each clock pulse."
 }
]



"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$unit = '"'scripts/_retrofc/units/electronics-eduqas__application-of-electronics'
"'$edits = Get-Content -LiteralPath "$unit/_edits.json" -Raw -Encoding utf8 | ConvertFrom-Json
$fail = @()
foreach ($edit in $edits) {
  $raw = Get-Content -LiteralPath (Join-Path $unit (('"'raw/L{0:D2}.txt' -f [int]"'$edit.lesson))) -Raw -Encoding utf8
  $pattern = '"'(?s)--- ' + [regex]::Escape([string]"'$edit.field) + '"' ---\\r?\\n(.*?)(?=\\r?\\n--- |\\z)'
  "'$match = [regex]::Match($raw, $pattern, [Text.RegularExpressions.RegexOptions]::IgnoreCase)
  if (-not $match.Success) { $fail += "L$($edit.lesson) $($edit.field): field not found"; continue }
  $fieldValue = $match.Groups[1].Value
  if ($null -ne $edit.find) {
    $n = ([regex]::Matches($fieldValue, [regex]::Escape([string]$edit.find))).Count
    if ($n -ne 1) { $fail += "L$($edit.lesson) $($edit.field): find count $n" }
  }
  if ($null -ne $edit.path) {
    $array = $fieldValue | ConvertFrom-Json
    if ([string]$edit.path -match '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') {
      "'$actual = $array[[int]$matches[1]].PSObject.Properties[$matches[2]].Value
      if (-not ($actual -ceq $edit.expect)) { $fail += "L$($edit.lesson) $($edit.field) $($edit.path): expect mismatch; actual=[$actual]" }
    } else { $fail += "L$($edit.lesson) $($edit.field): unsupported path $($edit.path)" }
  }
}
if ($fail.Count) { $fail | ForEach-Object { $_ }; exit 1 }

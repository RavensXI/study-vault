    if ($edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.([A-Za-z_]+)"'$'"') { throw \"Unsupported path "'$($edit.path)" }
    $parsed = $field | ConvertFrom-Json
    $actual = $parsed[[int]$matches[1]].($matches[2])
    if ($actual -cne $edit.expect) { throw "Expect mismatch at $($edit.field) $($edit.path): [$actual]" }
  }
}

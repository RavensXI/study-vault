import json
import re
from pathlib import Path

root = Path(r\"scripts/_retrofc/units/media-studies-aqa__media-representations\")
report = json.loads((root / \"_report.json\").read_text(encoding=\"utf-8\"))
edits = json.loads((root / \"_edits.json\").read_text(encoding=\"utf-8\"))
assert set(report) == {\"unit\", \"checked_at\", \"spec_used\", \"findings\", \"lessons_clean\", \"summary\"}
assert len(edits) == sum(f[\"verdict\"] == \"FIX\" for f in report[\"findings\"])

def fields_for(lesson):
    text = (root / \"raw\" / f\"L{lesson:02d}.txt\").read_text(encoding=\"utf-8\")
    return {name.lower(): body for name, body in re.findall(r\""'^--- ([A-Z_]+) ---'"\\r?\\n(.*?)(?="'^--- [A-Z_]+ ---|'"\\Z)\", text, re.M | re.S)}

def resolve(value, path):
    for index, key in re.findall(r\"\\[(\\d+)\\]|\\.([A-Za-z_]+)\", path):
        value = value[int(index)] if index else value[key]
    return value

for edit in edits:
    field = fields_for(edit[\"lesson\"])[edit[\"field\"]]
    if \"find\" in edit:
        assert field.count(edit[\"find\"]) == 1, edit
    else:
        current = resolve(json.loads(field), edit[\"path\"])
        assert current == edit[\"expect\"], (edit, current)
print(f\"report findings={len(report['findings'])}; edits={len(edits)}; all find/expect checks passed\")

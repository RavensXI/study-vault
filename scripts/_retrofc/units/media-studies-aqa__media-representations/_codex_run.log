$edits = [System.IO.File]::ReadAllText((Join-Path $unitRoot '"'_edits.json'), "'$utf8) | ConvertFrom-Json
$requiredReport = @('"'unit','checked_at','spec_used','findings','lessons_clean','summary')
if ((@("'$report.PSObject.Properties.Name | Where-Object { $_ -notin $requiredReport }).Count -ne 0) -or ($report.PSObject.Properties.Count -ne $requiredReport.Count)) { throw '"'Unexpected _report.json shape' }
if (@("'$edits).Count -ne @($report.findings | Where-Object verdict -eq '"'FIX').Count) { throw 'FIX/edit count mismatch' }
foreach ("'$edit in $edits) {
  $rawPath = Join-Path $unitRoot ('"'raw/L{0:D2}.txt' -f [int]"'$edit.lesson)

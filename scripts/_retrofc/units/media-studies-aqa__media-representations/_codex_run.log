--- GLOSSARY_TERMS ---
[
 {
  "term": "Stuart Hall's encoding-decoding model",
  "definition": "Hall's model, developed in his 1973 paper 'Encoding/Decoding', which argues that media messages are encoded with a preferred meaning by producers and decoded by audiences in one of three ways: dominant, negotiated or oppositional."
 },
 {
  "term": "encoding",
  "definition": "The process by which media producers build a preferred meaning into a text through choices of language, image, framing and other codes."
 },
 {
  "term": "decoding",
  "definition": "The process by which audiences interpret a media text, which may differ from the preferred meaning encoded by the producer."
 },
 {
  "term": "dominant or preferred reading",
  "definition": "The reading position in which an audience member accepts the preferred meaning encoded by the producer, broadly agreeing with the ideological position the text promotes."
 },
 {
  "term": "negotiated reading",
  "definition": "The reading position in which an audience member partly accepts the preferred meaning but also modifies or rejects some elements based on their own experience or social position."
 },
 {
  "term": "oppositional reading",
  "definition": "The reading position in which an audience member rejects or inverts the preferred meaning, decoding the text from a fundamentally different ideological position."
 },
 {
  "term": "social variables",
  "definition": "Factors such as age, class, gender, ethnicity, nationality, sexuality and individual experience that shape how a person decodes a media text."
 },
 {
  "term": "polysemic text",
  "definition": "A text that carries multiple possible meanings and can be decoded in a range of ways by different audiences."
 }
]



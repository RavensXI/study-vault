  $fields = @{}
  foreach ($match in [regex]::Matches($raw, '"'(?ms)"'^--- ([A-Z_]+) ---'"\\r?\\n(.*?)(?="'^--- [A-Z_]+ ---|'"\\z)')) { "'$fields[$match.Groups[1].Value.ToLowerInvariant()] = $match.Groups[2].Value }
  $field = $fields[$edit.field]
  if ($null -eq $field) { throw "Missing field $($edit.field)" }
  if ($edit.PSObject.Properties.Name -contains '"'find') {
    "'$count = [regex]::Matches($field, [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { throw "Find count for $($edit.field): $count" }

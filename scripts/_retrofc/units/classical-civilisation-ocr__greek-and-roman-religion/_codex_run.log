--- GLOSSARY_TERMS ---
[
 {
  "term": "prothesis",
  "definition": "The first stage of a Greek funeral: the preparation and public laying-out of the body in the home, with the family gathering to mourn around it."
 },
 {
  "term": "ekphora",
  "definition": "The second stage of a Greek funeral: the procession that carried the body from the home to the place of burial or cremation, typically held before dawn."
 },
 {
  "term": "stele",
  "definition": "An upright stone grave marker, often inscribed with the name of the deceased and sometimes carved with a relief scene showing the person in life."
 },
 {
  "term": "Charon",
  "definition": "In Greek myth, the ferryman of the dead who transported souls across the river Styx (or Acheron) to the underworld, requiring payment of a coin placed in the mouth or on the eyes of the deceased."
 },
 {
  "term": "Genesia",
  "definition": "An Athenian annual public festival held in honour of the dead and the ancestors, at which offerings were made at graves."
 },
 {
  "term": "funeral clubs",
  "definition": "Roman associations whose members paid regular dues to guarantee a proper funeral and burial for themselves and their families, particularly among the poor and slave populations."
 }
]


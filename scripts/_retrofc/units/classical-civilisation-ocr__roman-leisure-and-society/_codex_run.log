import json
import re
from pathlib import Path

unit = Path(r\"scripts/_retrofc/units/classical-civilisation-ocr__roman-leisure-and-society\")
edits = json.loads((unit / \"_edits.json\").read_text(encoding=\"utf-8\"))
report = json.loads((unit / \"_report.json\").read_text(encoding=\"utf-8\"))

assert set(report) == {\"unit\", \"checked_at\", \"spec_used\", \"findings\", \"lessons_clean\", \"summary\"}
assert all(set(f) == {\"id\", \"lesson\", \"field\", \"severity\", \"claim\", \"truth\", \"evidence\", \"verdict\"} for f in report[\"findings\"])
assert all(e[\"note\"].split(\":\", 1)[0] in {f[\"id\"] for f in report[\"findings\"]} for e in edits)

def fields_for(lesson):
    text = (unit / \"raw\" / f\"L{lesson:02}.txt\").read_text(encoding=\"utf-8\")
    parts = re.split(r\""'^--- ([A-Z_]+) ---'"\\r?\\n\", text, flags=re.M)
    return {parts[i].lower(): parts[i + 1].rstrip(\"\\r\\n\") for i in range(1, len(parts), 2)}

errors = []
for e in edits:
    fields = fields_for(e[\"lesson\"])
    field = e[\"field\"]
    if field not in fields:
        errors.append(f\"missing field L{e['lesson']} {field}\")
        continue
    if \"find\" in e:
        count = fields[field].count(e[\"find\"])
        if count "'!= 1:
            errors.append(f"find count {count}: L{e['"'lesson']} {field} {e['note']}\")
    else:
        m = re.fullmatch(r\"\\[(\\d+)\\]\\.([A-Za-z_]+)\", e[\"path\"])
        if not m:
            errors.append(f\"bad path {e['path']}\")
            continue
        actual = json.loads(fields[field])[int(m.group(1))][m.group(2)]
        if actual "'!= e["expect"]:
            errors.append(f"expect mismatch: L{e['"'lesson']} {field} {e['path']} {e['note']}\")
    if field.endswith(\"_html\") and any(ord(ch) > 127 for ch in e[\"replace\"]):
        errors.append(f\"non-HTML-entity unicode in HTML replacement: {e['note']}\")
    if not field.endswith(\"_html\") and re.search(r\"&(?:[A-Za-z]+|#\\d+|#x[0-9A-Fa-f]+);\", e.get(\"value\", \"\")):
        errors.append(f\"HTML entity in plain-text value: {e['note']}\")

assert not errors, \"\\n\".join(errors)
assert all(f[\"verdict\"] == \"FIX\" for f in report[\"findings\"] if f[\"id\"] in {e[\"note\"].split(\":\", 1)[0] for e in edits})
assert {e[\"note\"].split(\":\", 1)[0] for e in edits} == {f[\"id\"] for f in report[\"findings\"] if f[\"verdict\"] == \"FIX\"}
from collections import Counter
print(\"validated\", len(edits), \"edits; findings\", dict(Counter(f[\"severity\"] for f in report[\"findings\"])))

--- GLOSSARY_TERMS ---
[
 {
  "term": "Lares",
  "definition": "The protecting spirits of the Roman household, each family having its own Lar who watched over the home and was honoured at the lararium."
 },
 {
  "term": "Penates",
  "definition": "The household gods of the store cupboard and provisions, protecting the family's food supplies and domestic wellbeing."
 },
 {
  "term": "lararium",
  "definition": "A household shrine in a Roman home, typically a niche or small cabinet in the atrium or kitchen, housing images of the Lares, Penates and the Genius of the paterfamilias."
 },
 {
  "term": "Lares Compitales",
  "definition": "The protective deities of the neighbourhood crossroads in Roman cities, whose shrines were maintained by the local community and worshipped at annual festivals."
 },
 {
  "term": "Lupercalia",
  "definition": "A festival held in mid-February in Rome, involving ritual purification and the striking of passersby with strips of goat-skin to promote fertility."
 },
 {
  "term": "Saturnalia",
  "definition": "A winter festival celebrated in mid-December in Rome, involving gift-giving, feasting and a temporary reversal of normal social roles in which masters served their slaves."
 },
 {
  "term": "genius loci",
  "definition": "The divine spirit of a place, believed in Roman religion to protect and embody a particular location."
 }
]



  $rawCache[$lesson] = $fields
  return $fields
}
$errors = [System.Collections.Generic.List[string]]::new()
$fixIds = [System.Collections.Generic.HashSet[string]]::new()
foreach ($f in @($report.findings)) {
  $props = @($f.PSObject.Properties.Name | Sort-Object) -join '"'|'
  if ("'$props -ne (@('"'id','lesson','field','severity','claim','truth','evidence','verdict') | Sort-Object) -join '|') { "'$errors.Add("finding shape $($f.id)") }
}
foreach ($e in @($edits)) {
  $fields = Get-Fields ([int]$e.lesson)
  if (-not $fields.ContainsKey($e.field)) { $errors.Add("missing field L$($e.lesson) $($e.field)"); continue }
  if ($null -ne $e.PSObject.Properties['"'find']) {
    "'$count = [regex]::Matches($fields[$e.field], [regex]::Escape([string]$e.find)).Count
    if ($count -ne 1) { $errors.Add("find count $count L$($e.lesson) $($e.field) $($e.note)") }
  } else {
    if ([string]$e.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.([A-Za-z_]+)"'$'"') { "'$errors.Add("bad path $($e.path)"); continue }
    $idx = [int]$matches[1]

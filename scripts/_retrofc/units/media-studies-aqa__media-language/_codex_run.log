  "definition": "The codes created through the use of spoken or written language, including word choice, register, tone and the formality of address."
 },
 {
  "term": "non-verbal codes",
  "definition": "The codes carried by gesture, posture, facial expression, eye contact and proxemics."
 },
 {
  "term": "house style",
  "definition": "The consistent set of design choices (fonts, colours, layout patterns) that give a publication its recognisable visual identity across all its products."
 },
 {
  "term": "genre",
  "definition": "A category of media product defined by the shared codes, conventions and audience expectations that give it a recognisable identity."
 },
 {
  "term": "genre cycle",
  "definition": "The process by which a genre develops through phases of establishment, intensification, parody and eventual transformation."
 },
 {
  "term": "genre hybridity",
  "definition": "The mixing of two or more genre conventions in a single media product, creating a product that belongs to more than one genre simultaneously."
 },
 {
  "term": "intertextuality",
  "definition": "The way media products consciously reference, quote or allude to other media products, creating additional layers of meaning for audiences who recognise the reference."
 }
]



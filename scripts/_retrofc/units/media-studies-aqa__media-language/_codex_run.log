import json, re
from pathlib import Path
unit = Path(r\"scripts/_retrofc/units/media-studies-aqa__media-language\")
edits = json.load(open(unit / \"_edits.json\", encoding=\"utf-8\"))
json.load(open(unit / \"_report.json\", encoding=\"utf-8\"))
fields = {\"content_html\": \"CONTENT_HTML\", \"description\": \"DESCRIPTION\", \"conclusion_html\": \"CONCLUSION_HTML\", \"exam_tip_html\": \"EXAM_TIP_HTML\", \"practice_questions\": \"PRACTICE_QUESTIONS\", \"knowledge_checks\": \"KNOWLEDGE_CHECKS\", \"flashcard_questions\": \"FLASHCARD_QUESTIONS\", \"glossary_terms\": \"GLOSSARY_TERMS\"}
def raw_field(lesson, field):
    raw = open(unit / \"raw\" / f\"L{lesson:02}.txt\", encoding=\"utf-8\").read()
    marker = f\"--- {fields[field]} ---\\n\"
    start = raw.index(marker) + len(marker)
    end = raw.find(\"\\n--- \", start)
    return raw[start:] if end == -1 else raw[start:end]
def value_at(v, path):
    for i, k in re.findall(r\"\\[(\\d+)\\]|\\.([A-Za-z_]+)\", path):
        v = v[int(i)] if i else v[k]
    return v
errors=[]
for e in edits:
    raw = raw_field(e[\"lesson\"], e[\"field\"])
    if \"find\" in e:
        n = raw.count(e[\"find\"])
        if n "'!= 1: errors.append(f"find {e['"'lesson']} {e['field']}: {n}\")
    else:
        current = value_at(json.loads(raw), e[\"path\"])
        if current "'!= e["expect"]: errors.append(f"expect {e['"'lesson']} {e['field']} {e['path']}: {current"'!r}")
if errors:
    raise SystemExit("'"\\n\".join(errors))
print(f\"validated {len(edits)} edits: every find is unique and every expect matches\")

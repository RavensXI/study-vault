    value = raw[start:start + nxt.start()] if nxt else raw[start:]
    value = value.rstrip(\"\\r\\n\")
    cache[key] = value
    return value

def json_path(value, path):
    for index, prop in re.findall(r\"\\[(\\d+)\\]\\.([A-Za-z_]+)\", path):
        value = value[int(index)][prop]
    return value

errors = []

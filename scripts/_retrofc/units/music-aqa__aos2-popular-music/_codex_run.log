[
 {
  "term": "a cappella",
  "definition": "Voices alone, without instrumental accompaniment."
 },
 {
  "term": "overdubbing",
  "definition": "Recording extra layers of a part on top of an existing recording."
 },
 {
  "term": "portamento",
  "definition": "A slide between pitches rather than a clean step."
 },
 {
  "term": "Scotch snap",
  "definition": "A short accented note on the beat followed by a longer note off it — a snapped, reverse-dotted rhythm."
 },
 {
  "term": "flattened submediant",
  "definition": "The key built on the flattened sixth degree of the scale — B flat in the key of D major — an unexpected, colourful modulation."
 },
 {
  "term": "plagal cadence",
  "definition": "A cadence moving from the subdominant to the tonic (IV–I) — the 'Amen' cadence."
 },
 {
  "term": "riff",
  "definition": "A short repeated melodic and rhythmic pattern."
 }

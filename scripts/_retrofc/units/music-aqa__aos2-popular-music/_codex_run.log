--- GLOSSARY_TERMS ---
[
 {
  "term": "Ballad",
  "definition": "In musical theatre, a slow, emotional song, usually for a solo voice, that lets a character reveal their inner feelings directly to the audience."
 },
 {
  "term": "\"I want\" song",
  "definition": "An early song in a musical in which the main character states what they want, setting up the plot that follows."
 },
 {
  "term": "Patter song",
  "definition": "A fast, wordy comic song where the humour comes from cramming as many words as possible into the rhythm."
 },
 {
  "term": "Reprise",
  "definition": "A later repeat of an earlier song in a musical, often with new lyrics that show how a character has changed."
 },
 {
  "term": "Leitmotif",
  "definition": "A short recurring musical idea attached to a character, place or idea, so its return in the score tells the audience they are present or near."
 },
 {
  "term": "Underscore",
  "definition": "Music played under dialogue or action in a film or game, supporting a scene without drawing attention to itself."
 },
 {
  "term": "Mickey-mousing",
  "definition": "Music that closely copies the exact timing of an on-screen action, such as a rising scale under a character climbing stairs."
 },
 {
  "term": "Ostinato",
  "definition": "A short musical pattern repeated continuously, often used to build tension as further layers are added on top."
 },
 {
  "term": "Diegetic sound",
  "definition": "Sound that characters within the story can hear themselves, such as a radio playing in the scene."
 },
 {
  "term": "Non-diegetic sound",
  "definition": "Sound that only the audience can hear, such as the film score, which the characters cannot hear."
 },
 {
  "term": "Vertical layering",
  "definition": "A game music technique in which layers, such as drums or a countermelody, are added or removed on top of a continuous loop to react to what the player is doing."
 },
 {
  "term": "Loop",
  "definition": "A section of music engineered to repeat with no audible join, so it can play for as long as a scene in a game lasts."
 }
]



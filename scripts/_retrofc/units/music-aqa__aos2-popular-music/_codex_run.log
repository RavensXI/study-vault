--- GLOSSARY_TERMS ---
[
 {
  "term": "Overdrive",
  "definition": "A warm, gritty distortion produced by pushing an amplifier or pedal hard."
 },
 {
  "term": "Quantised",
  "definition": "Snapped exactly onto the beat by software, so timing is machine-perfect."
 },
 {
  "term": "Pitch correction",
  "definition": "Software that pulls a sung note into tune, sometimes deliberately audible as an effect."
 },
 {
  "term": "Pre-chorus",
  "definition": "A short passage that builds tension between the verse and the chorus."
 },
 {
  "term": "Sung-through",
  "definition": "A musical whose story is carried in song, with little or no spoken dialogue."
 },
 {
  "term": "Leitmotif",
  "definition": "A short theme attached to a character, place or idea, returning whenever it appears."
 },
 {
  "term": "Loop",
  "definition": "A short section of music repeated continuously as the foundation of a track."
 },
 {
  "term": "Fuzz",
  "definition": "A heavier, buzzier guitar distortion effect popular in the 1960s."
 },
 {
  "term": "Double-tracked",
  "definition": "The same part recorded twice and layered, thickening the sound."
 },
 {
  "term": "Ostinato",
  "definition": "A short musical pattern repeated persistently."
 }
]



    \"glossary_terms\": \"GLOSSARY_TERMS\",
}
cache = {}
def raw_field(lesson, field):
    key = (lesson, field)
    if key in cache:
        return cache[key]
    raw = open(unit / \"raw\" / f\"L{lesson:02d}.txt\", encoding=\"utf-8\").read()

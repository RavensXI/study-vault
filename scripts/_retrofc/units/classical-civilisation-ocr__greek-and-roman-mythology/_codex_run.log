  "definition": "Goddess of wisdom, crafts and warfare; patron goddess of Athens, associated with the owl and the olive tree."
 },
 {
  "term": "Hephaistos",
  "definition": "God of fire, the forge and craftsmen; the divine smith of the gods who made their weapons and armour."
 },
 {
  "term": "Aphrodite",
  "definition": "Goddess of love, beauty and desire; born from the sea-foam and associated with doves, roses and the power of erotic attraction."
 },
 {
  "term": "eusebeia",
  "definition": "Reverence and respect shown towards the gods; a pious attitude expressed through correct ritual and worship."
 }
]



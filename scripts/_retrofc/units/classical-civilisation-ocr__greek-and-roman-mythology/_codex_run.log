function Get-Fields([int]$lesson) {
  $raw = Get-Content -LiteralPath ("$base/raw/L{0:d2}.txt" -f $lesson) -Raw -Encoding utf8
  $map = @{}
  $matches = [regex]::Matches($raw, '"'(?ms)"'^--- ([A-Z_]+) ---'"\\r?\\n(.*?)(?="'^--- [A-Z_]+ ---|'"\\z)')
  foreach ("'$match in $matches) { $map[$match.Groups[1].Value.ToLowerInvariant()] = $match.Groups[2].Value.TrimEnd("`r", "`n") }
  return $map
}
function Get-JsonPath($value, [string]$path) {
  $current = $value
  foreach ($segment in ($path -split '"'\\.')) {
    "'$property = [regex]::Match($segment, '"'"'^[''^'"\\[]+').Value
    if ("'$property) { $current = $current.$property }
    foreach ($token in [regex]::Matches($segment, '"'\\[(\\d+)\\]')) { "'$current = $current[[int]$token.Groups[1].Value] }
  }
  return $current
}
foreach ($edit in $edits) {
  $fields = Get-Fields ([int]$edit.lesson)
  $field = [string]$edit.field
  if ($null -ne $edit.find) {
    $count = [regex]::Matches($fields[$field], [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { $errors.Add("find count ${count}: L$($edit.lesson) $field") }
  } else {
    $current = Get-JsonPath ($fields[$field] | ConvertFrom-Json) ([string]$edit.path)
    if ([string]$current -cne [string]$edit.expect) { $errors.Add("expect mismatch: L$($edit.lesson) $field $($edit.path)") }
    if ($field -in @('"'practice_questions','knowledge_checks','flashcard_questions','glossary_terms') -and [string]"'$edit.value -match '"'&') { "'$errors.Add("HTML entity in plain replacement: L$($edit.lesson) $field $($edit.path)") }
  }
}
$fixIds = @($report.findings | Where-Object verdict -eq '"'FIX' | ForEach-Object id | Sort-Object)
"'$editIds = @($edits | ForEach-Object { ([regex]::Match($_.note, '"'"'^(F'"\\d+):')).Groups[1].Value } | Sort-Object -Unique)
if (("'$fixIds -join '"',') -cne ("'$editIds -join '"',')) { "'$errors.Add("FIX/edit IDs differ: fixes=$($fixIds -join '"',') edits="'$($editIds -join '"',')\") }

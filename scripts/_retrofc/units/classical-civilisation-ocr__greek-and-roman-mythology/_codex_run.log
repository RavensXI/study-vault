def fields_for(lesson):
    text = (raw_dir / f'L{lesson:02}.txt').read_text(encoding='utf-8')
    parts = re.split(r'"'^--- ([A-Z_]+) ---'"\\r?\\n', text, flags=re.M)
    return {parts[i].lower(): parts[i + 1].rstrip('\\r\\n') for i in range(1, len(parts), 2)}

def get_path(value, path):
    for token in re.findall(r'\\[(["'^'"\\]]+)\\]', path):
        value = value[int(token)] if token.isdigit() else value[token]
    return value

errors = []
for edit in edits:
    fields = fields_for(edit['lesson'])
    field = edit['field']
    if 'find' in edit:
        count = fields[field].count(edit['find'])
        if count "'!= 1:
            errors.append(f"find count {count}: L{edit['"'lesson']} {field} {edit['find']"'!r}")
    else:
        actual = get_path(json.loads(fields[field]), edit['"'path'])
        if actual "'!= edit['"'expect']:
            errors.append(f\"expect mismatch: L{edit['lesson']} {field} {edit['path']}: {actual"'!r}")
        if field in {'"'practice_questions', 'knowledge_checks', 'flashcard_questions', 'glossary_terms'} and '&' in edit['value']:
            errors.append(f\"HTML entity in plain replacement: L{edit['lesson']} {field} {edit['path']}\")

fix_ids = {f['id'] for f in report['findings'] if f['verdict'] == 'FIX'}
edit_ids = {re.match(r'(F\\d+):', e['note']).group(1) for e in edits}
if fix_ids "'!= edit_ids:
    errors.append(f"FIX/edit IDs differ: fixes={sorted(fix_ids)}, edits={sorted(edit_ids)}")
if report['"'spec_used'] "'!= '"'specs/ocr/classical-civilisation-J199.md':
    errors.append('incorrect spec_used')
print('report findings:', len(report['findings']))
print('edits:', len(edits))
print('FIX IDs:', ', '.join(sorted(fix_ids)))
print('validation:', 'PASS' if not errors else 'FAIL')
for error in errors:
    print(error)

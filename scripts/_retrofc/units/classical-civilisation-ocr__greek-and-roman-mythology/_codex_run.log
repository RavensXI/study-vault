[
 {
  "a": "The oath-river of the gods in the Underworld; the Olympians swore their most binding oaths by it. The dead crossed the Acheron, not the Styx, ferried by Charon.",
  "q": "What is the Styx?"
 },
 {
  "a": "The ferryman of the Underworld; the dead paid him an obol (coin) to cross the river Acheron.",
  "q": "Who was Charon, and what did the dead need to pay him?"

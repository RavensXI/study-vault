 }
]

--- GLOSSARY_TERMS ---
[
 {
  "term": "Underworld",
  "definition": "The realm of the dead in ancient Greek and Roman belief, ruled by Hades (Greek) or Pluto (Roman); a vast underground kingdom divided into regions for the different kinds of dead."
 },
 {
  "term": "Styx",
  "definition": "The river of hatred in the Greek Underworld and the oath-river of the gods; the Olympians swore their most solemn and binding oaths by it. The dead were ferried across the Acheron (not the Styx) by Charon."
 },
 {
  "term": "Charon",
  "definition": "The ferryman of the Underworld who carried the souls of the dead across the river Acheron in return for an obol (coin); the dead were buried with a coin placed on their tongue or eyes to pay him."
 },
 {
  "term": "Cerberus",
  "definition": "The three-headed dog that guarded the entrance to the Underworld, preventing the living from entering and the dead from leaving."
 },
 {
  "term": "Homeric Hymn to Demeter",
  "definition": "A long Homeric Hymn telling the story of Persephone's abduction by Hades and Demeter's grief and search; it explains the origin of the seasons and the Eleusinian Mysteries."
 },
 {
  "term": "Orpheus",
  "definition": "The legendary musician and poet of Greek and Roman myth who descended into the Underworld to retrieve his dead wife Eurydice; his story is told by Ovid in Metamorphoses 10.1–64."
 }
]



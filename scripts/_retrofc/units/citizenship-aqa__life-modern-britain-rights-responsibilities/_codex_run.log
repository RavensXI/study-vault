import json, re
from pathlib import Path
base = Path(r'scripts/_retrofc/units/citizenship-aqa__life-modern-britain-rights-responsibilities')
edits = json.loads((base / '_edits.json').read_text(encoding='utf-8'))
label = {'description':'DESCRIPTION','content_html':'CONTENT_HTML','conclusion_html':'CONCLUSION_HTML','exam_tip_html':'EXAM_TIP_HTML','practice_questions':'PRACTICE_QUESTIONS','knowledge_checks':'KNOWLEDGE_CHECKS','flashcard_questions':'FLASHCARD_QUESTIONS','glossary_terms':'GLOSSARY_TERMS'}
cache = {}
def sections(lesson):
    if lesson not in cache:
        text = (base / 'raw' / f'L{lesson:02}.txt').read_text(encoding='utf-8')
        parts = re.split(r'"'^--- ([A-Z_]+) ---'"\\r?\\n', text, flags=re.M)
        cache[lesson] = {parts[i]: parts[i+1].rstrip() for i in range(1, len(parts), 2)}
    return cache[lesson]
def get_path(obj, path):
    cur = obj
    for idx, key in re.findall(r'\\[(\\d+)\\]|\\.([A-Za-z_]+)', path):
        cur = cur[int(idx)] if idx else cur[key]
    return cur
errors = []
for e in edits:
    raw = sections(e['lesson'])[label[e['field']]]
    if 'find' in e:
        n = raw.count(e['find'])
        if n "'!= 1:
            errors.append(f"find L{e['"'lesson']} {e['field']} count={n}: {e['find']"'!r}")
    else:
        actual = get_path(json.loads(raw), e['"'path'])
        if actual "'!= e['"'expect']:
            errors.append(f\"expect L{e['lesson']} {e['field']} {e['path']}: {actual"'!r} != {e['"'expect']"'!r}")
print(f'"'Validated {len(edits)} edits against {len(cache)} raw lessons.')
if errors:
    print('\\n'.join(errors))
    raise SystemExit(1)

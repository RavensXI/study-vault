+  {"lesson":9,"field":"flashcard_questions","path":"[10].q","expect":"At what age can a person in England and Wales marry with parental consent?","value":"What is the minimum age to marry in England and Wales?","severity":"HIGH","note":"F11: Parental consent no longer permits marriage under 18 in England and Wales."},

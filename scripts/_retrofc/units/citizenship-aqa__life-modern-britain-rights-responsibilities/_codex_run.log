[
 {
  "term": "juror",
  "definition": "A member of a jury: a group of twelve citizens selected at random to decide whether a defendant is guilty or not guilty in Crown Court trials."
 },
 {
  "term": "witness",
  "definition": "A person who gives evidence in a legal proceeding, either because they observed the relevant events or because they have relevant expert knowledge."
 },
 {
  "term": "magistrate",
  "definition": "A volunteer member of the public, also called a Justice of the Peace (JP), who sits on a magistrates' court bench to hear and decide less serious criminal cases."
 },
 {
  "term": "special constable",
  "definition": "A volunteer police officer who has the same powers as a regular (warranted) police officer but works on a part-time, unpaid basis."
 },
 {
  "term": "Police and Crime Commissioner (PCC)",
  "definition": "An elected official responsible for a police force area, setting the local police and crime plan and holding the chief constable to account."
 },
 {
  "term": "tribunal",
  "definition": "A specialist judicial body that resolves disputes in a specific area of law, such as employment or immigration, often with a legally qualified judge and lay members."
 },
 {
  "term": "perjury",
  "definition": "The criminal offence of giving false testimony under oath in a legal proceeding."
 }
]



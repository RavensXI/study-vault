  "definition": "A commitment to acknowledging and valuing the rights and dignity of others, even where views and backgrounds differ."
 },
 {
  "term": "social cohesion",
  "definition": "The degree to which different groups in a society live alongside one another in a spirit of respect and shared civic belonging."
 },
 {
  "term": "multiculturalism",
  "definition": "A social model in which different cultural, ethnic and religious groups coexist and are encouraged to maintain their distinct identities within a shared civic framework."
 }
]



"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$unit = '"'scripts/_retrofc/units/citizenship-aqa__life-modern-britain-rights-responsibilities'
"'$report = Get-Content -LiteralPath (Join-Path $unit '"'_report.json') -Raw -Encoding utf8 | ConvertFrom-Json
"'$edits = Get-Content -LiteralPath (Join-Path $unit '"'_edits.json') -Raw -Encoding utf8 | ConvertFrom-Json
"'$errors = [System.Collections.Generic.List[string]]::new(); $cache = @{}
foreach ($edit in $edits) {
  $lesson = [int]$edit.lesson
  if (-not $cache.ContainsKey($lesson)) {
    $raw = Get-Content -LiteralPath (Join-Path $unit ("raw/L{0:D2}.txt" -f $lesson)) -Raw -Encoding utf8
    $sections = @{}
    foreach ($m in [regex]::Matches($raw, '"'(?ms)"'^---'"\\r?\\n(["'^'"\\r\\n]+)\\r?\\n---\\r?\\n(.*?)(?="'^---'"\\r?\\n["'^'"\\r\\n]+\\r?\\n---\\r?\\n|\\z)')) { "'$sections[$m.Groups[1].Value] = $m.Groups[2].Value.Trim() }
    $cache[$lesson] = $sections
  }
  $fieldText = $cache[$lesson][$edit.field]
  if ($null -eq $fieldText) { $errors.Add("L$lesson missing field $($edit.field)"); continue }
  if ($edit.PSObject.Properties.Name -contains '"'find') {
    "'$count = ([regex]::Matches($fieldText, [regex]::Escape([string]$edit.find))).Count
    if ($count -ne 1) { $errors.Add("$($edit.note): find count $count") }
    if ($edit.field.EndsWith('"'_html') -and ([string]"'$edit.replace -match '"'["'^'"\\u0000-\\u007F]')) { "'$errors.Add("$($edit.note): non-ASCII HTML replacement") }
  } else {
    $value = $fieldText | ConvertFrom-Json
    foreach ($segment in ([string]$edit.path).Split('"'.')) {
      if ("'$segment -match '"'"'^'"\\[(\\d+)\\]"'$'"') { "'$value = $value[[int]$matches[1]] }
      elseif ($segment -match '"'"'^(.+)'"\\[(\\d+)\\]"'$'"') { "'$value = $value.($matches[1])[[int]$matches[2]] }
      else { $value = $value.$segment }
    }
    if ([string]$value -cne [string]$edit.expect) { $errors.Add("$($edit.note): expect mismatch") }
  }
}
$ids = @($report.findings | ForEach-Object id)
if ((@($ids | Sort-Object -Unique).Count) -ne $ids.Count) { $errors.Add('"'duplicate finding ids') }
foreach ("'$finding in $report.findings) {
  $linked = @($edits | Where-Object { $_.note -match ('"'"'^{0}:'"' -f [regex]::Escape("'$finding.id)) })
  if ($finding.verdict -eq '"'FIX' -and "'$linked.Count -eq 0) { $errors.Add("$($finding.id): FIX without edit") }
  if ($finding.verdict -ne '"'FIX' -and "'$linked.Count -ne 0) { $errors.Add("$($finding.id): non-FIX with edit") }
}
if ($errors.Count) { $errors; exit 1 }
$severities = $report.findings | Group-Object severity | Sort-Object Name | ForEach-Object { "$($_.Name)=$($_.Count)" }
$adjudicates = @($report.findings | Where-Object verdict -eq '"'ADJUDICATE').Count
"'$notes = @($report.findings | Where-Object verdict -eq '"'NOTE').Count
\"Validated "'$($report.findings.Count) findings, $($edits.Count) edits, $($cache.Count) lesson files; $($severities -join '"', '); ADJUDICATE="'$adjudicates; NOTE=$notes."' in C:\Users\tshau\Documents\Study Vault

--- GLOSSARY_TERMS ---
[
 {
  "term": "Local Area Network (LAN)",
  "definition": "A network that connects computers and devices within a limited geographical area such as a single building, school or office site."
 },
 {
  "term": "Wide Area Network (WAN)",
  "definition": "A network that connects computers and devices across large geographical areas, potentially spanning cities, countries or continents, often using leased telecommunication lines."
 },
 {
  "term": "protocol",
  "definition": "A set of agreed rules and standards that govern how data is formatted, transmitted and received across a network, ensuring different devices can communicate reliably."
 },
 {
  "term": "Bluetooth",
  "definition": "A short-range wireless standard for connecting devices over distances up to about 10 metres, commonly used for headphones, keyboards and file transfer between phones."
 },
 {
  "term": "packet sniffing",
  "definition": "The interception and reading of data packets travelling across a network, using specialist software, which can expose unencrypted data to unauthorised users."
 }
]



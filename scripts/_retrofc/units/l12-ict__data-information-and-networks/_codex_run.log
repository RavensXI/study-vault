"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
"'$ErrorActionPreference = '"'Stop'
"'$unit = '"'scripts/_retrofc/units/l12-ict__data-information-and-networks'
"'$report = Get-Content -Raw -Encoding utf8 "$unit/_report.json" | ConvertFrom-Json
$edits = Get-Content -Raw -Encoding utf8 "$unit/_edits.json" | ConvertFrom-Json
$rawRoot = "$unit/raw"
$problems = @()
foreach ($edit in $edits) {
  $raw = Get-Content -Raw -Encoding utf8 (Join-Path $rawRoot ('"'L{0:d2}.txt' -f [int]"'$edit.lesson))
  $header = '"'--- ' + "'$edit.field.ToUpper() + '"' ---'
  "'$start = $raw.IndexOf($header, [StringComparison]::Ordinal)
  if ($start -lt 0) { $problems += "missing field $($edit.lesson) $($edit.field)"; continue }
  $start += $header.Length
  if ($start -lt $raw.Length -and $raw[$start] -eq "`r") { $start++ }
  if ($start -lt $raw.Length -and $raw[$start] -eq "`n") { $start++ }
  $end = $raw.IndexOf("`n--- ", $start, [StringComparison]::Ordinal)
  if ($end -lt 0) { $end = $raw.Length }
  $field = $raw.Substring($start, $end - $start).Trim()
  if ($edit.PSObject.Properties.Name -contains '"'find') {
    "'$count = [regex]::Matches($field, [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { $problems += "find count $($edit.lesson) $($edit.field): $count" }
  } else {
    $obj = $field | ConvertFrom-Json
    if ($edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.(.+)"'$'"') { "'$problems += "bad path $($edit.path)"; continue }
    $actual = $obj[[int]$Matches[1]].($Matches[2])
    if ([string]$actual -cne [string]$edit.expect) { $problems += "expect mismatch $($edit.lesson) $($edit.field) $($edit.path)" }
  }
}
$ids = @($report.findings | ForEach-Object id)
$fixIds = @($report.findings | Where-Object verdict -eq '"'FIX' | ForEach-Object id)
"'$editIds = @($edits | ForEach-Object { if ($_.note -match '"'"'^(F'"\\d+):') { "'$Matches[1] } else { '"'' } }) | Sort-Object -Unique
"'$uncovered = $fixIds | Where-Object { $_ -notin $editIds }
$extra = $editIds | Where-Object { $_ -and $_ -notin $fixIds }
if ($uncovered) { $problems += "FIX without edit: $($uncovered -join '"', ')\" }
if ("'$extra) { $problems += "edit without FIX: $($extra -join '"', ')\" }
if ("'$problems.Count) { $problems | ForEach-Object { Write-Output $_ }; exit 1 }
Write-Output "Validated $($report.findings.Count) findings and $($edits.Count) edits; all finds are unique and JSON expects match."

"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
const fs = require('fs');
const path = require('path');
const unit = 'scripts/_retrofc/units/classical-civilisation-ocr__the-mycenaean-world';
const edits = JSON.parse(fs.readFileSync(path.join(unit, '_edits.json'), 'utf8'));
const report = JSON.parse(fs.readFileSync(path.join(unit, '_report.json'), 'utf8'));
let failures = [];
function fieldsFor(lesson) {
  const raw = fs.readFileSync(path.join(unit, 'raw', "'`L${String(lesson).padStart(2, '"'0')}.txt"'`), '"'utf8');
  const fields = {};
  const re = /"'^--- ([A-Z_]+) ---'"\\r?\\n/gm;
  let matches = [], m;
  while ((m = re.exec(raw))) matches.push({ name: m[1].toLowerCase(), start: re.lastIndex, marker: m.index });
  for (let i = 0; i < matches.length; i++) {
    const end = i + 1 < matches.length ? matches[i + 1].marker : raw.length;
    fields[matches[i].name] = raw.slice(matches[i].start, end).replace(/\\r?\\n"'$/, '"'');
  }
  return fields;
}
function atPath(value, p) {
  const re = /\\[(\\d+)\\]|\\.([A-Za-z_][A-Za-z0-9_]*)/g;
  let cur = value, m, matched = false;
  while ((m = re.exec(p))) { matched = true; cur = cur[m[1] === undefined ? m[2] : Number(m[1])]; }
  if ("'!matched) throw new Error(`Bad path ${p}`);
  return cur;
}
const cache = new Map();
for (const edit of edits) {
  let fields = cache.get(edit.lesson);
  if (!fields) { fields = fieldsFor(edit.lesson); cache.set(edit.lesson, fields); }
  const field = fields[edit.field];
  if (field === undefined) { failures.push(`L${edit.lesson} missing ${edit.field}`); continue; }
  if ('"'find' in edit) {
    const count = field.split(edit.find).length - 1;
    if (count "'!== 1) failures.push(`L${edit.lesson} ${edit.field} find count ${count}: ${edit.note}`);
  } else {
    const value = atPath(JSON.parse(field), edit.path);
    if (JSON.stringify(value) !== JSON.stringify(edit.expect)) failures.push(`L${edit.lesson} ${edit.field}${edit.path} expect mismatch: ${edit.note}`);
  }
}

    else:
        current = get_path(json.loads(raw), edit[\"path\"])
        if current "'!= edit["expect"]:
            errors.append(f"expect {edit['"'note']}: {current"'!r}")
if errors:
    raise SystemExit("'"\\n\".join(errors))

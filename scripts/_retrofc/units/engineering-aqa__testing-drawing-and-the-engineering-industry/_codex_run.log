}
def fields(lesson):
    text = (unit / \"raw\" / f\"L{lesson:02}.txt\").read_text(encoding=\"utf-8\")
    out = {}
    for name in marker.values():
        start = f\"--- {name} ---\\n\"
        a = text.index(start) + len(start)
        b = text.find(\"\\n--- \", a)
        out[name] = text[a:] if b == -1 else text[a:b]
    return out

def get_path(value, path):
    cur = value
    for part in path.replace(\"]\", \"\").split(\"[\"):
        if part:
            cur = cur[int(part)] if part.isdigit() else cur[part.lstrip(\".\")]
    return cur
errors = []

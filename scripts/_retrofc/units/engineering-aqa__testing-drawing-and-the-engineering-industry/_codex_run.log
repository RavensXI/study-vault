"'$edits = Get-Content -LiteralPath "$unit/_edits.json" -Raw -Encoding utf8 | ConvertFrom-Json
$markers = @{ content_html = '"'CONTENT_HTML'; practice_questions = 'PRACTICE_QUESTIONS'; knowledge_checks = 'KNOWLEDGE_CHECKS'; flashcard_questions = 'FLASHCARD_QUESTIONS' }
function Get-RawField([int]"'$lesson, [string]$field) {
  $text = Get-Content -LiteralPath (Join-Path $unit ('"'raw/L{0:d2}.txt' -f "'$lesson)) -Raw -Encoding utf8
  $name = $markers[$field]
  $pattern = '"'(?s)--- ' + [regex]::Escape("'$name) + '"' ---\\r?\\n(.*?)(?=\\r?\\n--- |\\z)'
  "'$match = [regex]::Match($text, $pattern)
  if (-not $match.Success) { throw "Cannot read $field in L$lesson" }
  return $match.Groups[1].Value
}
$errors = [System.Collections.Generic.List[string]]::new()
foreach ($edit in $edits) {
  $raw = Get-RawField $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    $matches = [regex]::Matches($raw, [regex]::Escape([string]$edit.find)).Count
    if ($matches -ne 1) { $errors.Add("find $($edit.note): $matches matches") }
  } else {
    $current = $raw | ConvertFrom-Json
    foreach ($part in [regex]::Matches([string]$edit.path, '"'(?:\\[(\\d+)\\])|(?:\\.(\\w+))')) {
      if ("'$part.Groups[1].Success) { $current = $current[[int]$part.Groups[1].Value] }
      else { $current = $current.($part.Groups[2].Value) }
    }
    if ([string]$current -cne [string]$edit.expect) { $errors.Add("expect $($edit.note) does not match") }
  }
}
if ($errors.Count) { $errors; exit 1 }

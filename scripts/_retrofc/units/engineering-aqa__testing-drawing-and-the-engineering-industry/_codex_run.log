--- GLOSSARY_TERMS ---
[
 {
  "term": "stress",
  "definition": "The internal force per unit cross-sectional area of a material when a load is applied, calculated as σ = F ÷ A, with SI unit N/m² (Pa)."
 },
 {
  "term": "strain",
  "definition": "The fractional change in the length of a material when a load is applied, calculated as ε = ΔL ÷ L. Strain has no unit — it is a dimensionless ratio."
 },
 {
  "term": "Young's modulus",
  "definition": "A measure of a material's stiffness, equal to stress divided by strain (E = σ ÷ ε), with SI unit N/m² (Pa). A higher value means a stiffer material."
 },
 {
  "term": "yield point",
  "definition": "The stress at which a material transitions from elastic (reversible) to plastic (permanent) deformation."
 },
 {
  "term": "factor of safety",
  "definition": "The ratio of a material's yield stress to the maximum working stress allowed in design, providing a safety margin against unexpected overloads."
 },
 {
  "term": "ductile",
  "definition": "Describes a material that undergoes significant plastic deformation before fracture, giving visible warning of failure. Example: mild steel."
 },
 {
  "term": "brittle",
  "definition": "Describes a material that fractures suddenly with no plastic deformation, giving no warning of failure. Example: cast iron, glass."
 }
]



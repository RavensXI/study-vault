  if ($edit.field -eq '"'flashcard_questions' -and "'$edit.value.Split([char[]]'"' ', [System.StringSplitOptions]::RemoveEmptyEntries).Count -gt 30) { throw 'flashcard too long' }
  if ("'$edit.note -notlike "$($report.findings[$i].id):*") { throw "finding/edit mismatch $i" }
}

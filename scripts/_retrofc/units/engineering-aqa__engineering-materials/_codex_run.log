[
 {
  "term": "renewable energy",
  "definition": "Energy sources that are naturally replenished on a human timescale, such as wind, solar, tidal, wave, hydroelectric and biomass."
 },
 {
  "term": "non-renewable energy",
  "definition": "Energy sources formed over millions of years that are consumed far faster than they are replenished, including coal, oil and natural gas."
 },
 {
  "term": "radioactive waste",
  "definition": "Highly radioactive material produced as a by-product of nuclear power generation that remains hazardous for thousands of years and must be securely stored."
 },
 {
  "term": "engineered lifespan",
  "definition": "The design decision to make a product last for a specific, limited service life, after which it is expected to be replaced."
 },
 {
  "term": "planned obsolescence",
  "definition": "The deliberate design of a product so that it becomes obsolete or fails after a set period, encouraging the customer to purchase a replacement."
 },
 {
  "term": "service interval",
  "definition": "A manufacturer-specified schedule of inspections and replacements to keep an engineered product in safe working condition throughout its designed service life."
 },
 {
  "term": "recovery of materials",
  "definition": "The process of collecting, separating and processing materials from discarded products so that they can be used again as raw material in manufacturing."
 }
]



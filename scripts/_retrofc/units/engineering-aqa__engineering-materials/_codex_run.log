[
 {
  "term": "mechanical properties",
  "definition": "The measurable characteristics that describe how a material responds to mechanical forces, including the way it deforms, breaks or resists wear."
 },
 {
  "term": "strength",
  "definition": "The ability of a material to withstand an applied force without permanently deforming or breaking."
 },
 {
  "term": "stiffness",
  "definition": "The ability of a material to resist bending or deflection when a force is applied; also described as the elastic modulus of the material."
 },
 {
  "term": "toughness",
  "definition": "The ability of a material to absorb energy and deform plastically before fracturing; often measured by the area under a stress-strain curve."
 },
 {
  "term": "brittleness",
  "definition": "The tendency of a material to fracture suddenly with little or no plastic deformation before breaking."
 },
 {
  "term": "ductility",
  "definition": "The ability of a material to be drawn out into a wire or extended in one direction without fracturing."
 },
 {
  "term": "malleable",
  "definition": "A material that can be hammered, pressed or rolled into thin sheets without fracturing."
 },
 {
  "term": "Brinell hardness",
  "definition": "A scale measuring the hardness of a material by the resistance of its surface to a small indentation made by a standardised tool under a known force."
 }
]



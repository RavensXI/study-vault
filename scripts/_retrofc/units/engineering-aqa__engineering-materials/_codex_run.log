"'$report = Get-Content -LiteralPath "$unit/_report.json" -Raw -Encoding utf8 | ConvertFrom-Json
$edits = Get-Content -LiteralPath "$unit/_edits.json" -Raw -Encoding utf8 | ConvertFrom-Json
$sectionNames = @{ content_html='"'CONTENT_HTML'; flashcard_questions='FLASHCARD_QUESTIONS'; practice_questions='PRACTICE_QUESTIONS'; knowledge_checks='KNOWLEDGE_CHECKS' }
function Get-Fields([int]"'$lesson) {
  $raw = Get-Content -LiteralPath "$unit/raw/L$($lesson.ToString('"'00')).txt\" -Raw -Encoding utf8
  "'$result = @{}
  [regex]::Matches($raw, '"'(?ms)"'^--- ([A-Z_]+) ---'"\\r?\\n(.*?)(?="'^--- [A-Z_]+ ---|'"\\z)') | ForEach-Object { "'$result[$_.Groups[1].Value] = $_.Groups[2].Value.Trim() }
  return $result
}
function Resolve-Path($value, [string]$path) {
  [regex]::Matches($path, '"'\\[(\\d+)\\]|\\.([A-Za-z_]+)') | ForEach-Object {
    if ("'$_.Groups[1].Success) { $value = $value[[int]$_.Groups[1].Value] } else { $value = $value.($_.Groups[2].Value) }

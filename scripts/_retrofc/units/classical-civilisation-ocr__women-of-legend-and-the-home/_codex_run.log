"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command '$unit = '"'scripts/_retrofc/units/classical-civilisation-ocr__women-of-legend-and-the-home'
"'$edits = Get-Content -Raw -Encoding utf8 "$unit/_edits.json" | ConvertFrom-Json
$errors = [System.Collections.Generic.List[string]]::new()
function Get-RawField([int]$Lesson, [string]$Field) {
  $raw = Get-Content -Raw -Encoding utf8 (Join-Path $unit ("raw/L{0:D2}.txt" -f $Lesson))
  $heading = $Field.ToUpperInvariant()
  $match = [regex]::Match($raw, "(?s)--- $heading ---'"\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)\")
  if (-not "'$match.Success) { throw "Missing field $Lesson/$Field" }
  $match.Groups[1].Value.TrimEnd("`r", "`n")
}
foreach ($edit in $edits) {
  $rawField = Get-RawField $edit.lesson $edit.field
  if ($null -ne $edit.find) {
    $count = 0; $offset = 0
    while ($true) {
      $at = $rawField.IndexOf([string]$edit.find, $offset, [System.StringComparison]::Ordinal)
      if ($at -lt 0) { break }
      $count++; $offset = $at + $edit.find.Length
    }
    if ($count -ne 1) { $errors.Add("find count $count for L$($edit.lesson) $($edit.field)") }
  }
  if ($null -ne $edit.expect) {
    $data = $rawField | ConvertFrom-Json
    if ($edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.([A-Za-z_]+)"'$'"') { "'$errors.Add("unsupported path $($edit.path)"); continue }
    $actual = [string]$data[[int]$Matches[1]].PSObject.Properties[$Matches[2]].Value
    if (-not [string]::Equals($actual, [string]$edit.expect, [System.StringComparison]::Ordinal)) { $errors.Add("expect mismatch for L$($edit.lesson) $($edit.field) $($edit.path)") }
  }
  if ($null -ne $edit.value -and ($edit.value -match '"'&(?:[A-Za-z]+|#\\d+);' -or "'$edit.value -match "[A-Za-z]'"'[A-Za-z]\")) { "'$errors.Add("plain value encoding issue for L$($edit.lesson) $($edit.field) $($edit.path)") }
}
try { Get-Content -Raw -Encoding utf8 "$unit/_report.json" | ConvertFrom-Json | Out-Null } catch { $errors.Add("report JSON invalid") }
if ($errors.Count) { $errors; exit 1 }

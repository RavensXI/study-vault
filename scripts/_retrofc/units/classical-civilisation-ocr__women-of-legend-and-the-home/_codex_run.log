+  {"lesson":4,"field":"practice_questions","path":"[0].marks","expect":"1 mark for: syssitia (accept 'the communal barracks' or 'the men's dining halls').","value":"1 mark for: syssitia (accept ‘the communal dining groups’ or ‘the common meals’).","severity":"MEDIUM","note":"F10: Syssitia were dining groups, not barracks."},
+  {"lesson":4,"field":"knowledge_checks","path":"[2].q","expect":"Spartan husbands lived in the men's communal _____ until around age thirty, even after they were married.","value":"Spartan husbands continued to attend communal _____ even after they were married.","severity":"MEDIUM","note":"F10: The syssitia were meals, so the question must not call them sleeping quarters."},
+  {"lesson":4,"field":"flashcard_questions","path":"[2].a","expect":"The communal dining and sleeping barracks where Spartan male citizens lived until around age thirty.","value":"The compulsory communal meals and dining groups for Spartan male citizens.","severity":"MEDIUM","note":"F10: Correct the definition of syssitia."},

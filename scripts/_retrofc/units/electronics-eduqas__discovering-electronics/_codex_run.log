[
 {
  "term": "voltage divider",
  "definition": "A circuit of two resistors in series across a supply, where the output voltage is taken from the junction between them. The output depends on the ratio of the two resistances."
 },
 {
  "term": "light-dependent resistor (LDR)",
  "definition": "A resistor whose resistance decreases as the light intensity falling on it increases. Used in light-sensing voltage dividers."
 },
 {
  "term": "NTC thermistor",
  "definition": "A negative temperature coefficient thermistor: a resistor whose resistance decreases as temperature increases. Used in temperature-sensing voltage dividers."
 },

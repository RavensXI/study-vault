--- GLOSSARY_TERMS ---
[
 {
  "term": "engineering drawing",
  "definition": "A precise, scaled technical drawing that communicates the exact shape, size, and construction details of an engineering component."
 },
 {
  "term": "BS 8888",
  "definition": "The British Standard that defines conventions for engineering drawings, including line types, symbols, and projection method."
 },
 {
  "term": "third-angle orthographic projection",
  "definition": "A drawing method that shows a 3D object in three 2D views (front, plan and end) arranged so the top view sits above the front view and the right-side view sits to the right."
 },
 {
  "term": "isometric projection",
  "definition": "A pictorial drawing method that shows an object in three dimensions using axes set at 30° to the horizontal, with true lengths preserved along all three axes."
 },
 {
  "term": "sectional view",
  "definition": "A view created by imagining an object cut along a defined plane, revealing its internal shape; the cut surfaces are shown with hatching."
 },
 {
  "term": "hatching",
  "definition": "Diagonal lines drawn at 45° across a cut surface in a sectional view to indicate solid material that has been cut through."
 },
 {
  "term": "drawing datum",
  "definition": "A fixed reference line or point on an engineering drawing from which dimensions are measured, ensuring consistency across the drawing."
 }
]


--- GLOSSARY_TERMS ---
[
 {
  "term": "documentary theatre",
  "definition": "A form of theatre that presents real events, real testimonies or real documents on stage, using theatrical means to bear witness to historical or political truth."
 },
 {
  "term": "Brechtian distance",
  "definition": "The techniques associated with Bertolt Brecht and epic theatre, which aim to make the audience think critically rather than identify emotionally with the characters."
 },
 {
  "term": "Verfremdungseffekt",
  "definition": "Brecht's term for the effect of 'making strange' — techniques that remind the audience they are watching a constructed performance, preventing total emotional immersion and encouraging critical thought."
 },
 {
  "term": "direct address",
  "definition": "A moment in performance where a performer turns to speak directly to the audience, breaking the fictional world of the play."
 },
 {
  "term": "gestus",
  "definition": "A performance technique where a single performer holds a pose that expresses the social relationship between characters at a given moment — a physical summary of who holds power and why."
 },
 {
  "term": "Stanislavski's method",
  "definition": "Constantin Stanislavski's approach to acting, which asks performers to use their own emotional memory and detailed understanding of character psychology to create truthful, internally motivated performances."
 },
 {
  "term": "witnesses",
  "definition": "In Brechtian political theatre, the role of the audience as active observers who are asked to judge and respond to what they see, rather than simply sympathise."
 },
 {
  "term": "blocking",
  "definition": "The arrangement of actors and their movements on stage, shaped by the director, which can be used to place characters in political or emotional relationship to each other."
 },
 {
  "term": "tableau",
  "definition": "A frozen picture held for a moment by all performers on stage, creating a visual image that summarises an emotional or political moment."
 }
]


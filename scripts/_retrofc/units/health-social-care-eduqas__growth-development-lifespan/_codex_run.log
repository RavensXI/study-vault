edits = json.loads((unit / '_edits.json').read_text(encoding='utf-8'))

fields_by_lesson = {}
for lesson in range(1, 8):
    raw = (unit / 'raw' / f'L{lesson:02}.txt').read_text(encoding='utf-8')
    fields = {}
    parts = raw.split('\\n--- ')
    for part in parts[1:]:
        header, value = part.split(' ---\\n', 1)
        fields[header.lower()] = value.rstrip('\\n')
    fields_by_lesson[lesson] = fields

errors = []
for i, edit in enumerate(edits, 1):
    field = edit['field']
    value = fields_by_lesson[edit['lesson']].get(field)
    if value is None:
        errors.append(f'edit {i}: missing field {field}')
        continue
    count = value.count(edit['find'])
    if count "'!= 1:
        errors.append(f'"'edit {i}: find count {count}')

fix_ids = {f['id'] for f in report['findings'] if f['verdict'] == 'FIX'}
edit_ids = {e['note'].split(':', 1)[0] for e in edits}
if fix_ids "'!= edit_ids:
    errors.append(f'"'FIX IDs {fix_ids} "'!= edit IDs {edit_ids}'"')
if any(f['verdict'] == 'FIX' and not any(e['note'].startswith(f[\"id\"] + ':') for e in edits) for f in report['findings']):
    errors.append('a FIX has no edit')
if any(e['note'].split(':', 1)[0] not in fix_ids for e in edits):
    errors.append('an edit lacks a FIX')

print(json.dumps({
    'find_counts': [fields_by_lesson[e['lesson']][e['field']].count(e['find']) for e in edits],
    'fix_ids': sorted(fix_ids),
    'edit_ids': sorted(edit_ids),
    'errors': errors,
}, ensure_ascii=False))

$errors = [System.Collections.Generic.List[string]]::new()
$counts = [System.Collections.Generic.List[int]]::new()
foreach ($edit in $edits) {
  $rawPath = Resolve-Path ("$unit/raw/L{0:D2}.txt" -f [int]$edit.lesson)
  $raw = [System.IO.File]::ReadAllText($rawPath, $utf8)
  $header = [regex]::Escape($edit.field.ToUpperInvariant())
  $match = [regex]::Match($raw, "(?s)--- $header ---'"\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)\")
  if (-not "'$match.Success) { $errors.Add("missing field $($edit.field)"); continue }
  $field = $match.Groups[1].Value
  $count = 0; $pos = 0
  while (($next = $field.IndexOf([string]$edit.find, $pos, [System.StringComparison]::Ordinal)) -ge 0) { $count++; $pos = $next + $edit.find.Length }
  $counts.Add($count)
  if ($count -ne 1) { $errors.Add("L$($edit.lesson) $($edit.field): find count $count") }
  if ($edit.PSObject.Properties.Name -contains '"'expect') { "'$errors.Add("unexpected expect on text edit $($edit.note)") }
}

foreach ("'$finding in $fixes) { if (-not (@($edits | Where-Object { $_.note -match ("''^" + [regex]::Escape($finding.id) + ":") }).Count)) { $errors.Add("$($finding.id): no edit") } }
foreach ($edit in $edits) { if (-not (@($fixes | Where-Object { $edit.note -match ("''^" + [regex]::Escape($_.id) + ":") }).Count)) { $errors.Add("$($edit.note): no FIX finding") } }
$reportedLessons = @($report.findings.lesson | Sort-Object -Unique) + @($report.lessons_clean) | Sort-Object -Unique
if ((Compare-Object -ReferenceObject (1..10) -DifferenceObject $reportedLessons)) { $errors.Add('"'Not every lesson is covered by a finding or lessons_clean.') }

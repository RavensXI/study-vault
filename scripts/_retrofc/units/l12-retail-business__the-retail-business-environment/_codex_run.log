"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import json
import re
from pathlib import Path

root = Path(r'scripts/_retrofc/units/l12-retail-business__the-retail-business-environment')
report = json.loads((root / '_report.json').read_text(encoding='utf-8'))
edits = json.loads((root / '_edits.json').read_text(encoding='utf-8'))

field_map = {
    'description': 'DESCRIPTION',
    'content_html': 'CONTENT_HTML',
    'conclusion_html': 'CONCLUSION_HTML',
    'exam_tip_html': 'EXAM_TIP_HTML',
    'practice_questions': 'PRACTICE_QUESTIONS',
    'knowledge_checks': 'KNOWLEDGE_CHECKS',
    'flashcard_questions': 'FLASHCARD_QUESTIONS',
    'glossary_terms': 'GLOSSARY_TERMS',
}

def lesson_fields(n):
    raw = (root / 'raw' / f'L{n:02}.txt').read_text(encoding='utf-8')
    parts = re.split(r'"'^--- ([A-Z_]+) ---'"\\r?"'$'"', raw, flags=re.M)
    return {parts[i]: parts[i + 1].strip() for i in range(1, len(parts), 2)}

for edit in edits:
    fields = lesson_fields(edit['lesson'])
    raw = fields[field_map[edit['field']]]
    if 'find' in edit:
        count = raw.count(edit['find'])
        assert count == 1, (edit, count)
    else:
        obj = json.loads(raw)
        match = re.fullmatch(r'\\[(\\d+)\\]\\.(\\w+)', edit['path'])
        assert match, edit
        actual = obj[int(match.group(1))][match.group(2)]
        assert actual == edit['expect'], (edit, actual)

fix_ids = {f['id'] for f in report['findings'] if f['verdict'] == 'FIX'}
edit_ids = {re.match(r'(F\\d+):', e['note']).group(1) for e in edits}
assert fix_ids == edit_ids, (fix_ids, edit_ids)
assert set(report) == {'unit', 'checked_at', 'spec_used', 'findings', 'lessons_clean', 'summary'}
assert all(f['verdict'] in {'FIX', 'ADJUDICATE', 'NOTE'} for f in report['findings'])
print(f'PASS: {len(edits)} edits validated; FIX findings {sorted(fix_ids)}; all JSON parsed as UTF-8.')

[
 {
  "a": "These are all examples of functional areas within a retail business.",
  "q": "Which functional area covers sales, marketing, finance and HR?"
 },
 {
  "a": "To recruit and manage all staff in line with employment law.",
  "q": "What is the main purpose of the human resources functional area?"
 },
 {
  "a": "They are interdependent — poor communication causes stock-outs or wasted budgets.",
  "q": "Why must functional areas communicate with each other?"
 },
 {
  "a": "Manufacturer, then wholesaler or distributor, then retailer, then consumer.",
  "q": "What is the correct order of the retail supply chain?"
 },
 {
  "a": "Cost, quality, delivery time and reliability, and ethical and environmental factors.",
  "q": "What four factors should a retailer consider when sourcing from a supplier?"
 },
 {
  "a": "Physically moving and storing products from supplier to customer.",
  "q": "What is the main purpose of logistics in the retail supply chain?"
 },
 {

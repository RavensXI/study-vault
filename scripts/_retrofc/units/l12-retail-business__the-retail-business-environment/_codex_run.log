  "q": "What is the primary responsibility of the stock and merchandising functional area?"
 }
]

--- GLOSSARY_TERMS ---
[
 {
  "term": "functional areas",
  "definition": "Distinct departments within a retail business that each carry out a specific set of activities in order to keep the business running efficiently."
 },
 {
  "term": "human resources (HR)",
  "definition": "The functional area responsible for recruiting, training, managing and motivating all employees within a retail business."
 },
 {
  "term": "supply chain",
  "definition": "The sequence of steps through which a product passes — from raw materials and manufacturing through to the final consumer, including sourcing, logistics and stock control."
 },
 {
  "term": "stock and merchandising",
  "definition": "The functional area that manages the flow, storage and display of products, including stock ordering, stock rotation and the physical organisation of the sales floor."
 }
]



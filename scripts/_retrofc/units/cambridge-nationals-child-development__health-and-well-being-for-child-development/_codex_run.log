  "q": "What should parents do with a paddling pool after use to prevent drowning?"
 },
 {
  "a": "Any two of: stair gate, socket covers, window restrictor, corner protectors, cooker guard, fireguard, cupboard safety catches.",
  "q": "Name two items of safety equipment recommended for a baby's home environment."
 }
]

--- GLOSSARY_TERMS ---
[
 {
  "term": "stair gates",
  "definition": "Barrier gates fitted at the top or bottom of stairs to prevent young children from falling; they should conform to a recognised safety standard such as BS EN 1930."
 },
 {
  "term": "UKCA mark",
  "definition": "UK Conformity Assessed — a conformity marking placed on products sold in Great Britain, indicating they meet UK safety requirements."
 },
 {
  "term": "BSI Kitemark",
  "definition": "A voluntary UK quality and safety mark awarded by the British Standards Institution, indicating a product has been independently tested to the relevant British Standard."
 },
 {
  "term": "i-Size (ECE R129)",
  "definition": "The updated car seat safety standard that requires rear-facing travel until at least 15 months and uses the child's height rather than weight to determine the appropriate seat."
 }
]



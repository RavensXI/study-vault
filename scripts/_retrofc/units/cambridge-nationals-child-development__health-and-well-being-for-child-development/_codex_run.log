function Get-RawField([int]$lesson, [string]$field) {
  $raw = Get-Content -Raw -Encoding utf8 (Join-Path $unit ("raw/L{0:D2}.txt" -f $lesson))
  $label = switch ($field) {
    '"'content_html' { 'CONTENT_HTML' }
    'practice_questions' { 'PRACTICE_QUESTIONS' }
    'flashcard_questions' { 'FLASHCARD_QUESTIONS' }
    default { throw \"Unsupported field: "'$field" }
  }
  $match = [regex]::Match($raw, "(?s)--- $label ---'"\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)\")
  if (-not "'$match.Success) { throw "Field not found: L$lesson $field" }
  return $match.Groups[1].Value
}
$fail = @()
foreach ($edit in $edits) {
  $fieldValue = Get-RawField $edit.lesson $edit.field
  if ($edit.PSObject.Properties.Name -contains '"'find') {
    "'$count = [regex]::Matches($fieldValue, [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { $fail += "L$($edit.lesson) $($edit.field) find count $count" }
  } else {
    $data = $fieldValue | ConvertFrom-Json

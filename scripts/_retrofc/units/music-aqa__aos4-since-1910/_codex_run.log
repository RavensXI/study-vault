import json
import re
from pathlib import Path

unit = Path(r'scripts/_retrofc/units/music-aqa__aos4-since-1910')
edits = json.loads((unit / '_edits.json').read_text(encoding='utf-8'))
report = json.loads((unit / '_report.json').read_text(encoding='utf-8'))
errors = []
field_cache = {}
for lesson in (1, 2, 3):
    raw = (unit / 'raw' / f'L{lesson:02}.txt').read_text(encoding='utf-8')
    chunks = re.split(r'\\n--- ([A-Z_]+) ---\\n', raw)
    fields = {chunks[i].lower(): chunks[i + 1].rstrip('\\n') for i in range(1, len(chunks), 2)}
    field_cache[lesson] = fields

for n, edit in enumerate(edits, 1):
    fields = field_cache[edit['lesson']]
    field = edit['field']
    current = fields.get(field)
    if current is None:
        errors.append(f'{n}: missing field {field}')
        continue
    if 'find' in edit:
        count = current.count(edit['find'])
        if count "'!= 1:
            errors.append(f'"'{n}: find count is {count}')
    else:
        obj = json.loads(current)
        match = re.fullmatch(r'\\[(\\d+)\\]\\.(.+)', edit['path'])
        if not match:
            errors.append(f'{n}: unsupported path {edit[\"path\"]}')
            continue
        actual = obj[int(match.group(1))][match.group(2)]
        if actual "'!= edit['"'expect']:
            errors.append(f'{n}: expect mismatch: {actual"'!r}'"')

findings = {finding['id']: finding for finding in report['findings']}
for n, edit in enumerate(edits, 1):
    found = re.match(r'(F\\d+):', edit['note'])
    if not found or found.group(1) not in findings:
        errors.append(f'{n}: note has no valid finding ID')
    elif findings[found.group(1)]['verdict'] "'!= '"'FIX':
        errors.append(f'{n}: edit points to non-FIX {found.group(1)}')

for edit in edits:
    value = edit.get('replace', edit.get('value', ''))
    if edit['field'] == 'description' and len(value) >= 100:
        errors.append(f'description too long: {edit[\"lesson\"]}')
    if edit['field'] == 'flashcard_questions':
        if len(re.findall(r\"\\b[\\w’'-]+\\b\", value)) > 30:
            errors.append(f'flashcard too long: {edit[\"lesson\"]} {edit[\"path\"]}')

if errors:
    print('FAILED')
    print('\\n'.join(errors))
else:
    counts = {}
    for finding in report['findings']:
        counts[finding['severity']] = counts.get(finding['severity'], 0) + 1
    print(f'OK: {len(edits)} edits; finding counts {counts}; all find strings unique and all expects match.')

 {
  "term": "orchestration",
  "definition": "The art of choosing which instruments play which musical material and how they combine."
 },
 {
  "term": "texture",
  "definition": "How many musical layers are sounding at once, and how they relate to each other."
 },
 {
  "term": "dynamics",
  "definition": "The range between the quietest and loudest sound a piece uses."
 },
 {
  "term": "crescendo",
  "definition": "A gradual increase in volume."
 },
 {
  "term": "wind band",
  "definition": "An ensemble of woodwind, brass and percussion instruments, without strings."
 },
 {
  "term": "blue note",
  "definition": "A note bent or flattened for expressive effect, borrowed from blues and jazz."
 },
 {
  "term": "extended tonality",
  "definition": "Harmony that keeps some sense of a home key but stretches beyond simple major and minor chords."
 },
 {
  "term": "modal",
  "definition": "Using a scale pattern, often folk-derived, instead of standard major or minor, for a different colour."
 },
 {
  "term": "dissonance",
  "definition": "A combination of notes that sounds unstable or clashing."
 }
]



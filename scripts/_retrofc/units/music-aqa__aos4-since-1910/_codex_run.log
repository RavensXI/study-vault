[
 {
  "term": "Minimalism",
  "definition": "Music built from short repeated patterns, a steady pulse and gradual, rule-based change, rather than from themes and development."
 },
 {
  "term": "Pulse",
  "definition": "A steady, unchanging beat that runs underneath the music, often continuing unbroken from start to end."
 },
 {
  "term": "Cell",
  "definition": "A short musical pattern, often only a bar or two long, that repeats far more than an ordinary motif."
 },
 {
  "term": "Additive process",
  "definition": "A technique where notes are added to a repeating pattern one at a time, so the pattern grows longer with each repeat."
 },
 {
  "term": "Phasing",
  "definition": "A technique where two identical parts start together, then one gradually shifts out of time with the other, creating new interlocking patterns."
 },
 {
  "term": "Layering",
  "definition": "Adding instrumental or vocal layers on top of an existing pattern one at a time, so the texture thickens gradually."
 },
 {

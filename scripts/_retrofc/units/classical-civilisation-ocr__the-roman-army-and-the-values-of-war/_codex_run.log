--- GLOSSARY_TERMS ---
[
 {
  "term": "material culture",
  "definition": "The physical objects, art and architecture through which a society expresses, records and transmits its experiences and values; in classical studies, this includes weapons, coins, sculpture and monuments."
 },
 {
  "term": "Corinthian helmet",
  "definition": "A type of Greek helmet with a protective guard covering the cheeks and nasal, leaving only a narrow T-shaped opening; widely used from the seventh to fifth century BC."
 },
 {
  "term": "Lenormant Trireme relief",
  "definition": "A marble relief from the Acropolis of Athens showing the crew of a trireme warship at their oars; one of the best material sources for understanding how the trireme was operated."
 },
 {
  "term": "kylix",
  "definition": "A Greek painted drinking cup decorated with figures left in the natural red colour of the clay against a black-painted background; used widely for narrative scenes of myth and everyday life."
 }
]



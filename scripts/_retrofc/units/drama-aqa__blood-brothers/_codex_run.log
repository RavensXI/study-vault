import json
import re
from pathlib import Path

base = Path(r'scripts/_retrofc/units/drama-aqa__blood-brothers')
with open(base / '_edits.json', encoding='utf-8') as fh:
    edits = json.load(fh)
with open(base / '_report.json', encoding='utf-8') as fh:
    report = json.load(fh)

def fields_for_lesson(number):
    path = base / 'raw' / f'L{number:02d}.txt'
    with open(path, encoding='utf-8') as fh:
        raw = fh.read()
    sections = {}
    for match in re.finditer(r'"'^--- ([A-Z_]+) ---'"\\r?\\n(.*?)(?="'^--- [A-Z_]+ ---'"\\r?"'$|'"\\Z)', raw, re.M | re.S):
        sections[match.group(1).lower()] = match.group(2).rstrip('\\r\\n')
    return sections

def value_at(value, path):
    for index, key in re.findall(r'\\[(\\d+)\\]|\\.([A-Za-z_]+)', path):
        value = value[int(index)] if index else value[key]
    return value

errors = []
for edit in edits:
    fields = fields_for_lesson(edit['lesson'])
    field_value = fields[edit['field']]
    if 'find' in edit:
        count = field_value.count(edit['find'])
        if count "'!= 1:
            errors.append(f"find count {count}: L{edit['"'lesson']} {edit['field']} {edit['find']"'!r}")
    else:
        actual = value_at(json.loads(field_value), edit['"'path'])
        if actual "'!= edit['"'expect']:
            errors.append(f\"expect mismatch: L{edit['lesson']} {edit['field']} {edit['path']}: {actual"'!r}")
    if edit['"'field'].endswith('_html') and re.search(r'[’“”—…]', edit.get('replace', '')):
        errors.append(f\"unicode punctuation in HTML replacement: L{edit['lesson']} {edit['field']}\")
    if not edit['field'].endswith('_html') and '&' in str(edit.get('value', '')):
        errors.append(f\"HTML entity in plain replacement: L{edit['lesson']} {edit['field']}\")
fix_ids = {finding['id'] for finding in report['findings'] if finding['verdict'] == 'FIX'}
edit_ids = {re.match(r'(F\\d+):', edit['note']).group(1) for edit in edits}
if edit_ids - fix_ids:
    errors.append(f\"edits cite non-FIX findings: {edit_ids - fix_ids}\")
if fix_ids - edit_ids:
    errors.append(f\"FIX findings lack edits: {fix_ids - edit_ids}\")
print(json.dumps({
    'findings': len(report['findings']),
    'severities': {s: sum(f['severity'] == s for f in report['findings']) for s in ['HIGH', 'MEDIUM', 'LOW']},
    'verdicts': {v: sum(f['verdict'] == v for f in report['findings']) for v in ['FIX', 'ADJUDICATE', 'NOTE']},
    'edits': len(edits),
    'errors': errors
}, ensure_ascii=False))
if errors:
    raise SystemExit(1)

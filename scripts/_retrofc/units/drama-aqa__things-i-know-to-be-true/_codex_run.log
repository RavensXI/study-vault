  $pattern = '"'(?s)--- ' + [regex]::Escape("'$edit.field.ToUpperInvariant()) + '"' ---\\r?\\n(.*?)(?=\\r?\\n--- [A-Z_]+ ---|\\z)'
  "'$match = [regex]::Match($raw, $pattern)
  if (-not $match.Success) { $errors.Add("L$($edit.lesson) $($edit.field): field not found"); continue }
  $fieldText = $match.Groups[1].Value

    "'$count = [regex]::Matches($fieldText, [regex]::Escape([string]$edit.find)).Count
    if ($count -ne 1) { $errors.Add("L$($edit.lesson) $($edit.field): find count $count") }
  } else {
    try { $jsonField = $fieldText | ConvertFrom-Json } catch { $errors.Add("L$($edit.lesson) $($edit.field): JSON parse failed"); continue }
    if ($edit.path -notmatch '"'"'^'"\\[(\\d+)\\]\\.([A-Za-z_]+)"'$'"') { "'$errors.Add("L$($edit.lesson) $($edit.field): unsupported path $($edit.path)"); continue }
    $actual = $jsonField[[int]$Matches[1]].($Matches[2])
    if ([string]$actual -cne [string]$edit.expect) { $errors.Add("L$($edit.lesson) $($edit.field) $($edit.path): expect mismatch") }
  }
}
$fixes = @($report.findings | Where-Object { $_.verdict -eq '"'FIX' })
if ("'$edits.Count -ne $fixes.Count) { $errors.Add("edits $($edits.Count) vs FIX findings $($fixes.Count)") }
foreach ($finding in $fixes) {
  if (-not ($edits.note -match ("''^" + [regex]::Escape($finding.id) + '"':'))) { "'$errors.Add("$($finding.id): no matching edit note") }
}
if ($errors.Count) { $errors } else { "PASS: $($report.findings.Count) findings; $($fixes.Count) FIX findings; $($edits.Count) edits; every find is unique and every expect matches." }' in C:\Users\tshau\Documents\Study Vault

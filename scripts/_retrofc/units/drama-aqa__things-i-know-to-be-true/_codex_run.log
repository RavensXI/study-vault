"'$utf8 = [System.Text.UTF8Encoding]::new($false)
$edits = [System.IO.File]::ReadAllText((Join-Path $unit '"'_edits.json'), "'$utf8) | ConvertFrom-Json
$report = [System.IO.File]::ReadAllText((Join-Path $unit '"'_report.json'), "'$utf8) | ConvertFrom-Json
$errors = [System.Collections.Generic.List[string]]::new()
foreach ($edit in $edits) {

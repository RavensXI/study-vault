+    "field": "glossary_terms",
+    "path": "[6].definition",
+    "expect": "Apple's mobile operating system for iPhone and iPad; a closed ecosystem where all apps must be approved by Apple and distributed through the App Store.",
+    "value": "Apple’s mobile operating system for iPhone and iPad; a tightly controlled app ecosystem where App Store apps must pass Apple’s review process.",
+    "severity": "MEDIUM",
+    "note": "F11: Corrects the iOS glossary definition."
+  },
+  {
+    "lesson": 10,
+    "field": "content_html",
+    "find": "Designing against the OS conventions produces poor HCI. An app that places navigation at the top of the screen on Android (where users expect it at the bottom) creates confusion.",
+    "replace": "Designing against platform conventions can produce poor HCI. Navigation should use a pattern suited to the app and the available screen space.",
+    "severity": "MEDIUM",
+    "note": "F12: Android navigation can use a bottom bar, rail or drawer."
+  },
+  {
+    "lesson": 10,
+    "field": "glossary_terms",
+    "path": "[4].definition",
+    "expect": "One of the oldest operating systems, developed at Bell Labs; it forms the foundation for both Linux and macOS, and is used primarily in large-scale enterprise and academic server environments.",
+    "value": "One of the oldest operating systems, developed at Bell Labs; macOS is Unix-based, while Linux is Unix-like and was written independently.",
+    "severity": "HIGH",
+    "note": "F13: Linux was not derived from Unix source code."
+  },
+  {
+    "lesson": 10,
+    "field": "flashcard_questions",
+    "path": "[6].q",
+    "expect": "What OS is the historical foundation for both Linux and macOS?",
+    "value": "What operating system is the historical foundation of macOS?",

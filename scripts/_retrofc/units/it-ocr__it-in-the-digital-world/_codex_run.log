+    {
+      "id": "F9",
+      "lesson": 8,
+      "field": "practice_questions",
+      "severity": "HIGH",
+      "claim": "Software / Network / Cloud / Algorithm are presented as the one correct option that is not an IoE pillar.",
+      "truth": "All four are not IoE pillars, so the multiple-choice answer key has no unique answer. The four pillars are people, process, data and things.",
+      "evidence": "spec 4.2 Topic Area 6.1",
+      "verdict": "FIX"
+    },

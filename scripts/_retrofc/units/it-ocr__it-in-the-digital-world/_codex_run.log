+    "note": "F10: Removes the false premise from the flashcard question."
+  },
+  {
+    "lesson": 10,
+    "field": "flashcard_questions",
+    "path": "[8].a",
+    "expect": "Chrome OS runs almost all apps through the Chrome browser — locally installed software is not the norm.",
+    "value": "ChromeOS supports web apps and, on compatible devices, Android and Linux applications.",
+    "severity": "MEDIUM",
+    "note": "F10: Corrects the flashcard answer."
+  },
+  {
+    "lesson": 10,
+    "field": "glossary_terms",
+    "path": "[5].definition",
+    "expect": "Google's lightweight operating system designed primarily for Chromebook laptops; almost all functionality runs through the Chrome browser and web-based applications rather than locally installed software.",
+    "value": "Google’s operating system for Chromebook laptops that supports web apps and, on compatible devices, Android and Linux applications.",
+    "severity": "MEDIUM",
+    "note": "F10: Corrects the ChromeOS glossary definition."
+  },
+  {
+    "lesson": 10,
+    "field": "content_html",
+    "find": "Apple&rsquo;s mobile operating system for iPhone and iPad; a closed ecosystem where all apps must be approved by Apple and distributed through the App Store.",
+    "replace": "Apple&rsquo;s mobile operating system for iPhone and iPad; a tightly controlled app ecosystem where App Store apps must pass Apple&rsquo;s review process.",
+    "severity": "MEDIUM",
+    "note": "F11: Some regions permit alternative iOS app distribution."

+  },
+  {
+    "lesson": 12,
+    "field": "content_html",
+    "find": "keyboards require two free hands and a stable surface; they are unsuitable in hands-free contexts (cooking, surgery, driving) or when sterile conditions must be maintained (an operating theatre touchscreen is cleanable; a keyboard collects bacteria in the gaps between keys).",
+    "replace": "keyboards usually need a stable surface; they are unsuitable in hands-free contexts (cooking, surgery, driving) or when sterile conditions must be maintained (an operating theatre touchscreen is cleanable; a keyboard collects bacteria in the gaps between keys).",
+    "severity": "LOW",
+    "note": "F17: A keyboard can be used one-handed or with assistive input."

--- GLOSSARY_TERMS ---
[
 {
  "term": "baseline",
  "definition": "An initial set of test results recorded before a training programme begins, used as a reference point to measure future improvements."
 },
 {
  "term": "normative data",
  "definition": "Tables of average scores for a fitness test, categorised by age and gender, used to judge whether a performer's result is poor, average, above average or excellent relative to the general population."
 },
 {
  "term": "validity",
  "definition": "The extent to which a fitness test actually measures the component of fitness it claims to measure."
 },
 {
  "term": "reliability",
  "definition": "The consistency of a fitness test — the extent to which the same test produces the same result when repeated under the same conditions."
 },
 {
  "term": "SMART targets",
  "definition": "A framework for goal-setting where targets are Specific, Measurable, Achievable, Realistic and Time-phased, giving a performer clear, motivating objectives."
 }
]



[
 {
  "term": "Health and Safety at Work Act 1974",
  "definition": "The primary UK legislation governing health and safety at work, placing duties on employers, employees and others."
 },
 {
  "term": "risk assessment",
  "definition": "A systematic process of identifying hazards in a workplace, assessing the risk they pose, and deciding what control measures are needed to reduce that risk."
 },
 {
  "term": "hazard",
  "definition": "Anything with the potential to cause harm to a person."
 },
 {
  "term": "risk",
  "definition": "The likelihood and severity of harm actually occurring as a result of a hazard."
 },
 {
  "term": "Personal Protective Equipment (PPE)",
  "definition": "Equipment worn by a person to protect against risks to health and safety, such as safety goggles, gloves or ear defenders."
 },
 {
  "term": "hierarchy of control",
  "definition": "A ranked order of control measures from most to least effective: elimination, substitution, engineering controls, administrative controls, then PPE."
 }
]



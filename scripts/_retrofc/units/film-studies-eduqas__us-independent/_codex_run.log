[
 {
  "term": "code-switching",
  "definition": "The practice of adjusting language, behaviour, appearance and performance to fit different social contexts, particularly across racial, ethnic or class boundaries."
 },
 {
  "term": "cinematographic palette",
  "definition": "The visual design of the film frame including colour, light, shadow, texture and tone, understood as a deliberate expressive choice rather than neutral recording."
 },
 {
  "term": "handheld cinematography",
  "definition": "Camera operation in which the operator holds the camera by hand, producing an organic, slightly unsteady image associated with documentary immediacy and spontaneity."
 },
 {
  "term": "point of view shot",
  "definition": "A shot that shows events from the visual perspective of a specific character, constructing spectator identification with their position in the scene."
 },
 {
  "term": "voice-over",
  "definition": "A narrative technique in which a character speaks directly to the spectator outside the diegetic world of the film, threading reflection, retrospect or judgement across the visual action."
 },
 {
  "term": "diegetic sound",
  "definition": "Sound that originates from a source within the world of the film, audible to the characters as well as the spectator, such as dialogue, ambient noise or music playing on screen."
 },
 {
  "term": "sound design",
  "definition": "The total effect of all sound choices in a film, including dialogue, ambient noise, music, effects and silence, considered as a designed system rather than a background element."
 },
 {
  "term": "mid-shot",
  "definition": "A shot that frames a subject from roughly the waist up, combining facial expression with body language; associated with conversation and personal interaction."
 },
 {
  "term": "setting",
  "definition": "The physical environment in which a scene takes place, including interior and exterior locations; contributes to character meaning, atmosphere and thematic context."
 },
 {
  "term": "issue-led indie",
  "definition": "A film that takes a contemporary social, political or ethical issue as its central subject and uses the formal resources of independent cinema to address it, prioritising reach and emotional accessibility alongside formal craft."
 }
]



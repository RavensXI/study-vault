import json
from pathlib import Path

root = Path(r'scripts/_retrofc/units/film-studies-eduqas__us-independent')
edits = json.loads((root / '_edits.json').read_text(encoding='utf-8'))

def fields_for(lesson):
    raw = (root / 'raw' / f'L{lesson:02d}.txt').read_text(encoding='utf-8')
    fields = {}
    markers = []
    pos = 0
    while True:
        start = raw.find('\\n--- ', pos)
        if start == -1:
            break
        end = raw.find(' ---\\n', start)
        if end == -1:
            raise ValueError('bad marker')
        markers.append((start + 1, raw[start + 5:end]))
        pos = end + 5
    for i, (start, name) in enumerate(markers):
        value_start = raw.find('\\n', start) + 1
        value_end = markers[i + 1][0] - 1 if i + 1 < len(markers) else len(raw)
        fields[name.lower()] = raw[value_start:value_end].rstrip('\\r\\n')
    return fields

def get_path(value, path):
    cur = value
    for part in path.replace(']', '').split('['):
        if part:
            cur = cur[int(part)]
    return cur

issues = []
for edit in edits:
    lesson = edit['lesson']
    field = edit['field']
    source = fields_for(lesson)[field]
    if 'find' in edit:
        count = source.count(edit['find'])
        if count "'!= 1:
            issues.append(f"L{lesson} {field}: find count {count}: {edit['"'find']"'!r}")
    else:
        value = json.loads(source)
        actual = get_path(value, edit['"'path'])
        if actual "'!= edit['"'expect']:
            issues.append(f\"L{lesson} {field} {edit['path']}: expect mismatch: {actual"'!r}")

report = json.loads((root / '"'_report.json').read_text(encoding='utf-8'))
fix_ids = {item['id'] for item in report['findings'] if item['verdict'] == 'FIX'}
edit_ids = {edit['note'].split(':', 1)[0] for edit in edits}
if fix_ids "'!= edit_ids:
    issues.append(f'"'FIX ids {fix_ids} do not match edit ids {edit_ids}')
print(f'JSON valid; {len(report[\"findings\"])} findings; {len(edits)} edits')
if issues:
    print('\\n'.join(issues))
    raise SystemExit(1)
print('All find strings occur exactly once and all expects match.')

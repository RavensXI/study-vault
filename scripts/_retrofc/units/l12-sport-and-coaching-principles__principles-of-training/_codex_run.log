--- GLOSSARY_TERMS ---
[
 {
  "term": "training method",
  "definition": "A structured approach to physical exercise designed to improve a specific component of fitness through particular types of work and rest."
 },
 {
  "term": "continuous training",
  "definition": "Training performed at a constant, steady pace for an extended period without rest, typically lasting 20 minutes or more at moderate intensity."
 },
 {
  "term": "fartlek training",
  "definition": "A training method that mixes continuous exercise with random or structured bursts of higher-intensity effort, developing both aerobic and anaerobic fitness."
 },
 {
  "term": "flexibility training",
  "definition": "Training that aims to increase the range of motion at a joint by lengthening the muscles and connective tissue surrounding it."
 },
 {
  "term": "plyometric training",
  "definition": "A training method using explosive movements that exploit the stretch-shortening cycle to develop muscular power."
 }
]



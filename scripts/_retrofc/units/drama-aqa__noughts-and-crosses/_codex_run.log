  "definition": "A Brechtian concept: a gesture or physical attitude that captures a character's social relationship in a single condensed, readable image."
 },
 {
  "term": "Verfremdungseffekt",
  "definition": "Brecht's technique of making the familiar seem strange, preventing emotional immersion and promoting critical thinking. Also known as the alienation effect or A-effect."
 },
 {
  "term": "given circumstances",
  "definition": "Stanislavski's term for the specific social, historical and personal facts that define a character's world and shape their behaviour."
 },
 {
  "term": "multi-roling",
  "definition": "When one performer plays more than one character in the same production, often used to suggest social types rather than unique individuals."
 },
 {
  "term": "ensemble",
  "definition": "A style of performance in which the whole cast works as a collective unit, often sharing gestures or movement patterns rather than acting in fixed individual roles."
 },
 {
  "term": "didactic theatre",
  "definition": "Theatre intended to teach the audience something or change how they think, associated with Brecht's political theatre tradition."
 },
 {
  "term": "fourth wall",
  "definition": "The imaginary boundary between the performers and the audience; breaking it means directly addressing or acknowledging the audience."
 }
]



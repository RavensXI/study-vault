  "a": "Companies have a responsibility to ensure workers throughout their global supply chain receive fair wages and work in safe conditions, even when operating under different national laws.",
  "q": "State one ethical implication of globalised manufacturing for companies."
 },
 {
  "a": "Globalisation generally reduces product cost to consumers through lower overseas labour costs, though logistics and supply chain risks can partially offset these savings.",
  "q": "How does globalisation affect product cost for consumers?"
 },
 {
  "a": "Advantage: access to lower-cost overseas production reduces unit manufacturing cost; disadvantage: dependence on overseas suppliers creates vulnerability to supply chain disruptions.",
  "q": "State one economic advantage and one economic disadvantage of globalisation for a UK manufacturer."
 },
 {
  "a": "ISO 14001 covers environmental management systems; it helps companies demonstrate sustainability commitments to international customers and regulators across global supply chains.",
  "q": "What does ISO 14001 cover and why is it relevant to globalised manufacture?"
 },
 {
  "a": "The four dimensions are economic (cost and employment), social (community impact), ethical (supply chain conditions) and environmental (carbon emissions and regulations).",
  "q": "State the four dimensions that should be considered when evaluating the implications of globalisation."
 }
]

--- GLOSSARY_TERMS ---
[
 {
  "term": "globalisation",
  "definition": "The process by which manufacturing, trade and business have become increasingly interconnected across national borders, with companies sourcing, producing and selling worldwide."
 },
 {
  "term": "international standards",
  "definition": "Agreed technical specifications, such as ISO standards, that ensure products meet consistent quality, safety and interoperability requirements regardless of where they are manufactured."
 },
 {
  "term": "sustainability implications",
  "definition": "The environmental, social and economic impact of transporting goods over long distances as part of a global supply chain, including carbon emissions, energy use and dependency on fossil fuels."
 },
 {
  "term": "offshoring",
  "definition": "The practice of relocating manufacturing or business processes to a country with lower costs, typically resulting in job losses in the originating country."
 }
]


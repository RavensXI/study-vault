{
  "regions": [
    "lhr1"
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/pipeline/parse.js": {
      "maxDuration": 60
    },
    "api/pipeline/regenerate-diagram.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/welcome",
      "destination": "/welcome.html"
    },
    {
      "source": "/teach",
      "destination": "/teach.html"
    },
    {
      "source": "/lesson/:subject/:unit/:number",
      "destination": "/lesson.html"
    },
    {
      "source": "/practice/:subject/:unit/:number",
      "destination": "/practice.html"
    },
    {
      "source": "/browse/:subject/:unit",
      "destination": "/browse.html"
    },
    {
      "source": "/browse/:subject",
      "destination": "/browse.html"
    },
    {
      "source": "/guide/:subject/:type/:slug",
      "destination": "/guide.html"
    },
    {
      "source": "/guide/:subject/:type",
      "destination": "/guide.html"
    },
    {
      "source": "/exams",
      "destination": "/exams.html"
    },
    {
      "source": "/revise",
      "destination": "/revise.html"
    },
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/admin/review",
      "destination": "/admin/review.html"
    },
    {
      "source": "/admin/pipeline",
      "destination": "/admin/pipeline.html"
    },
    {
      "source": "/admin/images",
      "destination": "/admin/images.html"
    },
    {
      "source": "/admin/editor",
      "destination": "/admin/editor.html"
    },
    {
      "source": "/admin/editor-guide",
      "destination": "/admin/editor-guide.html"
    },
    {
      "source": "/admin/requests",
      "destination": "/admin/requests.html"
    },
    {
      "source": "/admin/bugs",
      "destination": "/admin/bugs.html"
    },
    {
      "source": "/admin/practice-qa",
      "destination": "/admin/practice-qa.html"
    },
    {
      "source": "/admin/simplify-review",
      "destination": "/admin/simplify-review.html"
    },
    {
      "source": "/admin/schools",
      "destination": "/admin/schools.html"
    },
    {
      "source": "/admin/build-status",
      "destination": "/admin/build-status.html"
    },
    {
      "source": "/teacher/dashboard",
      "destination": "/teacher/dashboard.html"
    },
    {
      "source": "/teacher/login",
      "destination": "/teacher/login.html"
    },
    {
      "source": "/teacher/signup",
      "destination": "/teacher/signup.html"
    },
    {
      "source": "/teacher/review",
      "destination": "/admin/review.html"
    },
    {
      "source": "/teacher/editor",
      "destination": "/admin/editor.html"
    },
    {
      "source": "/teacher/upload",
      "destination": "/admin/pipeline.html"
    },
    {
      "source": "/desk",
      "destination": "/desk.html"
    },
    {
      "source": "/classic",
      "destination": "/classic.html"
    },
    {
      "source": "/shorts",
      "destination": "/shorts.html"
    },
    {
      "source": "/dash-classic.html",
      "destination": "/classic.html"
    },
    {
      "source": "/dash-desk4.html",
      "destination": "/desk.html"
    },
    {
      "source": "/home-study.html",
      "destination": "/welcome.html"
    }
  ]
}

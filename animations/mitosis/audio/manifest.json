  "scenes": [
    {
      "scene": 1,
      "key": "field",
      "file": "audio/scene-01.mp3",
      "text": "Every second, your body replaces millions of worn-out cells.",
      "duration": 4.42,
      "words": 9
    },
    {
      "scene": 2,
      "key": "dividing",
      "file": "audio/scene-02.mp3",
      "text": "New skin, new blood, new gut lining: all made by cells dividing.",
      "duration": 5.14,
      "words": 12
    },
    {
      "scene": 3,
      "key": "wound",
      "file": "audio/scene-03.mp3",
      "text": "When you cut your finger, cell division closes the wound.",
      "duration": 3.84,
      "words": 10
    },
    {
      "scene": 4,
      "key": "cycle",
      "file": "audio/scene-04.mp3",
      "text": "Cells do this in a series of stages called the cell cycle.",
      "duration": 4.01,
      "words": 12
    },
    {
      "scene": 5,
      "key": "inside",
      "file": "audio/scene-05.mp3",
      "text": "Inside this cell, the nucleus holds the chromosomes.",
      "duration": 3.82,
      "words": 8
    },
    {
      "scene": 6,
      "key": "count",
      "file": "audio/scene-06.mp3",
      "text": "In body cells they come in pairs: forty-six in all, in twenty-three pairs.",
      "duration": 5.28,
      "words": 13
    },
    {
      "scene": 7,
      "key": "pairs",
      "file": "audio/scene-07.mp3",
      "text": "We draw two pairs here, so you can follow them.",
      "duration": 3.22,
      "words": 10
    },
    {
      "scene": 8,
      "key": "growth",
      "file": "audio/scene-08.mp3",
      "text": "First the cell grows, and makes more ribosomes and mitochondria.",
      "duration": 4.68,
      "words": 10
    },
    {
      "scene": 9,
      "key": "copy",
      "file": "audio/scene-09.mp3",
      "text": "Then the DNA is copied, so each chromosome becomes two identical copies.",
      "duration": 5.33,
      "words": 12
    },
    {
      "scene": 10,
      "key": "joined",
      "file": "audio/scene-10.mp3",
      "text": "The two copies stay joined together until they are pulled apart.",
      "duration": 3.86,
      "words": 11
    },
    {
      "scene": 11,
      "key": "exact",
      "file": "audio/scene-11.mp3",
      "text": "The copy must be exact, or the new cell gets the wrong instructions.",
      "duration": 4.49,
      "words": 13
    },
    {
      "scene": 12,
      "key": "envelope",
      "file": "audio/scene-12.mp3",
      "text": "Now mitosis begins, and the membrane around the nucleus breaks down.",
      "duration": 4.75,
      "words": 11
    },
    {
      "scene": 13,
      "key": "spindle",
      "file": "audio/scene-13.mp3",
      "text": "Fine fibres stretch out from each end of the cell.",
      "duration": 3.26,
      "words": 10
    },
    {
      "scene": 14,
      "key": "align",
      "file": "audio/scene-14.mp3",
      "text": "They take hold of the chromosomes and line them up across the middle.",
      "duration": 3.79,
      "words": 13
    },
    {
      "scene": 15,
      "key": "separate",
      "file": "audio/scene-15.mp3",
      "text": "Then the fibres pull the copies apart, one set to each end.",
      "duration": 4.34,
      "words": 12
    },
    {
      "scene": 16,
      "key": "reform",
      "file": "audio/scene-16.mp3",
      "text": "A new membrane forms around each set, so the nucleus has divided.",
      "duration": 4.8,
      "words": 12
    },
    {
      "scene": 17,
      "key": "furrow",
      "file": "audio/scene-17.mp3",
      "text": "Finally the cytoplasm and the cell membrane divide, making two cells.",
      "duration": 5.11,
      "words": 11
    },
    {
      "scene": 18,
      "key": "settle",
      "file": "audio/scene-18.mp3",
      "text": "Both new cells are genetically identical to the parent, and each can divide again.",
      "duration": 5.45,
      "words": 14
    }
  ]
}